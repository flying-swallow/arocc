// #opt: -std=c99 -target x86_64-linux
void partial(kept) int kept; int extra; { (void)extra; } // #warning@6: a function definition without a prototype is deprecated in all versions of C and is not supported in C23 // #error@34: parameter named 'extra' is missing

// #expect: stdout
implicit typedef: '__int128'
 name: __int128_t

implicit typedef: 'unsigned __int128'
 name: __uint128_t

implicit typedef: '*char'
 name: __builtin_ms_va_list

implicit typedef: '[1]struct __va_list_tag'
 name: __builtin_va_list

implicit typedef: 'struct __NSConstantString_tag'
 name: __NSConstantString

implicit typedef: 'long double'
 name: __float80

function: 'fn (kept: int) void'
 name: partial
 body:
  compound_stmt
    cast: (to_void) 'void'
      implicit cast: (lval_to_rval) 'int'
        decl_ref_expr: 'int' lvalue
         name: extra

    implicit return_stmt: 'void'

