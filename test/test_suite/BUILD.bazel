load(":defs.bzl", "test_suite_area")

# c3c-style integration suite: one self-contained case per file, run by
# //test/src/test_suite:test_suite_runner (format documented there and in
# test/README.MD). Each area directory is one test target; _support holds the
# include/embed/framework trees copied into every worker directory.
#
#   bazel test //test/test_suite:test_suite_preprocessor
#   bazel run //test/src/test_suite:test_suite_runner -- $PWD/bazel-bin/aro_cc $PWD/test/test_suite [-s]

AREAS = [
    "attributes",
    "builtins",
    "declarations",
    "expressions",
    "initializers",
    "lexer",
    "misc",
    "pragmas",
    "predefined",
    "preprocessor",
    "types",
]

filegroup(
    name = "_support",
    srcs = glob(["_support/**"]),
)

[filegroup(
    name = area,
    srcs = glob([area + "/**"]),
) for area in AREAS + ["run"]]

[test_suite_area(area) for area in AREAS]

# Native Linux x86-64 cases: compile with aro_cc using the default -O1, -O0,
# -O2, --x86-64-spill-all, -fintegrated-as, or -fno-integrated-as, link with
# the declared cc, run and compare the exit status. Other hosts skip them.
test_suite_area("run", native = True)

test_suite_area(
    "run",
    name = "test_suite_run_o0",
    native = True,
    env = {"ARO_C3_OPT": "-O0"},
)

test_suite_area(
    "run",
    name = "test_suite_run_o2",
    native = True,
    env = {"ARO_C3_OPT": "-O2"},
)

test_suite_area(
    "run",
    name = "test_suite_run_spill_all",
    native = True,
    env = {"ARO_C3_FLAGS": "--x86-64-spill-all"},
)

test_suite_area(
    "run",
    name = "test_suite_run_integrated_as",
    native = True,
    env = {"ARO_C3_FLAGS": "-fintegrated-as"},
)

test_suite_area(
    "run",
    name = "test_suite_run_system_as",
    native = True,
    env = {"ARO_C3_FLAGS": "-fno-integrated-as"},
)

test_suite(
    name = "all",
    tests = ["test_suite_" + area for area in AREAS] + [
        "test_suite_run",
        "test_suite_run_o0",
        "test_suite_run_o2",
        "test_suite_run_spill_all",
        "test_suite_run_integrated_as",
        "test_suite_run_system_as",
    ],
)
