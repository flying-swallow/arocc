       name: volatile_p
     rhs:
      implicit cast: (no_op) '*volatile int'
        implicit cast: (lval_to_rval) '*int'
          decl_ref_expr: '*int' lvalue
           name: p

    assign_expr: '*int'
     lhs:
      decl_ref_expr: '*int' lvalue
       name: p
     rhs:
      implicit cast: (bitcast) '*int'
        implicit cast: (lval_to_rval) '*volatile int'
          decl_ref_expr: '*volatile int' lvalue
