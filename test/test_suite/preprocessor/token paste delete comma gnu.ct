#define ZERO_ARGS(...) foo(a, ##__VA_ARGS__) // #warning@31: token pasting of ',' and __VA_ARGS__ is a GNU extension [-Wgnu-zero-variadic-macro-arguments] // #warning@31: token pasting of ',' and __VA_ARGS__ is a GNU extension [-Wgnu-zero-variadic-macro-arguments]

