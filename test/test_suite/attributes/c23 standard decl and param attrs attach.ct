// #opt: -std=c23 -target x86_64-linux -Wunused-parameter
// Prototype parameters are not dumped; the definition below shows [[gnu::unused]]
// reached the parameter because -Wunused-parameter stays silent for p.
[[gnu::unused]] int c23_slot; void c23_param([[gnu::unused]] int p);
void c23_param([[gnu::unused]] int p) {}

