// #opt: -std=c23 -target x86_64-linux
void foo(void) {
    int x;
    __auto_type x = x; // #error@21: variable 'x' declared with deduced type '__auto_type' cannot appear in its own initializer
    __auto_type y = (y); // #error@22: variable 'y' declared with deduced type '__auto_type' cannot appear in its own initializer
    auto z = z + 1; // #error@14: variable 'z' declared with deduced type '__auto_type' cannot appear in its own initializer
    int good = 3;
}

// #expect: stdout
implicit typedef: 'unsigned char'
 name: char8_t

implicit typedef: '__int128'
 name: __int128_t

implicit typedef: 'unsigned __int128'
 name: __uint128_t

implicit typedef: '*char'
 name: __builtin_ms_va_list

implicit typedef: '[1]struct __va_list_tag'
 name: __builtin_va_list

implicit typedef: 'struct __NSConstantString_tag'
 name: __NSConstantString

implicit typedef: 'long double'
 name: __float80

function: 'fn () void'
 name: foo
 body:
  compound_stmt
    decl_stmt
      variable: 'int'
       name: x

    decl_stmt
      variable: 'int'
       name: good
       init:
        int_literal: 'int' (value: 3)

    implicit return_stmt: 'void'

