// #skip: diagnostics differ (aro_c3 gap)
// #opt: -std=c23 --target=x86_64-linux-gnu
// #todo: TODO _Atomic __auto_type
_Atomic(const int) a; // #error@1: _Atomic cannot be applied to qualified type 'const int'
_Atomic(int [2]) b; // #error@1: _Atomic cannot be applied to array type 'int [2]'
_Atomic(int (int)) c; // #error@1: _Atomic cannot be applied to function type 'int (int)'
_Atomic(struct A) d; // #error@1: _Atomic cannot be applied to incomplete type 'struct A'
_Atomic(_Atomic(int)) e; // #error@1: _Atomic cannot be applied to atomic type '_Atomic(int)'
_Complex _Atomic(int) f; // #error@10: _Atomic cannot be applied to complex type '_Complex int'
_Atomic auto g = 1; // #error@1: _Atomic cannot be applied to type 'auto' in C23
// _Atomic __auto_type h = 1; // TODO
int *_Atomic i;
int (*_Atomic j)[2];
_Atomic(int) _Atomic(float) k; // #error@14: cannot combine with previous '_Atomic' specifier
_Atomic void l; // #error@1: _Atomic cannot be applied to incomplete type 'void'

void test_coerce() {
    _Atomic int a;
    long b;
    b = a;
    a = b;
    a += 1;

    _Atomic float f;
    a = f;
    f = a;
}

void test_member_access() {
    struct B {
        int a;
    };
    _Atomic(struct B) a;
    _Atomic(struct B*) b;
    _Atomic(struct B) *c;

    a.a; // #error@7: accessing a member of atomic type '_Atomic(struct B)' is undefined behavior
    b.a; // #error@7: accessing a member of atomic type '_Atomic(struct B *)' is undefined behavior // #error@7: member reference type 'struct B *' is a pointer; did you mean to use '->'?
    b->a; // #warning@6: expression result unused [-Wunused-value]
    c.a; // #error@7: accessing a member of atomic type '_Atomic(struct B)' is undefined behavior // #error@7: member reference type '_Atomic(struct B) *' is a pointer; did you mean to use '->'?
    c->a; // #error@8: accessing a member of atomic type '_Atomic(struct B)' is undefined behavior
}

void invalid_vector_initializer(void) {
    typedef int V __attribute__((vector_size(16)));
    (void)~((_Atomic(V)){0}); // #error@26: initializing 'V' (vector of 4 'int' values) from incompatible type 'int'
}

