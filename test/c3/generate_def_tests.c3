// Plan 12 stage 0 contract checks for the builtin generator's shared types.
// Links //tools:generate_def_lib (generator sources + builtin_properties.c3),
// not aro_c3_lib. Stage-1 agents may add tests for their part; the integrator
// owns the full //test/c3:builtins_tests.
//
// Expected bit positions are source-derived from the field order of
// `Attributes` (packed struct) in src/aro/Builtins/properties.zig.
module generate_def_tests;
import std::io, std::collections::list, generate_def, aro::builtin_properties;

macro check(left, right)
{
	test::eq((long)left, (long)right);
}

fn void attributes_bit_layout() @test
{
	check((uint)builtin_properties::ATTRIBUTES_DEFAULT, 0x10000); // eval_args = true is bit 16
	Attributes a = { .is_const = true };
	check((uint)a, 1 << 2);
	a = { .format_kind = VSCANF, .format_string_position = 31 };
	check((uint)a, (4 << 8) | (31 << 11));
	a = { .const_evaluable = true };
	check((uint)a, 1 << 19);
}

fn void attribute_field_names() @test
{
	AttributeField f = builtin_properties::attribute_field_from_name("const")!!;
	assert(f == CONST);
	Attributes a = builtin_properties::ATTRIBUTES_DEFAULT.with_field(f, 1).with_field(EVAL_ARGS, 0);
	check((uint)a, 1 << 2);
	a = a.with_field(FORMAT_KIND, (uint)FormatKind.PRINTF.ordinal).with_field(FORMAT_STRING_POSITION, 3);
	assert(a.format_kind == PRINTF);
	check(a.format_string_position, 3);
	assert(@catch(builtin_properties::attribute_field_from_name("is_const")) == builtin_properties::UNKNOWN_NAME);
}

fn void enum_names() @test
{
	assert(builtin_properties::header_from_name("arm_acle")!! == ARM_ACLE);
	assert(builtin_properties::header_from_name("none")!! == Header.NONE);
	assert(@catch(builtin_properties::header_from_name("ARM_ACLE")) == builtin_properties::UNKNOWN_NAME);
	assert(builtin_properties::language_from_name("c23_lang")!! == C23_LANG);
	assert(builtin_properties::format_kind_from_name("vprintf")!! == VPRINTF);
	assert(builtin_properties::group_from_name("aarch64_neon")!! == AARCH64_NEON);
	assert(@catch(builtin_properties::group_from_name("x86-64")) == builtin_properties::UNKNOWN_NAME);
}

fn void groups_match_builds() @test
{
	check(BuiltinGroup::len, 19);
	// BuiltinBase groups in Builtins.zig.
	foreach (g : BuiltinGroup::values)
	{
		bool base = g == COMMON || g == MIPS || g == VE || g == XCORE;
		assert(g.has_features == !base, "%s", g);
	}
}

fn void tag_layout() @test
{
	BuiltinTag t = { .group = X86, .index = 0x1234 };
	check((uint)t, ((uint)BuiltinGroup.X86.ordinal << 16) | 0x1234);
}

fn void var_args() @test
{
	assert(builtin_properties::is_var_args("v."));
	assert(!builtin_properties::is_var_args("vC*"));
}

fn void emit_header_is_deterministic() @test
{
	DefFile file;
	file.init(mem, BPF);
	defer file.free();
	String a = generate_def::emit_table(mem, &file, "bpf.def");
	defer free(a.ptr);
	String b = generate_def::emit_table(mem, &file, "bpf.def");
	defer free(b.ptr);
	assert(a == b);
	assert(a.starts_with("// Autogenerated by tools/generate_def.c3 from bpf.def, do not edit.\nmodule aro::builtin_defs::bpf;\n"));
}
