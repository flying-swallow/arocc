// Data-driven tests: every vector in test/c3/data/integer_values/*.txt (format in
// that directory's README.md) is checked against aro::value (src/c3/value.c3) and
// the value interner.
//
// The vectors were generated by running Zig 0.17.0's std.math.big.int under a
// near-verbatim port of the integer paths of src/aro/Value.zig (provenance
// `zig-0.17.0`), copied from Value.zig's own tests (`aro-test`), or hold the exact
// result where Zig 0.17.0 has a std defect (`zig-0.17.0-stdbug`). They are not
// differential evidence against the pinned Zig 0.18.0-dev.
//
// For every vector the expected result is interned and must have the same ref as
// the computed one (interning deduplication across i64/u64/big-int keys); the two
// BigIntConsts must also be equal, so an interner bug and an arithmetic bug are
// reported separately. Each file's `# end: N vectors` count is asserted.
//
// Files are read relative to the working directory (the Bazel runfiles root), or
// from $INTEGER_VECTORS_DIR when set.
module integer_vector_tests;
import aro::value, aro::value_interner, aro::bigint, aro::type_store, aro::target, aro::compilation, aro::lang_opts;
import std::io, std::os::env, std::core::mem::allocators;

const Host HOST = { X86_64, LINUX, GNU };
const usz MAX_REPORTED = 20;

struct VectorRun
{
	Compilation* comp;
	String file;
	usz line_no;
	usz vectors;
	usz failures;
	// Scratch limbs for parsing ints (vectors are at most a few hundred bits).
	Limb[64] parse_limbs;
}

fn String vectors_dir()
{
	if (try d = env::get_var(tmem, "INTEGER_VECTORS_DIR")) return d;
	return "test/c3/data/integer_values";
}

fn void VectorRun.fail(&self, String line, String msg)
{
	self.failures++;
	if (self.failures <= MAX_REPORTED) io::eprintfn("%s:%d: %s\n    %s", self.file, self.line_no, msg, line);
}

<* Parse `[-]0x<hex>` and intern it. *>
fn Value? VectorRun.parse_int(&self, String s)
{
	bool negative = s.starts_with("-");
	String digits = negative ? s[1..] : s;
	if (!digits.starts_with("0x")) return value::NO_INT~;
	digits = digits[2..];
	if (digits.len == 0 || bigint::calc_set_string_limb_count(16, digits.len) > self.parse_limbs.len) return value::NO_INT~;
	BigIntMutable m = { .limbs = self.parse_limbs[..], .len = 1, .positive = true };
	m.set_string(16, digits, {})!;
	if (negative) m.positive = m.to_const().eql_zero();
	return value::intern_big(self.comp, m.to_const());
}

fn String VectorRun.show(&self, Value v)
{
	if (v.is_none()) return "none";
	InternerKey key = self.comp.interner.get(v.ref());
	if (key.tag != INT) return string::tformat("<key tag %s>", key.tag);
	BigIntSpace space;
	BigIntConst big = key.to_big_int(&space);
	String hex = big.to_string_alloc(tmem, 16, false);
	if (!big.positive) return string::tformat("-0x%s", hex[1..]);
	return string::tformat("0x%s", hex);
}

<* Compare a computed value with the expected text (`none` or an int). *>
fn void VectorRun.expect_value(&self, String line, Value got, String want_text)
{
	if (want_text == "none")
	{
		if (!got.is_none()) self.fail(line, string::tformat("got %s, want none", self.show(got)));
		return;
	}
	Value? want_opt = self.parse_int(want_text);
	if (catch want_opt)
	{
		self.fail(line, "bad expected int");
		return;
	}
	Value want = want_opt;
	if (got.is_none())
	{
		self.fail(line, string::tformat("got none, want %s", want_text));
		return;
	}
	if (!got.is(INT, self.comp))
	{
		self.fail(line, string::tformat("got %s, want an int", self.show(got)));
		return;
	}
	BigIntSpace gs;
	BigIntSpace ws;
	bool same = got.to_big_int(&gs, self.comp).eql(want.to_big_int(&ws, self.comp));
	if (!same)
	{
		self.fail(line, string::tformat("got %s, want %s", self.show(got), want_text));
		return;
	}
	if (got.opt_ref != want.opt_ref) self.fail(line, "equal values interned to different refs");
}

fn void VectorRun.expect_flag(&self, String line, String got, String want)
{
	if (got != want) self.fail(line, string::tformat("flag %s, want %s", got, want));
}

fn String ov(bool b) => b ? "overflow" : "ok";

fn void VectorRun.run_line(&self, String line)
{
	String[8] buf;
	String[]? fields_opt = line.split_to_buffer(" ", buf[..]);
	if (catch fields_opt)
	{
		self.fail(line, "more than 8 fields");
		return;
	}
	String[] f = fields_opt;
	if (f.len != 8)
	{
		self.fail(line, "expected 8 fields");
		return;
	}
	self.vectors++;
	String op = f[0];
	Compilation* comp = self.comp;

	QualType qt;
	bool has_type = f[1] != "_";
	if (has_type)
	{
		Signedness s = f[1] == "s" ? SIGNED : UNSIGNED;
		int? bits = f[2].to_int();
		if (catch bits)
		{
			self.fail(line, "bad bits");
			return;
		}
		qt = comp.type_store.put(type_store::type_bit_int((ushort)bits, s));
		if (qt.bit_sizeof(comp) != (ulong)bits)
		{
			self.fail(line, "bit_sizeof mismatch");
			return;
		}
	}
	Value lhs = value::NONE;
	Value rhs = value::NONE;
	if (f[3] != "_")
	{
		Value? l = self.parse_int(f[3]);
		if (catch l) { self.fail(line, "bad lhs"); return; }
		lhs = l;
	}
	if (f[4] != "_")
	{
		Value? r = self.parse_int(f[4]);
		if (catch r) { self.fail(line, "bad rhs"); return; }
		rhs = r;
	}
	String want = f[5];
	String flag = f[6];

	switch (op)
	{
		case "min_unsigned_bits":
		case "min_signed_bits":
			usz got = op == "min_unsigned_bits" ? lhs.min_unsigned_bits(comp) : lhs.min_signed_bits(comp);
			String got_text = string::tformat("%d", got);
			if (got_text != want) self.fail(line, string::tformat("got %s", got_text));
		case "min_int":
			self.expect_value(line, value::min_int(qt, comp), want);
		case "max_int":
			self.expect_value(line, value::max_int(qt, comp), want);
		case "int_cast":
			Value v = lhs;
			IntCastChangeKind kind = v.int_cast(qt, comp);
			self.expect_value(line, v, want);
			String kind_text;
			switch (kind)
			{
				case NONE: kind_text = "none";
				case TRUNCATED: kind_text = "truncated";
				case SIGN_CHANGED: kind_text = "sign_changed";
			}
			self.expect_flag(line, kind_text, flag);
		case "add":
			Value res = value::NONE;
			bool o = res.add(lhs, rhs, qt, comp);
			self.expect_value(line, res, want);
			self.expect_flag(line, ov(o), flag);
		case "sub":
			Value res = value::NONE;
			bool o = res.sub(lhs, rhs, qt, comp);
			self.expect_value(line, res, want);
			self.expect_flag(line, ov(o), flag);
		case "mul":
			Value res = value::NONE;
			bool o = res.mul(lhs, rhs, qt, comp);
			self.expect_value(line, res, want);
			self.expect_flag(line, ov(o), flag);
		case "div":
			Value res = value::NONE;
			bool o = res.div(lhs, rhs, qt, comp);
			self.expect_value(line, res, want);
			self.expect_flag(line, ov(o), flag);
		case "rem":
			self.expect_value(line, value::rem(lhs, rhs, qt, comp), want);
		case "order":
			String got;
			if (value::compare(lhs, LT, rhs, comp))
			{
				got = "lt";
			}
			else if (value::compare(lhs, EQ, rhs, comp))
			{
				got = "eq";
			}
			else
			{
				got = "gt";
			}
			// The other operators must agree with the ordering.
			bool consistent = value::compare(lhs, GT, rhs, comp) == (got == "gt")
				&& value::compare(lhs, NEQ, rhs, comp) == (got != "eq")
				&& value::compare(lhs, LTE, rhs, comp) == (got != "gt")
				&& value::compare(lhs, GTE, rhs, comp) == (got != "lt");
			if (!consistent) self.fail(line, "compare operators disagree");
			self.expect_flag(line, got, flag);
		case "shl":
			Value res = value::NONE;
			bool o = res.shl(lhs, rhs, qt, comp);
			self.expect_value(line, res, want);
			self.expect_flag(line, ov(o), flag);
		case "shr":
			self.expect_value(line, value::shr(lhs, rhs, qt, comp), want);
		case "bit_and":
			self.expect_value(line, value::bit_and(lhs, rhs, comp), want);
		case "bit_or":
			self.expect_value(line, value::bit_or(lhs, rhs, comp), want);
		case "bit_xor":
			self.expect_value(line, value::bit_xor(lhs, rhs, comp), want);
		case "bit_not":
			self.expect_value(line, value::bit_not(lhs, qt, comp), want);
		default:
			self.fail(line, "unknown op");
	}
}

<* Run every vector of `name`; returns the number of vectors read. *>
fn void run_file(String name)
{
	TrackingAllocator ta;
	ta.init(mem);
	defer ta.free();
	{
		Compilation comp;
		comp.init(&ta);
		comp.target = target::parse_triple("x86_64-linux-gnu", HOST)!!;
		comp.langopts.set_target_options(&comp.target);
		type_store::init_named_types(&comp);

		String path = string::format(mem, "%s/%s", vectors_dir(), name);
		defer free(path);
		char[] data = file::load(mem, path)!!;
		defer free(data);

		VectorRun run = { .comp = &comp, .file = name };
		long end_count = -1;
		String text = (String)data;
		usz start = 0;
		while (start < text.len)
		{
			usz end = start;
			while (end < text.len && text[end] != '\n') end++;
			String line = text[start:end - start];
			start = end + 1;
			run.line_no++;
			if (line.len == 0) continue;
			if (line[0] == '#')
			{
				if (line.starts_with("# end: "))
				{
					String rest = line[7..];
					String[2] buf;
					String[] parts = rest.split_to_buffer(" ", buf[..], 2)!!;
					end_count = parts[0].to_long()!!;
				}
				continue;
			}
			@pool()
			{
				run.run_line(line);
			};
		}
		comp.free();

		io::printfn("%s: %d vectors, %d failures (end marker %d)", name, run.vectors, run.failures, end_count);
		if (run.failures > MAX_REPORTED) io::eprintfn("%s: %d further failures not shown", name, run.failures - MAX_REPORTED);
		assert(end_count >= 0, "%s: missing '# end: N vectors' line", name);
		assert(run.vectors == (usz)end_count, "%s: read %d vectors, end marker says %d", name, run.vectors, end_count);
		assert(run.failures == 0, "%s: %d failing vectors", name, run.failures);
	}
	assert(ta.allocation_count() == 0, "%s: leaked %d allocations", name, ta.allocation_count());
}

fn void bit_counts() @test => run_file("bit_counts.txt");
fn void limits() @test => run_file("limits.txt");
fn void int_cast() @test => run_file("int_cast.txt");
fn void arith() @test => run_file("arith.txt");
fn void shifts() @test => run_file("shifts.txt");
fn void bitwise() @test => run_file("bitwise.txt");
