macro check128(uint128 left, uint128 right)
{
	test::eq((ulong)(left >> 64), (ulong)(right >> 64));
	test::eq((ulong)left, (ulong)right);
}

fn void report(sz i, Vec v, uint128 x, uint128 y)
{
	io::eprintfn("vector %d (%s %s): got x=%x:%x y=%x:%x, want x=%x:%x y=%x:%x", i, v.op, v.tag,
		(ulong)(x >> 64), (ulong)x, (ulong)(y >> 64), (ulong)y,
		(ulong)(v.x >> 64), (ulong)v.x, (ulong)(v.y >> 64), (ulong)v.y);
}

<* Runs every vector of width `tag` through aro::annex_g on KeyFloat. *>
fn void run_keyfloat(KeyFloatTag tag)
{
	sz n = 0;
	foreach (i, v : VECTORS)
	{
		if (v.tag != tag) continue;
		n++;
		KeyFloat a = float_value::from_raw(tag, v.a);
		KeyFloat b = float_value::from_raw(tag, v.b);
		KeyFloat c = float_value::from_raw(tag, v.c);
		KeyFloat d = float_value::from_raw(tag, v.d);
		// Not `cond ? mul(..) : div(..)`: c3c 0.8.5 -O0 lost r.cf64[1] that way.
		KeyComplex r;
		if (v.op == MUL)
		{
			r = annex_g::complex_float_mul(a, b, c, d);
		}
		else
		{
			r = annex_g::complex_float_div(a, b, c, d);
		}
		assert(r.tag == float_value::complex_tag_of(tag));
		KeyFloat[2] p = r.parts();
		if (p[0].raw() != v.x || p[1].raw() != v.y) report(i, v, p[0].raw(), p[1].raw());
		check128(p[0].raw(), v.x);
		check128(p[1].raw(), v.y);
	}
	assert(n == 37);
}

// ---------------------------------------------------------------------------
// aro::annex_g over KeyFloat, every width (needs 10.1 / 10.2 arithmetic)
// ---------------------------------------------------------------------------

fn void keyfloat_vectors_f16() @test { run_keyfloat(F16); }
fn void keyfloat_vectors_f32() @test { run_keyfloat(F32); }
fn void keyfloat_vectors_f64() @test { run_keyfloat(F64); }
fn void keyfloat_vectors_f80() @test { run_keyfloat(F80); }
fn void keyfloat_vectors_f128() @test { run_keyfloat(F128); }

const ulong F64_INF = 0x7FF0_0000_0000_0000;
const ulong F64_NAN = 0x7FF8_0000_0000_0000;
const ulong F64_TWO = 0x4000_0000_0000_0000;

fn void embedded_zig_mul() @test
{
	// Naive algorithm would produce NaN + NaNi instead of inf + NaNi
	KeyFloat[2] r = annex_g::complex_float_mul(float_value::f64_value(F64_INF), float_value::f64_value(F64_NAN),
		float_value::f64_value(F64_TWO), float_value::f64_value(0)).parts();
	assert(r[0].is_inf());
	assert(r[1].is_nan());
}

fn void embedded_zig_div() @test
{
	// Naive algorithm would produce NaN + NaNi instead of inf + NaNi
	KeyFloat[2] r = annex_g::complex_float_div(float_value::f64_value(F64_INF), float_value::f64_value(F64_NAN),
		float_value::f64_value(F64_TWO), float_value::f64_value(0)).parts();
	assert(r[0].is_inf());
	assert(r[1].is_nan());

	r = annex_g::complex_float_div(float_value::f64_value(F64_TWO), float_value::f64_value(F64_TWO),
		float_value::f64_value(0), float_value::f64_value(0)).parts();
	assert(r[0].is_inf());
	assert(r[1].is_inf());
}

// ---------------------------------------------------------------------------
// Native reference port, checked against the f16/f32/f64 vectors
// ---------------------------------------------------------------------------

alias RunFn = fn uint128[2](bool is_mul, uint128 a, uint128 b, uint128 c, uint128 d);

fn uint128[2] run_f16(bool m, uint128 a, uint128 b, uint128 c, uint128 d)
{
	ushort[2] r = nref::run{float16, ushort, 5, 10}(m, (ushort)a, (ushort)b, (ushort)c, (ushort)d);
	return { r[0], r[1] };
}

fn uint128[2] run_f32(bool m, uint128 a, uint128 b, uint128 c, uint128 d)
{
	uint[2] r = nref::run{float, uint, 8, 23}(m, (uint)a, (uint)b, (uint)c, (uint)d);
	return { r[0], r[1] };
}

fn uint128[2] run_f64(bool m, uint128 a, uint128 b, uint128 c, uint128 d)
{
	ulong[2] r = nref::run{double, ulong, 11, 52}(m, (ulong)a, (ulong)b, (ulong)c, (ulong)d);
	return { r[0], r[1] };
}

fn void run_native(RunFn f, KeyFloatTag tag)
{
	sz n = 0;
	foreach (i, v : VECTORS)
	{
		if (v.tag != tag) continue;
		n++;
		uint128[2] r = f(v.op == MUL, v.a, v.b, v.c, v.d);
		if (r[0] != v.x || r[1] != v.y) report(i, v, r[0], r[1]);
		check128(r[0], v.x);
		check128(r[1], v.y);
	}
	assert(n == 37);
}

fn void native_reference_f16() @test { run_native(&run_f16, F16); }
fn void native_reference_f32() @test { run_native(&run_f32, F32); }
fn void native_reference_f64() @test { run_native(&run_f64, F64); }

fn void native_reference_embedded_zig() @test
{
	uint128[2] r = run_f64(true, F64_INF, F64_NAN, F64_TWO, 0);
	assert(r[0] == F64_INF);
	assert((r[1] & ~((uint128)1 << 63)) == F64_NAN);
	r = run_f64(false, F64_TWO, F64_TWO, 0, 0);
	assert(r[0] == F64_INF && r[1] == F64_INF);
}

<*
 Native-float port of annex_g.zig plus Zig 0.17.0 std.math.ldexp / ilogb for
 IEEE binary formats (not f80). EXP_BITS / MANT_BITS are Zig's
 floatExponentBits / floatMantissaBits. Inputs go through a volatile global so
 the arithmetic runs on the CPU (x86 NaN rules) instead of being folded.
*>
module annex_g_tests::nref <FloatT, BitsT, EXP_BITS, MANT_BITS>;

const BitsT SIGN = (BitsT)1 << (EXP_BITS + MANT_BITS);
const BitsT INF_BITS = (((BitsT)1 << EXP_BITS) - 1) << MANT_BITS;
const BitsT ABS_MASK = SIGN - 1;
const BitsT MANT_MASK = ((BitsT)1 << MANT_BITS) - 1;
const int MAX_EXP = (1 << EXP_BITS) - 1;
const int BIAS = MAX_EXP >> 1;

BitsT g_in;

fn FloatT load(BitsT b)
{
	g_in = b;
	return bitcast(@volatile_load(g_in), FloatT);
}

fn BitsT bits_of(FloatT x) => bitcast(x, BitsT);
fn FloatT from_bits(BitsT b) => bitcast(b, FloatT);
fn bool is_nan(FloatT x) => (bits_of(x) & ABS_MASK) > INF_BITS;
fn bool is_inf(FloatT x) => (bits_of(x) & ABS_MASK) == INF_BITS;
fn bool is_finite(FloatT x) => (bits_of(x) & ABS_MASK) < INF_BITS;
fn bool is_positive_zero(FloatT x) => bits_of(x) == 0;
fn FloatT copysign(FloatT mag, FloatT s) => from_bits((bits_of(mag) & ABS_MASK) | (bits_of(s) & SIGN));
fn FloatT fabs(FloatT x) => from_bits(bits_of(x) & ABS_MASK);
fn FloatT inf() => from_bits(INF_BITS);
fn FloatT one_or_zero(bool one) => one ? (FloatT)1.0 : (FloatT)0.0;

<* Zig @max on floats as Annex G uses it (operands are absolute values). *>
fn FloatT fmax(FloatT a, FloatT b)
{
	if (is_nan(a)) return b;
	if (is_nan(b)) return a;
	return a < b ? b : a;
}

<* lib/std/math/ilogb.zig ilogbX *>
fn int ilogb(FloatT x)
{
	BitsT u = bits_of(x) & (SIGN - 1);
	int e = (int)(u >> MANT_BITS);
	if (e == 0)
	{
		if (u == 0) return int::min;
		int offset = 1 + EXP_BITS - BIAS;
		return offset - (int)u.clz();
	}
	if (e == MAX_EXP) return u > INF_BITS ? int::min : int::max;
	return e - BIAS;
}

<* lib/std/math/ldexp.zig ldexp (= scalbn), IEEE formats *>
fn FloatT ldexp(FloatT x, int n)
{
	int max_biased_exponent = 2 * BIAS;
	BitsT repr = bits_of(x);
	BitsT sign_bit = repr & SIGN;
	if (is_nan(x) || !is_finite(x)) return x;
	BitsT repr_shl = (BitsT)(repr << 1); // C3 promotes ushort arithmetic to int: truncate like Zig
	int exponent = (int)(repr_shl >> (MANT_BITS + 1));
	if (exponent == 0) exponent += EXP_BITS - (int)repr_shl.clz();
	if (n >= 0)
	{
		if (n > max_biased_exponent - exponent) return from_bits(INF_BITS | sign_bit);
		if (exponent + n <= 0) return from_bits((repr << n) | sign_bit);
		if (exponent <= 0)
		{
			BitsT result = (BitsT)(n + exponent) << MANT_BITS;
			result |= (repr << (1 - exponent)) & MANT_MASK;
			return from_bits(result | sign_bit);
		}
		return from_bits(repr + ((BitsT)n << MANT_BITS));
	}
	if (n <= -exponent)
	{
		if (n < -(MANT_BITS + exponent)) return from_bits(sign_bit);
		int shift = -n < -(exponent + n) + 1 ? -n : -(exponent + n) + 1;
		bool exact_tie = (int)repr.ctz() == shift - 1;
		BitsT result = repr & MANT_MASK;
		result |= (BitsT)(exponent > 0 ? 1 : 0) << MANT_BITS;
		result = result >> (shift - 1);
		result = ((result + 1) >> 1) & ~(BitsT)(exact_tie ? 1 : 0);
		return from_bits(result | sign_bit);
	}
	return from_bits(repr - ((BitsT)(-n) << MANT_BITS));
}

// One rounding per operation: c3c evaluates a compound float16 expression in
// float and rounds only at the end, so every operation goes through a function.
fn FloatT fa(FloatT x, FloatT y) => x + y;
fn FloatT fs(FloatT x, FloatT y) => x - y;
fn FloatT fm(FloatT x, FloatT y) => x * y;
fn FloatT fd(FloatT x, FloatT y) => x / y;

fn FloatT[2] mul(FloatT a, FloatT b, FloatT c, FloatT d)
{
	FloatT ac = a * c;
	FloatT bd = b * d;
	FloatT ad = a * d;
	FloatT bc = b * c;
	FloatT x = ac - bd;
	FloatT y = ad + bc;
	if (is_nan(x) && is_nan(y))
	{
		bool recalc = false;
		if (is_inf(a) || is_inf(b))
		{
			a = copysign(one_or_zero(is_inf(a)), a);
			b = copysign(one_or_zero(is_inf(b)), b);
			if (is_nan(c)) c = copysign(0.0, c);
			if (is_nan(d)) d = copysign(0.0, d);
			recalc = true;
		}
		if (is_inf(c) || is_inf(d))
		{
			c = copysign(one_or_zero(is_inf(c)), c);
			d = copysign(one_or_zero(is_inf(d)), d);
			if (is_nan(a)) a = copysign(0.0, a);
			if (is_nan(b)) b = copysign(0.0, b);
			recalc = true;
		}
		if (!recalc && (is_inf(ac) || is_inf(bd) || is_inf(ad) || is_inf(bc)))
		{
			if (is_nan(a)) a = copysign(0.0, a);
			if (is_nan(b)) b = copysign(0.0, b);
			if (is_nan(c)) c = copysign(0.0, c);
			if (is_nan(d)) d = copysign(0.0, d);
		}
		if (recalc)
		{
			x = fm(inf(), fs(fm(a, c), fm(b, d)));
			y = fm(inf(), fa(fm(a, d), fm(b, c)));
		}
	}
	return { x, y };
}

fn FloatT[2] div(FloatT a, FloatT b, FloatT c, FloatT d)
{
	int denom_logb = 0;
	FloatT max_cd = fmax(fabs(c), fabs(d));
	if (is_finite(max_cd))
	{
		if (max_cd == 0)
		{
			denom_logb = int::min + 1;
			c = 0;
			d = 0;
		}
		else
		{
			denom_logb = ilogb(max_cd);
			c = ldexp(c, -denom_logb);
			d = ldexp(d, -denom_logb);
		}
	}
	FloatT denom = fa(fm(c, c), fm(d, d));
	FloatT x = ldexp(fd(fa(fm(a, c), fm(b, d)), denom), -denom_logb);
	FloatT y = ldexp(fd(fs(fm(b, c), fm(a, d)), denom), -denom_logb);
	if (is_nan(x) && is_nan(y))
	{
		if (is_positive_zero(denom) && (!is_nan(a) || !is_nan(b)))
		{
			x = fm(copysign(inf(), c), a);
			y = fm(copysign(inf(), c), b);
		}
		else if ((is_inf(a) || is_inf(b)) && is_finite(c) && is_finite(d))
		{
			a = copysign(one_or_zero(is_inf(a)), a);
			b = copysign(one_or_zero(is_inf(b)), b);
			x = fm(inf(), fa(fm(a, c), fm(b, d)));
			y = fm(inf(), fs(fm(b, c), fm(a, d)));
		}
		else if (is_inf(max_cd) && is_finite(a) && is_finite(b))
		{
			c = copysign(one_or_zero(is_inf(c)), c);
			d = copysign(one_or_zero(is_inf(d)), d);
			x = fm(0.0, fa(fm(a, c), fm(b, d)));
			y = fm(0.0, fs(fm(b, c), fm(a, d)));
		}
	}
	return { x, y };
}

fn BitsT[2] run(bool is_mul, BitsT a, BitsT b, BitsT c, BitsT d)
{
	FloatT fa = load(a);
	FloatT fb = load(b);
	FloatT fc = load(c);
	FloatT fd = load(d);
	FloatT[2] r = is_mul ? mul(fa, fb, fc, fd) : div(fa, fb, fc, fd);
	return { bits_of(r[0]), bits_of(r[1]) };
}

// Probe program (Zig 0.17.0) that produced VECTORS; annex_g.zig is a verbatim
// copy of src/aro/annex_g.zig placed next to it. Run: `zig run probe.zig`.
//
// const std = @import("std");
// const g = @import("annex_g.zig");
// const inf = std.math.inf(f64);
// const nan = std.math.nan(f64);
// const sub = 4.9406564584124654e-324;
// const Case = [4]f64;
// const mul_cases = [_]Case{
//     .{ 1, 2, 3, 4 },          .{ inf, nan, 2, 0 },        .{ nan, inf, nan, 0 },
//     .{ inf, inf, 1, -1 },     .{ 1e308, nan, 1e308, 1 },  .{ 0, 0, inf, 0 },
//     .{ -inf, 1, nan, nan },   .{ nan, nan, 1, 2 },        .{ -0.0, 0, 0, -0.0 },
//     .{ inf, 0, 0, inf },      .{ 1, nan, -inf, 2 },       .{ 0.1, 0.2, 0.3, 0.7 },
//     .{ 6e4, 6e4, 6e4, -6e4 }, .{ nan, 1, 2, 3 },
// };
// const div_cases = [_]Case{
//     .{ inf, nan, 2, 0 },      .{ 2, 2, 0, 0 },            .{ 1, 2, 3, 4 },
//     .{ 1, 1, inf, 1 },        .{ 1e300, 1e300, 1e-300, 1e-300 },
//     .{ 1, 0, sub, 0 },        .{ nan, 1, 0, 0 },          .{ -2, 3, -0.0, 0 },
//     .{ nan, nan, 1, 1 },      .{ inf, inf, inf, 1 },      .{ 5, -7, nan, 1 },
//     .{ 1, 1, nan, -inf },     .{ 1, 1, 1e-310, 3 },       .{ 0.1, 0.2, 0.3, 0.7 },
