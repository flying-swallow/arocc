// Tests for aro::target (src/c3/target*.c3) and LangOpts.set_target_options.
//
// Sources of expected values:
// - RECORD_VECTORS: generated by tools/gen_target_record_vectors.py from
//   test/records/0013_test.c (repr-c expectations: sizeof/_Alignof of the
//   basic types for 105 arch-cpu-os-abi targets). Fixture-derived.
// - "Target.zig unit tests": ported verbatim from the `test` blocks of
//   src/aro/Target.zig (parseArchName, parseAbi, parseOs, "alignment
//   functions - smoke test", "target size/align tests").
// - FIXTURE_TRIPLES and the *_fixture tests: every --target used by
//   test/cases plus facts those fixtures assert (avr/msp430 builtin types,
//   float header goldens, ppc elf v2, arm-acle-6.4 LDREX/profile macros,
//   uefi intmax_t, Toolchain/Linux.zig's x86_64 dynamic linker).
// - Everything else is source-derived: expected values come from reading
//   Target.zig / Driver.zig and the Zig std.Target rules documented in
//   src/c3/target_data.c3 (no Zig executable was run; no differential parity
//   is claimed).
//
// Exact coverage:
// - record_vectors: 105 arch-os-abi targets x 16 values (sizeof/_Alignof of
//   char, short, int, long, long long, void*, float, double): aarch64 13
//   (incl. Darwin, Windows MSVC, Android), arm 15, thumb 9 (incl. Windows MSVC),
//   hexagon 1, mips/mipsel/mips64/mips64el 12 (o32/n64, r6), powerpc 3,
//   powerpc64 3, powerpc64le 2, riscv32 2, riscv64 2, s390x 1, sparc 1,
//   sparc64 4, wasm32 3, x86 13 (Linux/BSD/Haiku/Android/Windows MSVC+MinGW/
//   UEFI), x86_64 19 (incl. x32, Darwin, Windows MSVC+MinGW, UEFI), avr 1,
//   msp430 1. 88 rows also parse the repr-c -mcpu model; 17 rows name models
//   not in CpuModel (aarch64 "armv8a", "rv32gc", "rv64gc") and use the default.
//   Not covered: x86/arm Darwin (skipped by test/record_runner.zig).
// - abi_matrix: 37 triples x (pointer width, long, long double bits/size/align,
//   long long and double alignment, wchar_t, char signedness, endianness,
//   long double FP semantics, LLVM triple) over Linux x86/x86_64/x32, ARM,
//   AArch64 (+ILP32, big endian), Windows MSVC/MinGW/UEFI, Darwin (macOS, iOS,
//   simulator), wasm32/64, RISC-V 32/64, MIPS o32/n32/n64, PowerPC 32/64/64le
//   (glibc, musl, FreeBSD), AVR, MSP430, s390x, sparc64, NetBSD x86.
// - bitfield_policy: 25 triples x the six record-layout policy queries.
// - fixture_triples_parse: all 47 --target strings of test/cases.
// - malformed_triples / android_api_text: every Driver.parseTarget error
//   (unknown arch/OS/ABI, bad OS/ABI/API versions, extra fields, overlong names,
//   unknown -mcpu model or feature).
// - Target.zig unit tests: all five `test` blocks.
// - Not verified anywhere (no fixture, no Zig binary): Darwin/BSD/Linux default
//   OS version ranges, glibc/Android defaults, CPU model feature lists beyond the
//   fixture-checked ARM/x86 ones, non-x86_64 dynamic linker paths.
module target_tests;
import aro::target, aro::lang_opts, aro::compilation, std::io, std::core::mem::allocators;

<* test::eq for integers of mixed signedness, compared as long. *>
macro check(left, right)
{
	test::eq((long)left, (long)right);
}

const Host HOST = { X86_64, LINUX, GNU };

fn Target tgt(String triple, String cpu = "")
{
	Target? t = target::parse_triple(triple, HOST, cpu);
	if (catch f = t)
	{
		io::eprintfn("failed to parse target '%s' (cpu '%s'): %s", triple, cpu, f);
		unreachable("target parse failed");
	}
	return t;
}

fn fault parse_fault(String triple, String cpu = "", String expected_text = "")
{
	TripleError err;
	Target? t = target::parse_triple(triple, HOST, cpu, &err);
	if (catch f = t)
	{
		if (expected_text.len) test::eq(err.text, expected_text);
		return f;
	}
	unreachable("expected a parse error");
}

// ---------------------------------------------------------------------------
// Record-derived size/alignment vectors
// ---------------------------------------------------------------------------

struct RecordVector
{
	String triple;
	String cpu;
	<* sizeof/_Alignof pairs: char, short, int, long, long long, void*, float, double *>
	ushort[16] values;
}

