	{ "mips64el-linux-gnuabin32", 32, 32, 128, 16, 16, 8, 8, INT, SIGNED, LITTLE, IEEE_QUAD, "mips64el-linux-gnuabin32" },
	// PowerPC
	{ "powerpc-linux-gnu", 32, 32, 128, 16, 16, 8, 8, INT, UNSIGNED, BIG, IBM_EXTENDED_DOUBLE, "powerpc-linux-gnu" },
	{ "powerpc64-linux-gnu", 64, 64, 128, 16, 16, 8, 8, INT, UNSIGNED, BIG, IBM_EXTENDED_DOUBLE, "powerpc64-linux-gnu" },
	{ "powerpc64le-linux-musl", 64, 64, 64, 8, 8, 8, 8, INT, UNSIGNED, LITTLE, IEEE_DOUBLE, "powerpc64le-linux-musl" },
	{ "powerpc64-freebsd.13.1-gnu", 64, 64, 64, 8, 8, 8, 8, INT, UNSIGNED, BIG, IEEE_DOUBLE, "powerpc64-freebsd-gnu" },
	// Small and other targets with fixtures
	{ "avr-freestanding-none", 16, 32, 32, 4, 1, 1, 1, INT, SIGNED, LITTLE, IEEE_SINGLE, "avr-unknown-unknown" },
	{ "msp430-other-none", 16, 32, 64, 8, 2, 2, 2, UINT, UNSIGNED, LITTLE, IEEE_DOUBLE, "msp430-unknown-unknown" },
	{ "s390x-linux-gnu", 64, 64, 128, 16, 8, 8, 8, INT, UNSIGNED, BIG, IEEE_QUAD, "s390x-linux-gnu" },
	{ "sparc64-linux-gnu", 64, 64, 128, 16, 16, 8, 8, INT, SIGNED, BIG, IEEE_QUAD, "sparc64-linux-gnu" },
	{ "x86-netbsd.6.99.26-gnu", 32, 32, 80, 12, 4, 4, 4, INT, SIGNED, LITTLE, X87_EXTENDED_DOUBLE, "i386-netbsd-gnu" },
};

fn void abi_matrix() @test
{
	foreach (v : ABI_VECTORS)
	{
		Target t = tgt(v.triple);
		char[64] buf;
		String llvm = t.to_llvm_triple(&buf);
		bool ok = t.ptr_bit_width() == v.ptr_bits
			&& t.c_type_bit_size(LONG) == v.long_bits
			&& t.c_type_bit_size(LONGDOUBLE) == v.ld_bits
			&& t.c_type_byte_size(LONGDOUBLE) == v.ld_size
			&& t.c_type_alignment(LONGDOUBLE) == v.ld_align
			&& t.c_type_alignment(LONGLONG) == v.ll_align
			&& t.c_type_alignment(DOUBLE) == v.double_align
			&& t.wchar_type() == v.wchar
			&& t.c_char_signedness() == v.char_sign
			&& t.cpu.arch.endian() == v.endian
			&& target::fp_semantics_for_type(LONGDOUBLE, &t) == v.ld_sem
			&& llvm == v.llvm;
		if (!ok)
		{
			io::eprintfn("%s: ptr %d long %d ld %d/%d/%d ll_align %d double_align %d wchar %s char %s endian %s sem %s llvm %s",
				v.triple, t.ptr_bit_width(), t.c_type_bit_size(LONG), t.c_type_bit_size(LONGDOUBLE),
				t.c_type_byte_size(LONGDOUBLE), t.c_type_alignment(LONGDOUBLE), t.c_type_alignment(LONGLONG),
				t.c_type_alignment(DOUBLE), t.wchar_type(), t.c_char_signedness(), t.cpu.arch.endian(),
				target::fp_semantics_for_type(LONGDOUBLE, &t), llvm);
			unreachable("ABI vector mismatch");
		}
	}
}

struct BitfieldVector
{
	String triple;
	String cpu;
	bool ignore_non_zero;
	bool ignore_zero;
	uint min_zero_width;
	bool unnamed_affects;
	uint default_align;
	bool pack_enums;
}

const BitfieldVector[*] BITFIELD_VECTORS = {
	{ "x86_64-linux-gnu", "", false, false, 0, false, 16, false },
	{ "i386-linux-gnu", "", false, false, 0, false, 16, false },
	{ "arm-linux-gnueabihf", "", false, false, 0, true, 8, false },
	{ "armv7a-linux-androideabi", "", false, false, 0, true, 16, false },
	{ "armv7-apple-ios", "", true, false, 32, true, 16, false },
	{ "arm-apple-ios", "", false, false, 0, true, 16, false },
	{ "armv7aeb-freestanding", "", false, false, 0, true, 8, false },
	{ "armv7aeb-linux", "", false, false, 0, false, 8, false },
	{ "thumbv7m-freestanding-eabi", "", false, false, 0, true, 8, false },
	{ "thumb-windows-msvc", "", false, false, 0, false, 8, false },
	{ "aarch64-linux-gnu", "", false, false, 0, true, 16, false },
	{ "aarch64-macos", "", false, false, 0, false, 16, false },
	{ "aarch64-windows-msvc", "", false, false, 0, false, 16, false },
	{ "x86_64-windows-msvc", "", false, false, 0, false, 16, false },
	{ "wasm32-wasi", "", false, false, 0, false, 16, false },
	{ "riscv64-linux-gnu", "", false, false, 0, false, 16, false },
	{ "mips-linux-gnu", "", false, false, 0, false, 8, false },
	{ "mips-other-none", "", false, false, 0, false, 16, false },
	{ "mips64-linux-gnuabi64", "", false, false, 0, false, 16, false },
	{ "powerpc64le-linux-gnu", "", false, false, 0, false, 16, false },
	{ "s390x-linux-gnu", "", false, false, 0, false, 8, false },
	{ "sparc-linux-gnu", "", false, false, 0, false, 16, false },
	{ "sparc-linux-gnu", "v8", false, false, 0, false, 8, false },
	{ "avr-freestanding-none", "", true, true, 8, true, 1, false },
	{ "hexagon-linux-musl", "", false, false, 0, false, 16, true },
};

fn void bitfield_policy() @test
{
	foreach (v : BITFIELD_VECTORS)
	{
		Target t = tgt(v.triple, v.cpu);
		bool ok = t.ignore_non_zero_sized_bitfield_type_alignment() == v.ignore_non_zero
			&& t.ignore_zero_sized_bitfield_type_alignment() == v.ignore_zero
			&& t.min_zero_width_bitfield_alignment() == v.min_zero_width
			&& t.unnamed_field_affects_alignment() == v.unnamed_affects
			&& t.default_alignment() == v.default_align
			&& t.pack_all_enums() == v.pack_enums;
		if (!ok)
		{
			io::eprintfn("%s (%s): %s %s %d %s %d %s", v.triple, v.cpu,
				t.ignore_non_zero_sized_bitfield_type_alignment(), t.ignore_zero_sized_bitfield_type_alignment(),
				t.min_zero_width_bitfield_alignment(), t.unnamed_field_affects_alignment(),
				t.default_alignment(), t.pack_all_enums());
			unreachable("bitfield vector mismatch");
		}
	}
}

// ---------------------------------------------------------------------------
// Integer type selection, fixtures and the remaining Target.zig queries
// ---------------------------------------------------------------------------

fn void int_types() @test
{
	Target t = tgt("x86_64-linux-gnu");
	assert(t.int_max_type() == LONG && t.int_ptr_type() == LONG && t.int64_type() == LONG && t.int16_type() == SHORT);
	assert(t.sig_atomic_type() == INT && t.is_lp64());
	t = tgt("x86_64-uefi-msvc"); // fixture: uefi intmax_t.c
	assert(t.int_max_type() == LONG_LONG);
	t = tgt("x86_64-windows-msvc");
	assert(t.int_max_type() == LONG_LONG && t.int_ptr_type() == LONG_LONG && t.int64_type() == LONG_LONG);
	assert(t.is_lp64()); // isLP64 only checks int == 32 and pointer == 64 bits
	t = tgt("x86_64-linux-gnux32");
	assert(t.int_max_type() == LONG_LONG && t.int_ptr_type() == INT);
	t = tgt("i386-linux-gnu");
	assert(t.int_max_type() == LONG_LONG && t.int_ptr_type() == INT && t.int64_type() == LONG_LONG);
	t = tgt("i386-openbsd");
	assert(t.int_ptr_type() == LONG);
	t = tgt("x86_64-macos");
	assert(t.int64_type() == LONG_LONG && t.int_max_type() == LONG);
	t = tgt("aarch64-linux-gnu");
	assert(t.int_max_type() == LONG && t.int64_type() == LONG && t.int_ptr_type() == LONG);
	t = tgt("aarch64-windows-msvc");
	assert(t.int_max_type() == LONG_LONG && t.int_ptr_type() == LONG_LONG && t.int64_type() == LONG_LONG);
	t = tgt("aarch64-openbsd");
	assert(t.int_max_type() == LONG_LONG);
	t = tgt("riscv32-linux-gnu");
	assert(t.int_ptr_type() == INT && t.int64_type() == LONG_LONG && !t.has_int128());
	t = tgt("powerpc-linux-gnu");
	assert(t.int_ptr_type() == INT);
	t = tgt("powerpc-freestanding-none");
	assert(t.int_ptr_type() == LONG);
	t = tgt("sparc-netbsd");
	assert(t.int_ptr_type() == LONG);
	t = tgt("avr-freestanding-none"); // fixture: avr sizeof long.c
	assert(t.int16_type() == INT && t.int_ptr_type() == INT && t.sig_atomic_type() == SCHAR);
	check(t.int_kind_bits(INT), 16);
	check(t.int_kind_bits(LONG), 32);
	check(t.int_kind_bits(LONG_LONG), 64);
	t = tgt("msp430-other-none"); // fixture: msp430 builtin types.c
	assert(t.sig_atomic_type() == LONG && t.wchar_type() == UINT && t.c_char_signedness() == UNSIGNED);
	check(t.int_kind_bits(t.wchar_type()), 16);
	t = tgt("wasm32-wasi");
	assert(t.sig_atomic_type() == LONG && t.has_int128());
	t = tgt("x86_64-haiku");
	assert(t.int_ptr_type() == LONG);
	t = tgt("xcore-freestanding");
	assert(t.wchar_type() == UCHAR);
	t = tgt("x86_64-ps4");
	assert(t.wchar_type() == USHORT && t.is_ps());
}

fn void float_types() @test
{
	Target t = tgt("x86_64-linux-gnu");
	assert(t.has_float80_type() && t.has_float128() && t.has_int128());
	t = tgt("x86_64-windows-msvc");
	assert(!t.has_float128());
	t = tgt("aarch64-macos");
	assert(!t.has_float128() && !t.has_float80_type() && t.has_aarch64_acle_types());
	t = tgt("aarch64-linux-gnu");
	assert(t.has_float128());
	t = tgt("riscv64-linux-gnu");
	assert(t.has_float128());
	t = tgt("arm-linux-gnueabi");
	assert(!t.has_float128() && t.has_half_precision_float_abi());
	assert(target::fp_semantics_for_type(FLOAT, &t) == IEEE_SINGLE);
	assert(target::fp_semantics_for_type(DOUBLE, &t) == IEEE_DOUBLE);
	// float header netbsd 6.99.26.c: FLT_EVAL_METHOD 1; x86-64-linux: 0
	t = tgt("x86-netbsd.6.99.26-gnu");
	assert(t.default_fp_eval_method() == DOUBLE);
	t = tgt("x86-netbsd.6.99.27-gnu");
	assert(t.default_fp_eval_method() == SOURCE);
	t = tgt("x86_64-linux-gnu");
	assert(t.default_fp_eval_method() == SOURCE);
	t = tgt("aarch64-linux-gnu");
	assert(t.default_fp_eval_method() == SOURCE);
}

fn void pic_pie() @test
{
	Target t = tgt("x86_64-linux-gnu");
	assert(t.is_pie_default() == YES && t.is_pic_default() == NO && t.is_pic_default_forced() == NO);
	t = tgt("ve-linux");
	assert(t.is_pie_default() == NO);
	t = tgt("x86_64-linux-ohos");
	assert(t.is_pie_default() == YES && t.is_pic_default() == NO);
	t = tgt("mips64-linux-gnuabi64");
	assert(t.is_pic_default() == YES);
	t = tgt("x86_64-windows-msvc");
	assert(t.is_pie_default() == DEPENDS_ON_LINKER && t.is_pic_default() == DEPENDS_ON_LINKER && t.is_pic_default_forced() == DEPENDS_ON_LINKER);
	t = tgt("x86_64-windows-gnu");
	assert(t.is_pie_default() == NO && t.is_pic_default() == YES && t.is_pic_default_forced() == YES);
	t = tgt("x86-windows-gnu");
	assert(t.is_pic_default() == NO);
	t = tgt("aarch64-macos");
	assert(t.is_pie_default() == NO && t.is_pic_default() == YES && t.is_pic_default_forced() == YES);
	t = tgt("arm-ios");
	assert(t.is_pic_default_forced() == NO);
	t = tgt("x86_64-openbsd");
	assert(t.is_pie_default() == YES && t.is_pic_default() == NO);
	t = tgt("amdgcn-amdhsa");
	assert(t.is_pic_default_forced() == YES && t.is_pic_default() == YES);
	t = tgt("msp430-freestanding");
	assert(t.is_pic_default_forced() == YES);
	t = tgt("hexagon-freestanding-musl");
	assert(t.is_pie_default() == YES);
	t = tgt("hexagon-freestanding");
	assert(t.is_pie_default() == NO);
}

fn void dynamic_linker_and_ld() @test
{
	Target t = tgt("x86_64-linux-gnu"); // fixture: Toolchain/Linux.zig test
	test::eq(t.standard_dynamic_linker_path(), "/lib64/ld-linux-x86-64.so.2");
	test::eq(t.ld_emulation_option(), "elf_x86_64");
	t = tgt("x86_64-linux-gnux32");
	test::eq(t.standard_dynamic_linker_path(), "/libx32/ld-linux-x32.so.2");
	test::eq(t.ld_emulation_option(), "elf32_x86_64");
	t = tgt("aarch64-linux-musl");
	test::eq(t.standard_dynamic_linker_path(), "/lib/ld-musl-aarch64.so.1");
	t = tgt("arm-linux-gnueabihf");
	test::eq(t.standard_dynamic_linker_path(), "/lib/ld-linux-armhf.so.3");
	test::eq(t.ld_emulation_option(), "armelf_linux_eabi");
	test::eq(t.ld_emulation_option(true, BIG), "armelfb_linux_eabi");
	t = tgt("aarch64-linux-android");
	test::eq(t.standard_dynamic_linker_path(), "/system/bin/linker64");
	t = tgt("riscv64-linux-gnu");
	test::eq(t.standard_dynamic_linker_path(), "/lib/ld-linux-riscv64-lp64d.so.1");
	t = tgt("x86_64-macos");
	test::eq(t.standard_dynamic_linker_path(), "/usr/lib/dyld");
	t = tgt("x86_64-windows-msvc");
	test::eq(t.standard_dynamic_linker_path(), "");
	test::eq(t.ld_emulation_option(), "elf_x86_64"); // arch-only, as in Zig
	t = tgt("wasm32-wasi");
	test::eq(t.ld_emulation_option(), "");
	t = tgt("mips64el-linux-gnuabin32");
	test::eq(t.ld_emulation_option(), "elf32ltsmipn32");
	t = tgt("powerpc-linux-gnu");
	test::eq(t.ld_emulation_option(), "elf32ppclinux");
}

fn void arch_variants() @test
{
	Target t = tgt("x86_64-linux-gnu");
	assert(t.get_32bit_arch_variant()!!.cpu.arch == X86);
	assert(t.get_64bit_arch_variant()!!.cpu.arch == X86_64);
	t = tgt("thumb-linux-gnueabi");
	assert(t.get_64bit_arch_variant()!!.cpu.arch == AARCH64);
	t = tgt("avr-freestanding");
	assert(@catch(t.get_32bit_arch_variant()));
	assert(@catch(t.get_64bit_arch_variant()));
	t = tgt("riscv64be-linux");
	assert(t.get_32bit_arch_variant()!!.cpu.arch == RISCV32BE);
}

fn void cpu_models() @test
{
	// cpuModelForTargetQuadruple
	assert(tgt("arm-linux-gnueabi").cpu.model == ARM7TDMI);
	assert(tgt("arm-linux-gnueabihf").cpu.model == ARM1176JZF_S);
	assert(tgt("arm-windows-msvc").cpu.model == CORTEX_A9);
	assert(tgt("arm-netbsd-eabi").cpu.model == ARM926EJ_S);
	assert(tgt("arm-netbsd").cpu.model == STRONGARM); // no ABI: Zig passes the host ABI (gnu here), not the OS default
	assert(tgt("arm-netbsd-musl").cpu.model == STRONGARM);
	assert(tgt("arm-openbsd").cpu.model == CORTEX_A8);
	assert(tgt("arm-fuchsia").cpu.model == ARM_CORTEX_A53);
	assert(tgt("armv6-freebsd").cpu.model == ARM1176JZF_S);
	assert(tgt("armv7-netbsd").cpu.model == CORTEX_A8);
	assert(tgt("armv7a-windows").cpu.model == CORTEX_A9);
	assert(tgt("armv5te-linux-gnueabi").cpu.model == ARM1022E);
	assert(tgt("armv8a-linux-gnueabi").cpu.model == EMPTY);
	assert(tgt("mips-linux-gnu").cpu.model == MIPS32R2);
	assert(tgt("mips64-img-linux-gnuabi64").cpu.model == MIPS64R6);
	assert(tgt("mipsisa32r6-linux-gnu").cpu.model == MIPS32R6);
	assert(tgt("mips64-openbsd").cpu.model == MIPS3);
	assert(tgt("mips-freebsd").cpu.model == MIPS2);
	// Model.baseline
	assert(tgt("aarch64-linux-gnu").cpu.model == AARCH64_GENERIC);
	assert(tgt("aarch64-ios").cpu.model == APPLE_A7);
	assert(tgt("riscv64-linux-gnu").cpu.model == BASELINE_RV64);
	assert(tgt("sparc-linux-gnu").cpu.model == SPARC_V9);
	assert(tgt("wasm32-wasi").cpu.model == WASM_LIME1);
	assert(tgt("x86_64-ps5").cpu.model == ZNVER2);
	// mips helpers
	Target t = tgt("mips-linux-gnu");
	assert(t.mips_abi() == O32 && t.default_mips_fp_mode() == FPXX);
	check(t.mips_isa_rev(), 2);
	t = tgt("mipsisa32r6-linux-gnu");
	assert(t.default_mips_fp_mode() == FP64);
	check(t.mips_isa_rev(), 6);
	t = tgt("mips64-linux-gnuabin32");
	assert(t.mips_abi() == N32 && t.default_mips_fp_mode() == FP64);
	t = tgt("mips-linux-gnu", "mips1");
	assert(t.default_mips_fp_mode() == FP32);
	check(t.mips_isa_rev(), 0);
	t = tgt("mips64-openbsd");
	assert(t.mips_abi() == N64);
	check(t.mips_isa_rev(), 0);
	// ppcElfVersion; fixture: ppc elf v2.c
	check(tgt("powerpc64-freebsd.13.1-gnu").ppc_elf_version(), 2);
	check(tgt("powerpc64-freebsd.12.0-gnu").ppc_elf_version(), 1);
	check(tgt("powerpc64-linux-gnu").ppc_elf_version(), 1);
	check(tgt("powerpc64-linux-musl").ppc_elf_version(), 2);
	check(tgt("powerpc64le-linux-gnu").ppc_elf_version(), 2);
	check(tgt("powerpc-linux-gnu").ppc_elf_version(), 1);
}

fn void arm_queries() @test
{
	// fixture: arm-acle-6.4 armv7-m.c (M profile, IDIV, no DSP, LDREX 0x7)
	Target t = tgt("armv7m-linux-gnueabi");
	assert(t.cpu.arch == THUMB && t.cpu.model == CORTEX_M3);
	ArmVersion v = t.arm_version()!!;
	check(v.version, 7);
	test::eq(v.string, "7M");
	assert(t.cpu.has(ARM_MCLASS) && t.cpu.has(ARM_HWDIV) && t.cpu.has(ARM_THUMB2) && !t.arm_has_dsp());
	LangOpts lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	assert(lo.has_arm_ldrex);
	check((char)lo.arm_ldrex, 0x7);
	// fixture: arm-acle-6.4 armv7-a.c (A profile, DSP, LDREX 0xf)
	t = tgt("armv7a-linux-gnueabi");
	v = t.arm_version()!!;
	test::eq(v.string, "7A");
	assert(t.cpu.has(ARM_ACLASS) && t.arm_has_dsp());
	lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	check((char)lo.arm_ldrex, 0xf);
	// fixture: arm-acle-6.4 armv8-a.c (ARMv8-A, IDIV, LDREX 0xf)
	t = tgt("armv8a-linux-gnueabi");
	v = t.arm_version()!!;
	check(v.version, 8);
	test::eq(v.string, "8A");
	assert(t.cpu.has(ARM_HWDIV) && t.cpu.has(ARM_HWDIV_ARM) && t.arm_has_dsp());
	lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	check((char)lo.arm_ldrex, 0xf);
	// arm7tdmi: v4t -> version 4 -> no LDREX; arm1176jzf-s: v6kz -> all
	t = tgt("arm-linux-gnueabi");
	test::eq(t.arm_version()!!.string, "4T");
	assert(!t.arm_has_dsp());
	lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	assert(lo.has_arm_ldrex);
	check((char)lo.arm_ldrex, 0);
	t = tgt("arm-linux-gnueabihf");
	test::eq(t.arm_version()!!.string, "6KZ");
	assert(t.arm_has_dsp());
	lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	check((char)lo.arm_ldrex, 0xf);
	// v6 M profile: none; plain v6: word only; no version (generic): defaults to v6 rules
	t = tgt("thumbv6m-freestanding-eabi");
	lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	check((char)lo.arm_ldrex, 0);
	t = tgt("arm-linux-gnueabi", "arm1136j_s");
	lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	check((char)lo.arm_ldrex, 0x4);
	t = tgt("arm-linux-gnueabi", "generic");
	assert(@catch(t.arm_version()));
	lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	check((char)lo.arm_ldrex, 0x4);
	// aarch64 ldrex is always full width; AVR has int24
	t = tgt("aarch64-linux-gnu");
	lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	assert(lo.has_arm_ldrex && !lo.has_int24);
	check((char)lo.arm_ldrex, 0xf);
	t = tgt("avr-freestanding-none");
	lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	assert(lo.has_int24 && !lo.has_arm_ldrex);
	t = tgt("x86_64-linux-gnu");
	lo = lang_opts::DEFAULT;
	lo.set_target_options(&t);
	assert(!lo.has_int24 && !lo.has_arm_ldrex);
	// armFloatAbi
	assert(tgt("arm-linux-gnueabi").arm_float_abi() == SOFT);
	assert(tgt("arm-linux-gnueabihf").arm_float_abi() == HARD);
	assert(tgt("arm-linux-androideabi").arm_float_abi() == SOFT);
	assert(tgt("arm-linux-android").arm_float_abi() == SOFT_FP);
	assert(tgt("arm-linux-ohos").arm_float_abi() == SOFT);
	assert(tgt("arm-windows-msvc").arm_float_abi() == HARD);
	assert(tgt("arm-freebsd-eabihf").arm_float_abi() == SOFT);
	assert(tgt("arm-freebsd-gnueabihf").arm_float_abi() == HARD);
	assert(tgt("arm-netbsd-eabihf").arm_float_abi() == HARD);
	assert(tgt("arm-openbsd").arm_float_abi() == SOFT);
	assert(tgt("arm-openbsd-gnueabihf").arm_float_abi() == SOFT_FP);
	assert(tgt("armv7-ios").arm_float_abi() == SOFT_FP);
	assert(tgt("armv8a-ios").arm_float_abi() == SOFT);
	// Defaulted ABI is treated as unknown: Linux defaults to musleabihf but clang sees "none".
	assert(tgt("arm-linux").arm_float_abi() == SOFT);
	assert(tgt("arm-linux-musleabihf").arm_float_abi() == HARD);
}

fn void misc_queries() @test
{
	Target t = tgt("x86_64-linux-gnu");
	check(t.default_function_alignment(), 16);
	check(t.min_function_alignment(), 1);
	assert(!t.is_blocks_supported() && t.has_protected_visibility());
	check(t.null_repr(), 0);
	t = tgt("x86_64-macos.10.5");
	assert(!t.is_blocks_supported() && t.is_tls_supported());
	t = tgt("x86_64-macos.10.6");
	assert(t.is_blocks_supported());
	// Os.isAtLeast is null when the version lies inside (min, max].
	bool has;
	t = tgt("x86_64-macos.10.5");
	t.os.is_at_least(MACOS, { 10, 6, 0 }, &has);
	assert(!has);
	t = tgt("x86_64-macos.10.5...10.5");
	assert(!t.os.is_at_least(MACOS, { 10, 6, 0 }, &has) && has);
	assert(t.os.is_at_least(MACOS, { 10, 4, 0 }, &has) && has);
	t.os.is_at_least(IOS, { 1, 0, 0 }, &has);
	assert(!has);
	t = tgt("x86_64-macos.10.7");
	assert(!t.is_tls_supported() && !t.has_protected_visibility());
	t = tgt("aarch64-ios");
	assert(t.is_blocks_supported() && !t.is_tls_supported());
	t = tgt("thumb-linux-gnueabi");
	assert(!t.is_tls_supported());
	check(t.default_function_alignment(), 4);
	check(t.min_function_alignment(), 2);
	t = tgt("loongarch64-linux-gnu");
	check(t.default_function_alignment(), 32);
	t = tgt("wasm32-wasi");
	assert(!t.has_protected_visibility());
	check(t.default_function_alignment(), 1);
	// systemCompiler
	assert(tgt("aarch64-linux-android").system_compiler() == CLANG);
	assert(tgt("x86_64-freebsd").system_compiler() == CLANG);
	assert(tgt("x86_64-uefi").system_compiler() == MSVC);
	assert(tgt("x86_64-windows-gnu").system_compiler() == GCC);
	assert(tgt("x86_64-windows-msvc").system_compiler() == MSVC);
	assert(tgt("avr-freestanding").system_compiler() == GCC);
	assert(tgt("riscv64-freestanding").system_compiler() == CLANG);
	assert(tgt("hexagon-linux-musl").system_compiler() == CLANG);
	// Windows environment predicates
	t = tgt("x86_64-windows-msvc");
	assert(t.is_known_windows_msvc_environment() && t.is_windows_msvc_environment() && !t.is_mingw());
	t = tgt("x86_64-windows-none");
	assert(!t.is_known_windows_msvc_environment() && t.is_windows_msvc_environment());
	t = tgt("x86_64-windows");
	assert(t.is_mingw() && t.abi == GNU);
	// isOs / isAbi
	t = tgt("x86_64-macos");
	assert(t.is_os("darwin") && t.is_os("ios") && t.is_os("macosx") && !t.is_os("linux") && !t.is_os("bogus"));
	t = tgt("x86_64-linux-gnu");
	assert(t.is_os("linux") && t.is_os("Linux") && !t.is_os("windows"));
	assert(t.is_abi("gnu") && t.is_abi("GNU") && !t.is_abi("musl") && !t.is_abi("macabi") && !t.is_abi("bogus"));
	t = tgt("aarch64-maccatalyst");
	assert(t.is_abi("macabi") && !t.is_abi("none"));
	// Driver "unsupported option" spelling
	char[64] buf;
	test::eq(tgt("x86_64-linux-gnu").arch_os_abi_name(&buf), "x86_64-linux-gnu");
	// toLLVMTriple has no vendor component; OS/arch names that differ from Zig tags
	test::eq(tgt("x86c16-freestanding").to_llvm_triple(&buf), "i386-unknown-unknown");
	test::eq(tgt("x86_16-freestanding").to_llvm_triple(&buf), "i86-unknown-unknown");
	test::eq(tgt("powerpc-ps3").to_llvm_triple(&buf), "powerpc-lv2-unknown");
	// ObjectFormat defaults and file extensions
	test::eq(tgt("x86_64-linux-gnu").ofmt.file_ext(X86_64), ".o");
	test::eq(tgt("x86_64-windows-msvc").ofmt.file_ext(X86_64), ".obj");
	test::eq(tgt("x86_64-plan9").ofmt.file_ext(X86_64), ".6");
	assert(tgt("spirv64-vulkan").ofmt == SPIRV && tgt("wasm32-wasi").ofmt == WASM && tgt("aarch64-ios").ofmt == MACHO);
}

fn void native_target() @test
{
	// The C3 test binary runs on a supported host; native() is that host.
	Host h = target::host()!!;
	Target t = target::native()!!;
	assert(t.cpu.arch == h.arch && t.os.tag == h.os && t.abi == h.abi && !t.abi_is_default);
}

fn void compilation_defaults() @test
{
	// Plan 06 leftover: Compilation carries langopts (Zig `.{}`) and the native target.
	TrackingAllocator ta;
	ta.init(mem);
	defer ta.free();
	Compilation comp;
	comp.init(&ta);
	assert(comp.langopts.emulate == lang_opts::DEFAULT.emulate && comp.langopts.dollars_in_identifiers);
	Target native = target::native()!!;
	assert(comp.target.cpu.arch == native.cpu.arch && comp.target.os.tag == native.os.tag && comp.target.abi == native.abi);
	assert(!comp.has_darwin_target_variant);
	comp.target = tgt("avr-freestanding-none");
	comp.langopts.set_target_options(&comp.target);
	assert(comp.langopts.has_int24);
	comp.free();
	check(ta.allocation_count(), 0);
}
