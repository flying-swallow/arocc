<* Pointer alignment as TypeStore.alignof computes it (pointer size, but 1 on AVR). *>
fn ushort ptr_align(Target* t) => t.cpu.arch == AVR ? 1 : t.ptr_bit_width() / 8;

fn void record_vectors() @test
{
	assert(RECORD_VECTORS.len == 105);
	int unknown_models;
	foreach (v : RECORD_VECTORS)
	{
		// Some repr-c CPU names (rv32gc, rv64gc, armv8a) are not CpuModels here;
		// sizes and alignments do not depend on the model, so use the default.
		Target? parsed = target::parse_triple(v.triple, HOST, v.cpu);
		Target t;
		if (catch f = parsed)
		{
			assert(f == target::UNKNOWN_CPU_MODEL, "%s: %s", v.triple, f);
			unknown_models++;
			t = tgt(v.triple);
		}
		else
		{
			t = parsed;
		}
		ushort[16] got = {
			t.c_type_byte_size(CHAR), t.c_type_alignment(CHAR),
			t.c_type_byte_size(SHORT), t.c_type_alignment(SHORT),
			t.c_type_byte_size(INT), t.c_type_alignment(INT),
			t.c_type_byte_size(LONG), t.c_type_alignment(LONG),
			t.c_type_byte_size(LONGLONG), t.c_type_alignment(LONGLONG),
			t.ptr_bit_width() / 8, ptr_align(&t),
			t.c_type_byte_size(FLOAT), t.c_type_alignment(FLOAT),
			t.c_type_byte_size(DOUBLE), t.c_type_alignment(DOUBLE),
		};
		for (usz i = 0; i < 16; i++)
		{
			if (got[i] != v.values[i])
			{
				io::eprintfn("%s (%s): column %d expected %d got %d", v.triple, v.cpu, i, v.values[i], got[i]);
				unreachable("record vector mismatch");
			}
		}
	}
	check(unknown_models, 17);
}

// ---------------------------------------------------------------------------
// Target.zig unit tests
// ---------------------------------------------------------------------------

fn void parse_arch_name_zig_test() @test
{
	ArchSubArch a = target::parse_arch_name("spirv64v1.6")!!;
	assert(a.arch == SPIRV64 && a.has_sub && a.sub == SPIRV_V16);
	a = target::parse_arch_name("i786")!!;
	assert(a.arch == X86 && !a.has_sub);
	a = target::parse_arch_name("bpf_le")!!;
	assert(a.arch == BPFEL && !a.has_sub);
	a = target::parse_arch_name("armv8eb")!!;
	assert(a.arch == ARMEB && a.has_sub && a.sub == ARM_V8);
}

fn void parse_abi_zig_test() @test
{
	Query q = target::QUERY_DEFAULT;
	target::parse_abi(&q, "gnuabin322.3")!!;
	assert(q.abi == GNUABIN32);
	assert(q.glibc_version.eq({ 2, 3, 0 }));

	target::parse_abi(&q, "gnuabin32.2.3")!!;
	assert(q.abi == GNUABIN32);
	assert(q.glibc_version.eq({ 2, 3, 0 }));

	target::parse_abi(&q, "android17")!!;
	assert(q.abi == ANDROID);
	check(q.android_api_level, 17);

	target::parse_abi(&q, "android.17")!!;
	assert(q.abi == ANDROID);
	check(q.android_api_level, 17);

	assert(@catch(target::parse_abi(&q, "ilp322")) == target::INVALID_ABI_VERSION);
	assert(q.abi == ILP32);

	assert(@catch(target::parse_abi(&q, "ilp32.2")) == target::INVALID_ABI_VERSION);
	assert(q.abi == ILP32);
}

fn void parse_os_zig_test() @test
{
	Query q = target::QUERY_DEFAULT;
	target::parse_os(&q, "3ds2.3")!!;
	assert(q.os_tag == THREEDS);
	assert(q.os_version_min.semver.eq({ 2, 3, 0 }) && !q.os_version_min.is_windows);

	target::parse_os(&q, "3ds.2.3")!!;
	assert(q.os_tag == THREEDS);
	assert(q.os_version_min.semver.eq({ 2, 3, 0 }));

	assert(@catch(target::parse_os(&q, "ps33.3")) == target::INVALID_OS_VERSION);
	assert(q.os_tag == PS3);

	assert(@catch(target::parse_os(&q, "ps3.3.3")) == target::INVALID_OS_VERSION);
	assert(q.os_tag == PS3);

	target::parse_os(&q, "linux6.17")!!;
	assert(q.os_tag == LINUX);
	assert(q.os_version_min.semver.eq({ 6, 17, 0 }));

	target::parse_os(&q, "linux.6.17")!!;
	assert(q.os_tag == LINUX);
	assert(q.os_version_min.semver.eq({ 6, 17, 0 }));

	target::parse_os(&q, "win32win10")!!;
	assert(q.os_tag == WINDOWS);
	assert(q.os_version_min.is_windows && q.os_version_min.windows == target::WIN_WIN10);

	target::parse_os(&q, "win32.win10")!!;
	assert(q.os_tag == WINDOWS);
	assert(q.os_version_min.is_windows && q.os_version_min.windows == target::WIN_WIN10);

	target::parse_os(&q, "ios17")!!;
	assert(q.os_tag == IOS);
	assert(q.os_version_min.semver.eq({ 17, 0, 0 }));

	target::parse_os(&q, "darwin26")!!;
	assert(q.os_tag == MACOS);
	assert(q.os_version_min.semver.eq({ 26, 0, 0 }));
}

fn void alignment_functions_smoke_zig_test() @test
{
	// Zig: .abi = .default(.x86_64, .linux), generic x86_64 CPU, ELF.
	Target t = tgt("x86_64-linux");
	assert(t.abi == target::default_abi(X86_64, LINUX));
	assert(t.is_tls_supported());
	assert(!t.ignore_non_zero_sized_bitfield_type_alignment());
	check(t.min_zero_width_bitfield_alignment(), 0);
	assert(!t.unnamed_field_affects_alignment());
	check(t.default_alignment(), 16);
	assert(!t.pack_all_enums());
	assert(t.system_compiler() == GCC);
}

fn void target_size_align_zig_test() @test
{
	Target t = tgt("x86-linux");
	check(t.c_type_byte_size(LONGLONG), 8);
	check(t.c_type_alignment(LONGLONG), 4);
}

// ---------------------------------------------------------------------------
// Triple parsing
// ---------------------------------------------------------------------------

<* Every --target used by test/cases (all must parse). *>
const String[*] FIXTURE_TRIPLES = {
	"aarch64-linux-gnu", "aarch64-macos", "aarch64-macos-musl", "arm-linux-gnueabi", "arm64-apple-darwin",
	"arm64e-apple-ios12-macabi", "armv7a-linux-gnueabi", "armv7m-linux-gnueabi", "armv8a-linux-gnueabi",
	"avr-freestanding-none", "i386-linux-gnu", "msp430-other-none", "powerpc-freestanding-none",
	"powerpc64-freebsd.13.1-gnu", "powerpc64-linux-gnu", "riscv32-linux-gnu", "riscv64-linux-gnu",
	"riscv64-linux-gnuf32", "riscv64-linux-gnusf", "x86-linux-gnu", "x86-netbsd.6.99.26-gnu", "x86-windows-msvc",
	"x86_64-apple-darwin-simulator", "x86_64-apple-ios", "x86_64-apple-macos", "x86_64-apple-tvos",
	"x86_64-apple-watchos", "x86_64-linux", "x86_64-linux-gnu", "x86_64-macos", "x86_64-pc-linux-gnu",
	"x86_64-uefi-msvc", "x86_64-windows-msvc", "x86_64-windows", "x86_64-freebsd", "aarch64-linux",
	"aarch64-windows-msvc", "aarch64-ios", "aarch64-macos-none", "aarch64-maccatalyst", "aarch64-ios-simulator",
	"aarch64-driverkit", "aarch64-watchos", "aarch64-visionos", "aarch64-tvos", "armv7a", "x86_64-uefi",
};

fn void fixture_triples_parse() @test
{
	foreach (s : FIXTURE_TRIPLES) tgt(s);
}

fn void parse_components() @test
{
	Target t = tgt("x86_64-pc-linux-gnu");
	assert(t.cpu.arch == X86_64 && t.vendor == PC && t.os.tag == LINUX && t.abi == GNU && !t.abi_is_default);
	assert(t.cpu.model == X86_64 && t.ofmt == ELF && t.dynamic_linker.len == 0);

	// Zig's default Linux ABI is musl, and the triple is marked as defaulted.
	t = tgt("x86_64-linux");
	assert(t.abi == MUSL && t.abi_is_default && t.vendor == UNKNOWN);

	// Case-insensitive names, vendor and OS aliases.
	t = tgt("X86_64-Apple-Darwin");
	assert(t.cpu.arch == X86_64 && t.vendor == APPLE && t.os.tag == MACOS && t.abi == NONE && t.ofmt == MACHO);
	assert(t.cpu.model == CORE2);
	t = tgt("i686-win32-gnu");
	assert(t.cpu.arch == X86 && t.os.tag == WINDOWS && t.abi == GNU);
	t = tgt("arm64-xros");
	assert(t.cpu.arch == AARCH64 && t.os.tag == VISIONOS && t.cpu.model == APPLE_M2);
	t = tgt("amd64-macosx10.9");
	assert(t.os.tag == MACOS && t.os.min.eq({ 10, 9, 0 }));

	// "macabi" turns iOS into Mac Catalyst and leaves the ABI defaulted.
	t = tgt("arm64e-apple-ios12-macabi");
	assert(t.cpu.arch == AARCH64 && t.os.tag == MACCATALYST && t.abi == NONE && t.abi_is_default);
	assert(t.os.min.eq({ 12, 0, 0 }));
	assert(t.is_abi("macabi") && !t.is_abi("none"));

	// Versions: OS ranges and glibc / Android API levels.
	t = tgt("x86_64-linux.4.19...6.1-gnu.2.28");
	assert(t.os.min.eq({ 4, 19, 0 }) && t.os.max.eq({ 6, 1, 0 }) && t.os.glibc.eq({ 2, 28, 0 }));
	t = tgt("aarch64-linux-android29");
	check(t.os.android, 29);
	t = tgt("x86_64-windows.win7...win10-msvc");
	check(t.os.win_min, 0x06010000);
	check(t.os.win_max, 0x0A000000);
	t = tgt("x86_64-windows.0x0A000005-msvc");
	check(t.os.win_min, 0x0A000005);

	// "native" components resolve from the explicit host, never implicitly.
	t = tgt("native");
	assert(t.cpu.arch == X86_64 && t.os.tag == LINUX && t.abi == GNU && !t.abi_is_default);
	t = tgt("riscv64-native");
	assert(t.cpu.arch == RISCV64 && t.os.tag == LINUX && t.abi == MUSL && t.abi_is_default);
	Host darwin_host = { AARCH64, MACOS, NONE };
	t = target::parse_triple("native", darwin_host)!!;
	assert(t.vendor == APPLE && t.os.tag == MACOS && t.cpu.model == APPLE_M1);
}

fn void parse_arch_aliases() @test
{
	ArchSubArch a = target::parse_arch_name("thumbv7em")!!;
	assert(a.arch == THUMB && a.sub == ARM_V7EM);
	a = target::parse_arch_name("thumbv7a")!!; // non-M profile: back to ARM
	assert(a.arch == ARM && a.sub == ARM_V7A);
	a = target::parse_arch_name("armv7m")!!; // M profile: Thumb only
	assert(a.arch == THUMB && a.sub == ARM_V7M);
	a = target::parse_arch_name("armebv7m")!!;
	assert(@catch(target::parse_arch_name("armebv7x")) == target::UNKNOWN_ARCH);
	a = target::parse_arch_name("armv7meb")!!;
	assert(a.arch == THUMBEB && a.sub == ARM_V7M);
	a = target::parse_arch_name("aarch64v8.2a")!!;
	assert(a.arch == AARCH64 && a.sub == ARM_V8_2A);
	a = target::parse_arch_name("arm64ec")!!;
	assert(a.arch == AARCH64 && a.sub == AARCH64_ARM64EC);
	a = target::parse_arch_name("mipsisa64r6el")!!;
	assert(a.arch == MIPS64EL && a.sub == MIPS_R6);
	a = target::parse_arch_name("ppc64le")!!;
	assert(a.arch == POWERPC64LE && !a.has_sub);
	a = target::parse_arch_name("powerpcspe")!!;
	assert(a.arch == POWERPC && a.sub == POWERPC_SPE);
	a = target::parse_arch_name("systemz")!!;
	assert(a.arch == S390X);
	a = target::parse_arch_name("bpfeb")!!;
	assert(a.arch == BPFEB);
	a = target::parse_arch_name("bpf")!!; // host endianness (HOST default: little)
	assert(a.arch == BPFEL);
	a = target::parse_arch_name("bpf", { S390X, LINUX, GNU })!!;
	assert(a.arch == BPFEB);
	foreach (arch : Arch::values)
	{
		ArchSubArch p = target::parse_arch_name(arch.name)!!;
		assert(p.arch == arch && !p.has_sub, "%s", arch.name);
	}
	foreach (os : OsTag::values) assert(target::parse_os_name(os.name)!! == os, "%s", os.name);
	foreach (abi : Abi::values) assert(target::parse_abi_name(abi.name)!! == abi, "%s", abi.name);
	check(Arch::len, 62);
	check(OsTag::len, 44);
	check(Abi::len, 29);
}

fn void malformed_triples() @test
{
	assert(parse_fault("foo-linux-gnu", "", "foo") == target::UNKNOWN_ARCH);
	assert(parse_fault("", "", "") == target::UNKNOWN_ARCH);
	assert(parse_fault("-linux-gnu") == target::UNKNOWN_ARCH);
	assert(parse_fault("x86_64x86_64x86_64x86_64x86_64x86_64x86_64x86_64x86_64x86_64x86_64-linux") == target::UNKNOWN_ARCH);
	assert(parse_fault("x86_64-foo-gnu", "", "foo") == target::UNKNOWN_OS);
	assert(parse_fault("x86_64-", "", "") == target::UNKNOWN_OS);
	assert(parse_fault("x86_64-linux-foo", "", "foo") == target::UNKNOWN_ABI);
	assert(parse_fault("x86_64-linux-", "", "") == target::UNKNOWN_ABI);
	assert(parse_fault("x86_64-linux-gnu-extra", "", "x86_64-linux-gnu-extra") == target::UNEXPECTED_EXTRA_FIELD);
	assert(parse_fault("x86_64-pc-linux-gnu-extra") == target::UNEXPECTED_EXTRA_FIELD);
	assert(parse_fault("x86_64-linux.x.y-gnu", "", "x.y") == target::INVALID_OS_VERSION);
	assert(parse_fault("x86_64-linux.1.2.3.4-gnu") == target::INVALID_OS_VERSION);
	assert(parse_fault("x86_64-ps3.1", "", "1") == target::INVALID_OS_VERSION);
	assert(parse_fault("x86_64-windows.win99-msvc", "", "win99") == target::INVALID_OS_VERSION);
	assert(parse_fault("x86_64-linux-gnu.2", "", "2") == target::INVALID_ABI_VERSION);
	assert(parse_fault("x86_64-linux-musl1.2", "", "1.2") == target::INVALID_ABI_VERSION);
	assert(parse_fault("aarch64-linux-android99999999999", "", "99999999999") == target::INVALID_API_VERSION);
	assert(parse_fault("x86_64-linux-gnu", "nosuchcpu", "nosuchcpu") == target::UNKNOWN_CPU_MODEL);
	assert(parse_fault("x86_64-linux-gnu", "cortex_a8", "cortex_a8") == target::UNKNOWN_CPU_MODEL);
	assert(parse_fault("x86_64-linux-gnu", "x86_64+nosuch", "nosuch") == target::UNKNOWN_CPU_FEATURE);
	assert(parse_fault("x86_64-linux-gnu", "x86_64+v7a", "v7a") == target::UNKNOWN_CPU_FEATURE);
	// A version on an OS without version ranges, and an unknown vendor-looking OS.
	assert(parse_fault("x86_64-freestanding1-none", "", "1") == target::INVALID_OS_VERSION);
	assert(parse_fault("x86_64-unknown-gnu") == target::UNKNOWN_OS);
}

fn void android_api_text() @test
{
	// "android.x": version text "x" is not a number.
	assert(parse_fault("aarch64-linux-android.x", "", "x") == target::INVALID_API_VERSION);
}

fn void cpu_flags() @test
{
	Target t = tgt("x86_64-linux-gnu", "x86_64+avx2");
	assert(t.cpu.has(X86_AVX2) && t.cpu.has(X86_AVX) && t.cpu.has(X86_SSE4_2) && t.cpu.has(X86_SSE));
	t = tgt("x86_64-linux-gnu", "x86_64-sse2");
	assert(!t.cpu.has(X86_SSE2) && t.cpu.has(X86_SSE));
	t = tgt("x86_64-linux-gnu", "baseline");
	assert(t.cpu.model == X86_64);
	t = tgt("x86-linux-gnu", "i386");
	assert(t.cpu.model == I386 && !t.cpu.has(X86_SSE));
	assert(t.default_fp_eval_method() == EXTENDED);
	assert(target::half_precision_type(&t) == FPSemantics.NONE);
	t = tgt("x86-linux-gnu");
	assert(t.cpu.model == PENTIUM4 && t.cpu.has(X86_SSE2));
	assert(t.default_fp_eval_method() == SOURCE);
	assert(target::half_precision_type(&t) == IEEE_HALF);
	// -mcpu with a subarch adds the subarch feature.
	t = tgt("armv7a-linux-gnueabi", "arm7tdmi");
	assert(t.cpu.model == ARM7TDMI && t.cpu.has(ARM_V7A) && t.cpu.has(ARM_HAS_V7));
	t = tgt("riscv64-linux-gnu", "generic_rv64+c");
	assert(t.cpu.has(RISCV_C) && t.cpu.has(RISCV_ZCA) && !t.cpu.has(RISCV_D));
	check(t.min_function_alignment(), 2);
	t = tgt("riscv64-linux-gnu", "generic_rv64");
	check(t.min_function_alignment(), 4);
}

// ---------------------------------------------------------------------------
// Per-platform ABI matrix
// ---------------------------------------------------------------------------

struct AbiVector
{
	String triple;
	ushort ptr_bits;
	ushort long_bits;
	ushort ld_bits;
	ushort ld_size;
	ushort ld_align;
	ushort ll_align;
	ushort double_align;
	CIntKind wchar;
	Signedness char_sign;
	Endian endian;
	FPSemantics ld_sem;
	String llvm;
}

const AbiVector[*] ABI_VECTORS = {
	// Linux x86 / x86_64
	{ "x86_64-linux-gnu", 64, 64, 80, 16, 16, 8, 8, INT, SIGNED, LITTLE, X87_EXTENDED_DOUBLE, "x86_64-linux-gnu" },
	{ "x86_64-linux-gnux32", 32, 32, 80, 16, 16, 8, 8, INT, SIGNED, LITTLE, X87_EXTENDED_DOUBLE, "x86_64-linux-gnux32" },
	{ "i386-linux-gnu", 32, 32, 80, 12, 4, 4, 4, INT, SIGNED, LITTLE, X87_EXTENDED_DOUBLE, "i386-linux-gnu" },
	{ "i686-linux-android", 32, 32, 64, 8, 4, 4, 4, INT, SIGNED, LITTLE, IEEE_DOUBLE, "i386-linux-android" },
	// ARM / AArch64
	{ "arm-linux-gnueabihf", 32, 32, 64, 8, 8, 8, 8, UINT, UNSIGNED, LITTLE, IEEE_DOUBLE, "arm-linux-gnueabihf" },
	{ "armeb-linux-gnueabi", 32, 32, 64, 8, 8, 8, 8, UINT, UNSIGNED, BIG, IEEE_DOUBLE, "armeb-linux-gnueabi" },
	{ "thumbv7em-freestanding-eabihf", 32, 32, 64, 8, 8, 8, 8, UINT, UNSIGNED, LITTLE, IEEE_DOUBLE, "thumb-unknown-eabihf" },
	{ "aarch64-linux-gnu", 64, 64, 128, 16, 16, 8, 8, UINT, UNSIGNED, LITTLE, IEEE_QUAD, "aarch64-linux-gnu" },
	{ "aarch64_be-linux-gnu", 64, 64, 128, 16, 16, 8, 8, UINT, UNSIGNED, BIG, IEEE_QUAD, "aarch64_be-linux-gnu" },
	{ "aarch64-linux-ilp32", 32, 32, 128, 16, 16, 8, 8, UINT, UNSIGNED, LITTLE, IEEE_QUAD, "aarch64_32-linux-unknown" },
	// Windows MSVC / MinGW
	{ "x86_64-windows-msvc", 64, 32, 64, 8, 8, 8, 8, USHORT, SIGNED, LITTLE, IEEE_DOUBLE, "x86_64-windows-msvc" },
	{ "x86_64-windows-gnu", 64, 32, 80, 16, 16, 8, 8, USHORT, SIGNED, LITTLE, X87_EXTENDED_DOUBLE, "x86_64-windows-gnu" },
	{ "x86-windows-msvc", 32, 32, 64, 8, 8, 8, 8, USHORT, SIGNED, LITTLE, IEEE_DOUBLE, "i386-windows-msvc" },
	{ "x86-windows-gnu", 32, 32, 80, 12, 4, 8, 8, USHORT, SIGNED, LITTLE, X87_EXTENDED_DOUBLE, "i386-windows-gnu" },
	{ "aarch64-windows-msvc", 64, 32, 64, 8, 8, 8, 8, USHORT, SIGNED, LITTLE, IEEE_DOUBLE, "aarch64-windows-msvc" },
	{ "x86_64-uefi", 64, 32, 64, 8, 8, 8, 8, USHORT, SIGNED, LITTLE, IEEE_DOUBLE, "x86_64-windows-msvc" },
	// Darwin
	{ "aarch64-macos.14.2", 64, 64, 64, 8, 8, 8, 8, INT, SIGNED, LITTLE, IEEE_DOUBLE, "aarch64-macosx14.2.0-unknown" },
	{ "x86_64-apple-macos.11.0", 64, 64, 80, 16, 16, 8, 8, INT, SIGNED, LITTLE, X87_EXTENDED_DOUBLE, "x86_64-macosx11.0.0-unknown" },
	{ "arm64-apple-ios17", 64, 64, 64, 8, 8, 8, 8, INT, SIGNED, LITTLE, IEEE_DOUBLE, "aarch64-ios17.0.0-unknown" },
	{ "x86_64-apple-ios17-simulator", 64, 64, 80, 16, 16, 8, 8, INT, SIGNED, LITTLE, X87_EXTENDED_DOUBLE, "x86_64-ios17.0.0-simulator" },
	// wasm
	{ "wasm32-wasi-musl", 32, 32, 128, 16, 16, 8, 8, INT, SIGNED, LITTLE, IEEE_QUAD, "wasm32-wasi-musl" },
	{ "wasm64-freestanding", 64, 64, 128, 16, 16, 8, 8, INT, SIGNED, LITTLE, IEEE_QUAD, "wasm64-unknown-unknown" },
	// RISC-V
	{ "riscv64-linux-gnu", 64, 64, 128, 16, 16, 8, 8, INT, UNSIGNED, LITTLE, IEEE_QUAD, "riscv64-linux-gnu" },
	{ "riscv32-linux-gnu", 32, 32, 128, 16, 16, 8, 8, INT, UNSIGNED, LITTLE, IEEE_QUAD, "riscv32-linux-gnu" },
	// MIPS
	{ "mips-linux-gnu", 32, 32, 64, 8, 8, 8, 8, INT, SIGNED, BIG, IEEE_DOUBLE, "mips-linux-gnu" },
	{ "mipsel-linux-musl", 32, 32, 64, 8, 8, 8, 8, INT, SIGNED, LITTLE, IEEE_DOUBLE, "mipsel-linux-musl" },
