// Plan 12.2 table-gen: tests for generate_def::emit_table.
// Links //tools:generate_def_lib plus the checked-in fixture
// test/c3/data/def_emit_x86.c3, which is the hand-written expected output for
// x86_input() below (layout: tools/builtins_schema.md). Compiling this target
// therefore also proves the emitted layout compiles against
// builtin_properties.c3. Inputs are synthetic; expected bytes are derived by
// hand from the schema (bytewise order: 'Z' < '_' < 'a').
module def_emit_tests;
import std::io, std::collections::list, generate_def, aro::builtin_properties, aro::builtin_defs::x86;

macro check(left, right)
{
	test::eq((long)left, (long)right);
}

fn DefEntry entry(String name, String param_str, Language lang = ALL_LANGUAGES, Header header = NONE,
	Attributes attrs = builtin_properties::ATTRIBUTES_DEFAULT, String features = "")
{
	return { .name = name, .record = { .param_str = param_str, .language = lang, .header = header,
		.attributes = attrs, .features = features }, .line = 1 };
}

<* The input matching test/c3/data/def_emit_x86.c3, in a non-sorted file order. *>
fn DefFile x86_input(bool reversed = false)
{
	DefEntry[6] e = {
		entry("abs", "ii", header: STDLIB, attrs: { .is_const = true, .lib_function_without_prefix = true, .eval_args = true }),
		entry("__builtin_ia32_pause", "v", features: "sse2"),
		entry("_Exit", "vi", header: STDLIB, attrs: { .noreturn = true, .lib_function_without_prefix = true, .eval_args = true }),
		entry("_exit", "vi", ALL_GNU_LANGUAGES, UNISTD, { .noreturn = true, .lib_function_without_prefix = true, .eval_args = true }),
		entry("printf", "ic*.", header: STDIO, attrs: { .format_kind = PRINTF, .lib_function_without_prefix = true, .eval_args = true }),
		entry("Zx", "v", C23_LANG, attrs: {}, features: "(a|b),(c|d)"),
	};
	DefFile file;
	file.init(mem, X86);
	for (int i = 0; i < 6; i++) file.entries.push(e[reversed ? 5 - i : i]);
	return file;
}

fn String emit(DefFile* file, String source)
{
	return generate_def::emit_table(mem, file, source);
}

fn void emits_fixture_bytes() @test
{
	DefFile file = x86_input();
	defer file.free();
	String out = emit(&file, "x86.def");
	defer free(out.ptr);
	String expected = $embed("data/def_emit_x86.c3");
	assert(out == expected, "emitted:\n%s", out);
}

fn void independent_of_input_order() @test
{
	DefFile f1 = x86_input();
	defer f1.free();
	DefFile f2 = x86_input(reversed: true);
	defer f2.free();
	String a = emit(&f1, "x86.def");
	defer free(a.ptr);
	String b = emit(&f2, "x86.def");
	defer free(b.ptr);
	assert(a == b);
}

fn void deterministic_twice() @test
{
	DefFile file = x86_input();
	defer file.free();
	String a = emit(&file, "x86.def");
	defer free(a.ptr);
	String b = emit(&file, "x86.def");
	defer free(b.ptr);
	check(a.len, b.len);
	assert(a == b);
	assert(a.ptr != b.ptr);
}

fn void fixture_compiles_and_matches_schema() @test
{
	assert(x86::GROUP == X86);
	check(x86::COUNT, 6);
	check(x86::NAMES.len, x86::RECORDS.len);
	check(x86::SHORTEST_NAME, 2);
	check(x86::LONGEST_NAME, 20);
	BuiltinTag t = x86::TAG_ABS;
	check(t.index, 4);
	assert(t.group == X86);
	assert(x86::NAMES[t.index] == "abs");
	BuiltinTag p = x86::TAG_PRINTF;
	assert(x86::RECORDS[p.index].attributes.format_kind == PRINTF);
	assert(x86::RECORDS[p.index].header == STDIO);
	BuiltinTag z = x86::TAG_ZX;
	assert(!x86::RECORDS[z.index].attributes.eval_args);
	assert(x86::RECORDS[z.index].features == "(a|b),(c|d)");
	assert(x86::TAG___BUILTIN_IA32_PAUSE == (BuiltinTag){ .group = X86, .index = 2 });
	// The _Exit/_exit pair collides when uppercased, so neither has a constant.
	assert(!$defined(x86::TAG__EXIT));
	switch (t)
	{
		case x86::TAG_PRINTF: unreachable("wrong tag");
		case x86::TAG_ABS: break;
		default: unreachable("wrong tag");
	}
	for (usz i = 1; i < x86::NAMES.len; i++) assert(generate_def::compare_bytes(x86::NAMES[i - 1], x86::NAMES[i]) < 0);
}

fn void empty_group() @test
{
	DefFile file;
	file.init(mem, COMMON);
	defer file.free();
	String out = emit(&file, "common.def");
	defer free(out.ptr);
	String expected = "// Autogenerated by tools/generate_def.c3 from common.def, do not edit.\n"
		"module aro::builtin_defs::common;\n"
		"import aro::builtin_properties;\n"
		"\n"
		"const BuiltinGroup GROUP = COMMON;\n"
		"const ushort COUNT = 0;\n"
		"const usz SHORTEST_NAME = 0;\n"
		"const usz LONGEST_NAME = 0;\n"
		"\n"
		"const String[] NAMES = {\n"
		"};\n"
		"\n"
		"const BuiltinRecord[] RECORDS = {\n"
		"};\n";
	assert(out == expected, "emitted:\n%s", out);
}

fn void collisions_only() @test
{
	// Mirrors the ve pairs (source: src/aro/Builtins/ve.def) plus a triple.
	DefFile file;
	file.init(mem, VE);
	defer file.free();
	file.entries.push(entry("__builtin_ve_vl_andm_mmm", "V8ULiV8ULiV8ULi"));
	file.entries.push(entry("__builtin_ve_vl_andm_MMM", "V16ULiV16ULiV16ULi"));
	file.entries.push(entry("aB", "v"));
	file.entries.push(entry("Ab", "v"));
	file.entries.push(entry("ab", "v"));
	String out = emit(&file, "ve.def");
	defer free(out.ptr);
	String expected = "// Autogenerated by tools/generate_def.c3 from ve.def, do not edit.\n"
		"module aro::builtin_defs::ve;\n"
		"import aro::builtin_properties;\n"
		"\n"
		"const BuiltinGroup GROUP = VE;\n"
		"const ushort COUNT = 5;\n"
		"const usz SHORTEST_NAME = 2;\n"
		"const usz LONGEST_NAME = 24;\n"
		"\n"
		"const String[] NAMES = {\n"
		"\t\"Ab\",\n"
		"\t\"__builtin_ve_vl_andm_MMM\",\n"
		"\t\"__builtin_ve_vl_andm_mmm\",\n"
		"\t\"aB\",\n"
		"\t\"ab\",\n"
		"};\n"
		"\n"
		"const BuiltinRecord[] RECORDS = {\n"
		"\t{ \"v\", ALL_LANGUAGES, NONE, (Attributes)0x10000, \"\" },\n"
		"\t{ \"V16ULiV16ULiV16ULi\", ALL_LANGUAGES, NONE, (Attributes)0x10000, \"\" },\n"
		"\t{ \"V8ULiV8ULiV8ULi\", ALL_LANGUAGES, NONE, (Attributes)0x10000, \"\" },\n"
		"\t{ \"v\", ALL_LANGUAGES, NONE, (Attributes)0x10000, \"\" },\n"
		"\t{ \"v\", ALL_LANGUAGES, NONE, (Attributes)0x10000, \"\" },\n"
		"};\n";
	assert(out == expected, "emitted:\n%s", out);
}

fn void collision_beside_unique_names() @test
{
	DefFile file;
	file.init(mem, COMMON);
	defer file.free();
	file.entries.push(entry("_exit", "vi"));
	file.entries.push(entry("__builtin_va_start", "vA."));
	file.entries.push(entry("_Exit", "vi"));
	file.entries.push(entry("_exitx", "vi"));
	String out = emit(&file, "common.def");
	defer free(out.ptr);
	String tail = "};\n\n"
		"const BuiltinTag TAG___BUILTIN_VA_START = { .group = COMMON, .index = 1 };\n"
		"const BuiltinTag TAG__EXITX = { .group = COMMON, .index = 3 };\n";
	assert(out.ends_with(tail), "emitted:\n%s", out);
	assert(!out.contains("TAG__EXIT "));
}

fn void attribute_literals() @test
{
	Attributes all = { .noreturn = true, .pure = true, .is_const = true, .custom_typecheck = true,
		.allow_type_mismatch = true, .lib_function_with_builtin_prefix = true,
		.lib_function_without_prefix = true, .returns_twice = true, .format_kind = VSCANF,
		.format_string_position = 31, .eval_args = true, .const_without_errno_and_fp_exceptions = true,
		.const_without_fp_exceptions = true, .const_evaluable = true };
	DefFile file;
	file.init(mem, ARM);
	defer file.free();
	file.entries.push(entry("b", "v", ALL_MS_LANGUAGES, ARM_ACLE, all, "v8a"));
	file.entries.push(entry("a", "v", GNU_LANG, BLOCKS, { .format_string_position = 1 }));
	String out = emit(&file, "arm.def");
	defer free(out.ptr);
	assert(out.contains("\t{ \"v\", GNU_LANG, BLOCKS, (Attributes)0x00800, \"\" },\n\t{ \"v\", ALL_MS_LANGUAGES, ARM_ACLE, (Attributes)0xffcff, \"v8a\" },\n"), "emitted:\n%s", out);
}
