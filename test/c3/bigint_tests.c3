// Tests for aro::bigint (src/c3/bigint.c3), the port of Zig std.math.big.int.
//
// Sources of expected values:
// - VALUES / VECTORS (bottom of this file, between the GENERATED markers): from
//   Zig 0.17.0 std.math.big.int, produced by test/migration/bigint_vectors.zig run
//   with the Zig 0.17.0 binary at /home/user/tools/zig/ziglang/zig. That generator is
//   development-only; no target here depends on Zig. The pinned Zig 0.18-dev was not
//   available, so parity is claimed only with 0.17.0's std.math.big.int.
//   Covered: add/sub/mul, divTrunc/divFloor (q and r, all sign combinations),
//   bitAnd/bitOr/bitXor, addWrap/subWrap overflow flags, Value.mul-style mul+fits+
//   truncate (cross-checked by the generator against Mutable.mulWrap), truncate,
//   saturate, bitNotWrap, fitsInTwosComp, setTwosCompIntLimit, bitCountTwosComp /
//   bitCountAbs, shiftLeft/shiftRight at limb boundaries (0, 1, 63, 64, 65, 127, 128,
//   129, 200, 300), toString in bases 2/3/7/8/10/16/32/36 (lower and upper case),
//   toInt(u64/i64/u32/i32) and calcSetStringLimbCount, over values up to 264 bits,
//   signed minima (i8/i64/i128) and -(2^256 - 1).
// - Hand-written tests below: mathematical identities (q*b + r == a with |r| < |b|
//   over pseudo-random limb patterns, set_string/to_string round trips, octal and
//   base-32 regrouped from base-2 output), _BitInt(65535)-sized (1024-limb) values,
//   and a few values derived by reading int.zig (marked "source-derived").
module bigint_tests;
import aro::bigint, aro::lang_opts;
import std::io, std::core::mem::allocators;

struct Vec
{
	String op;
	long a;
	long b;
	char sign;
	usz bits;
	String r;
	String r2;
	bool flag;
}

const sz CAP = 64;
const long LONG_MIN = -9223372036854775807 - 1;
const long LONG_MAX = 9223372036854775807;
const ulong ULONG_MAX = 0xFFFF_FFFF_FFFF_FFFF;
const int INT_MIN = -2147483647 - 1;

int failures;

macro check(left, right)
{
	test::eq((long)left, (long)right);
}

fn BigIntConst parse_base(Limb[] storage, char base, String text)
{
	BigIntMutable m = { .limbs = storage, .len = 1, .positive = true };
	m.set_string(base, text, storage[:0])!!;
	return m.to_const();
}

fn BigIntConst parse(Limb[] storage, String hex) => parse_base(storage, 16, hex);

fn Signedness sg(char s) => s == 0 ? SIGNED : UNSIGNED;

fn bool is_normalized(BigIntConst c)
{
	if (c.limbs.len == 0) return false;
	if (c.limbs.len > 1 && c.limbs[c.limbs.len - 1] == 0) return false;
	if (c.limbs.len == 1 && c.limbs[0] == 0 && !c.positive) return false;
	return true;
}

fn String show(BigIntConst c)
{
	if (!is_normalized(c)) return "<not normalized>";
	return c.to_string_alloc(tmem, 16, false);
}

<* Decimal text -> two's-complement bit pattern (handles i64.min and u64.max). *>
fn ulong parse_dec(String s)
{
	bool neg = s.len > 0 && s[0] == '-';
	ulong m = 0;
	for (sz i = neg ? 1 : 0; i < s.len; i++) m = m * 10 + (ulong)(s[i] - '0');
	return neg ? 0 - m : m;
}

fn void fail(Vec v, String what, String got, String want)
{
	failures++;
	if (failures <= 40)
	{
		io::eprintfn("FAIL %s a=%d b=%d sign=%d bits=%d [%s]: got %s want %s", v.op, v.a, v.b, v.sign, v.bits, what, got, want);
	}
}

fn void expect(Vec v, String what, BigIntConst got, BigIntConst want)
{
	if (is_normalized(got) && got.eql(want)) return;
	fail(v, what, show(got), show(want));
}

fn void expect_flag(Vec v, String what, bool got, bool want)
{
	if (got == want) return;
	fail(v, what, got ? "true" : "false", want ? "true" : "false");
}

fn void binop(String op, BigIntMutable* r, BigIntConst a, BigIntConst b, Limb[] scratch)
{
	switch (op)
	{
		case "add": r.add(a, b);
		case "sub": r.sub(a, b);
		case "mul": r.mul(a, b, scratch);
		case "and": r.bit_and(a, b);
		case "or": r.bit_or(a, b);
		case "xor": r.bit_xor(a, b);
		default: unreachable("unknown binop");
	}
}

fn bool wrapop(String op, BigIntMutable* r, BigIntConst a, BigIntConst b, Signedness s, usz bits, Limb[] scratch)
{
	switch (op)
	{
		case "addw": return r.add_wrap(a, b, s, bits);
		case "subw": return r.sub_wrap(a, b, s, bits);
		case "mulw": return r.mul_wrap(a, b, s, bits, scratch);
		default: unreachable("unknown wrap op");
	}
}

fn void unaryop(String op, BigIntMutable* r, BigIntConst a, Signedness s, usz bits, long b)
{
	switch (op)
	{
		case "trunc": r.truncate(a, s, bits);
		case "sat": r.saturate(a, s, bits);
		case "not": r.bit_not_wrap(a, s, bits);
		case "shl": r.shift_left(a, (usz)b);
		case "shr": r.shift_right(a, (usz)b);
		default: unreachable("unknown unary op");
	}
}

fn void run_vector(Vec v)
{
	Limb[CAP] abuf;
	Limb[CAP] bbuf;
	Limb[CAP] ebuf;
	Limb[CAP] e2buf;
	Limb[CAP] rbuf;
	Limb[CAP] r2buf;
	Limb[CAP] r3buf;
	Limb[256] scratch;
	String op = v.op;
	Signedness s = sg(v.sign);
	BigIntMutable r = { .limbs = rbuf[..], .len = 1, .positive = true };
	switch (op)
	{
		case "sslc":
			sz ours = bigint::calc_set_string_limb_count((char)v.a, (sz)v.b);
			if (ours < (sz)parse_dec(v.r)) fail(v, "calc_set_string_limb_count below Zig's", "", v.r);
			return;
		case "limit":
			r.set_twos_comp_int_limit(v.a == 0 ? MIN : MAX, s, v.bits);
			expect(v, "limit", r.to_const(), parse(ebuf[..], v.r));
			return;
		default:
			break;
	}
	BigIntConst a = parse(abuf[..], VALUES[v.a]);
	switch (op)
	{
		case "add":
		case "sub":
		case "mul":
		case "and":
		case "or":
		case "xor":
			BigIntConst b = parse(bbuf[..], VALUES[v.b]);
			BigIntConst want = parse(ebuf[..], v.r);
			binop(op, &r, a, b, scratch[..]);
			expect(v, "plain", r.to_const(), want);
			BigIntMutable ra = a.to_mutable(r2buf[..]);
			binop(op, &ra, ra.to_const(), b, scratch[..]);
			expect(v, "r aliases a", ra.to_const(), want);
			BigIntMutable rb = b.to_mutable(r3buf[..]);
			binop(op, &rb, a, rb.to_const(), scratch[..]);
			expect(v, "r aliases b", rb.to_const(), want);
		case "divt":
		case "divf":
			BigIntConst b = parse(bbuf[..], VALUES[v.b]);
			BigIntConst want_q = parse(ebuf[..], v.r);
			BigIntConst want_r = parse(e2buf[..], v.r2);
			bool trunc = op == "divt";
			BigIntMutable q = { .limbs = rbuf[..], .len = 1, .positive = true };
			BigIntMutable rm = { .limbs = r2buf[..], .len = 1, .positive = true };
			if (trunc)
			{
				bigint::div_trunc(&q, &rm, a, b, scratch[..]);
			}
			else
			{
				bigint::div_floor(&q, &rm, a, b, scratch[..]);
			}
			expect(v, "q", q.to_const(), want_q);
			expect(v, "r", rm.to_const(), want_r);
			// q aliases a
			BigIntMutable qa = a.to_mutable(r3buf[..]);
			if (trunc)
			{
				bigint::div_trunc(&qa, &rm, qa.to_const(), b, scratch[..]);
			}
			else
			{
				bigint::div_floor(&qa, &rm, qa.to_const(), b, scratch[..]);
			}
			expect(v, "q aliases a: q", qa.to_const(), want_q);
			expect(v, "q aliases a: r", rm.to_const(), want_r);
			// q aliases b
			BigIntMutable qb = b.to_mutable(r3buf[..]);
			if (trunc)
			{
				bigint::div_trunc(&qb, &rm, a, qb.to_const(), scratch[..]);
			}
			else
			{
				bigint::div_floor(&qb, &rm, a, qb.to_const(), scratch[..]);
			}
			expect(v, "q aliases b: q", qb.to_const(), want_q);
			expect(v, "q aliases b: r", rm.to_const(), want_r);
			// allocating rem / mod
			BigIntMutable rr = { .limbs = r2buf[..], .len = 1, .positive = true };
			if (trunc)
			{
				rr.rem(mem, a, b);
			}
			else
			{
				rr.mod(mem, a, b);
			}
			expect(v, trunc ? "rem" : "mod", rr.to_const(), want_r);
		case "addw":
		case "subw":
		case "mulw":
			BigIntConst b = parse(bbuf[..], VALUES[v.b]);
			BigIntConst want = parse(ebuf[..], v.r);
			bool ov = wrapop(op, &r, a, b, s, v.bits, scratch[..]);
			expect(v, "plain", r.to_const(), want);
			expect_flag(v, "overflow", ov, v.flag);
			BigIntMutable ra = a.to_mutable(r2buf[..]);
			ov = wrapop(op, &ra, ra.to_const(), b, s, v.bits, scratch[..]);
			expect(v, "r aliases a", ra.to_const(), want);
			expect_flag(v, "overflow (r aliases a)", ov, v.flag);
			BigIntMutable rb = b.to_mutable(r3buf[..]);
			ov = wrapop(op, &rb, a, rb.to_const(), s, v.bits, scratch[..]);
			expect(v, "r aliases b", rb.to_const(), want);
			expect_flag(v, "overflow (r aliases b)", ov, v.flag);
		case "trunc":
		case "sat":
		case "not":
		case "shl":
		case "shr":
			BigIntConst want = parse(ebuf[..], v.r);
			unaryop(op, &r, a, s, v.bits, v.b);
			expect(v, "plain", r.to_const(), want);
			BigIntMutable ra = a.to_mutable(r2buf[..]);
			unaryop(op, &ra, ra.to_const(), s, v.bits, v.b);
			expect(v, "r aliases a", ra.to_const(), want);
		case "fits":
			expect_flag(v, "fits", a.fits_in_twos_comp(s, v.bits), v.flag);
		case "bits":
			if (a.bit_count_twos_comp() != (usz)parse_dec(v.r)) fail(v, "bit_count_twos_comp", "", v.r);
			if (a.bit_count_abs() != (usz)parse_dec(v.r2)) fail(v, "bit_count_abs", "", v.r2);
		case "tostr":
			char base = (char)v.b;
			char[600] buf;
			Limb[CAP] tscratch;
			sz bound = a.size_in_base_upper_bound(base);
			if (bound > 600 || bigint::calc_to_string_limbs_buffer_len(a.limbs.len, base) > CAP)
			{
				fail(v, "buffer bounds", "", "");
				return;
			}
			sz n = a.to_string(buf[:bound], base, false, tscratch[..]);
			if ((String)buf[:n] != v.r) fail(v, "to_string lower", (String)buf[:n], v.r);
			n = a.to_string(buf[:bound], base, true, tscratch[..]);
			if ((String)buf[:n] != v.r2) fail(v, "to_string upper", (String)buf[:n], v.r2);
			String s1 = a.to_string_alloc(mem, base, false);
			if (s1 != v.r) fail(v, "to_string_alloc", s1, v.r);
			alloc::free(mem, s1.ptr);
			Limb[CAP] pbuf;
			expect(v, "set_string lower", parse_base(pbuf[..], base, v.r), a);
			expect(v, "set_string upper", parse_base(pbuf[..], base, v.r2), a);
		case "toint":
			fault want_fault;
			if (!v.flag) want_fault = v.r == "TargetTooSmall" ? bigint::TARGET_TOO_SMALL : bigint::NEGATIVE_INTO_UNSIGNED;
			ulong want = v.flag ? parse_dec(v.r) : 0;
			ulong got;
			fault f;
			switch (v.b)
			{
				case 0:
					ulong? x = a.to_u64();
					if (catch e = x) { f = e; } else { got = x; }
				case 1:
					long? x = a.to_i64();
					if (catch e = x) { f = e; } else { got = (ulong)x; }
				case 2:
					uint? x = a.to_u32();
					if (catch e = x) { f = e; } else { got = (ulong)x; }
				default:
					int? x = a.to_i32();
					if (catch e = x) { f = e; } else { got = (ulong)(long)x; }
			}
			if (v.flag)
			{
				if (f)
				{
					fail(v, "to_int unexpected fault", "fault", v.r);
				}
				else if (got != want)
				{
					fail(v, "to_int value", "?", v.r);
				}
			}
			else if (f != want_fault)
			{
				fail(v, "to_int fault", "", v.r);
			}
		default:
			unreachable("unknown vector op");
	}
}

fn void zig_vectors() @test
{
	failures = 0;
	foreach (v : VECTORS) run_vector(v);
	if (failures) io::eprintfn("%d of %d vectors failed", failures, VECTORS.len);
	check(failures, 0);
}

// ---------------------------------------------------------------------------
// Hand-written tests

fn void small_values_and_orders() @test
{
	Limb[2] b1;
	Limb[2] b2;
	BigIntMutable m = bigint::init_i64(b1[..], LONG_MIN);
	assert(!m.positive);
	check(m.len, 1);
	assert(m.limbs[0] == 0x8000_0000_0000_0000);
	check(m.to_const().to_i64()!!, LONG_MIN);
	check(m.to_const().bit_count_twos_comp(), 64);
	assert(m.to_const().fits_in_twos_comp(SIGNED, 64));
	assert(!m.to_const().fits_in_twos_comp(SIGNED, 63));
	// Zig checks fitsInTwosComp before the sign, so negative -> unsigned is TargetTooSmall.
	assert(@catch(m.to_const().to_u64()) == bigint::TARGET_TOO_SMALL);
	BigIntMutable u = bigint::init_u64(b2[..], ULONG_MAX);
	assert(u.to_const().to_u64()!! == ULONG_MAX);
	assert(@catch(u.to_const().to_i64()) == bigint::TARGET_TOO_SMALL);
	assert(m.to_const().order(u.to_const()) == LT);
	assert(u.to_const().order(m.to_const()) == GT);
	assert(m.to_const().order_abs(u.to_const()) == LT);
	assert(m.to_const().order_against_i64(LONG_MIN) == EQ);
	assert(m.to_const().order_against_i64(-1) == LT);
	assert(u.to_const().order_against_i64(LONG_MAX) == GT);
	assert(BigIntOrder.LT.compare(LTE) && BigIntOrder.EQ.compare(GTE) && !BigIntOrder.GT.compare(NEQ) == false);
	assert(!BigIntOrder.GT.compare(LT) && BigIntOrder.GT.compare(NEQ));
	// -0 never escapes: negate of zero stays positive.
	BigIntMutable z = bigint::init_i64(b1[..], 0);
	z.negate();
	assert(z.positive);
	assert(z.to_const().negate().positive);
	assert(z.to_const().eql_zero() && z.to_const().is_even() && !z.to_const().is_odd());
	// -128 -> 8, -129 -> 9, 127 -> 7 (doc examples)
	z.set_i64(-128);
	check(z.to_const().bit_count_twos_comp(), 8);
	check(z.to_const().bit_count_twos_comp_for_signedness(SIGNED), 8);
	z.set_i64(-129);
	check(z.to_const().bit_count_twos_comp(), 9);
	z.set_i64(127);
	check(z.to_const().bit_count_twos_comp(), 7);
	check(z.to_const().bit_count_twos_comp_for_signedness(SIGNED), 8);
	check(z.to_const().to_i32()!!, 127);
	check(z.to_const().to_u32()!!, 127);
	z.set_i64(-2147483648);
	check(z.to_const().to_i32()!!, INT_MIN);
	z.set_i64(-2147483649);
	assert(@catch(z.to_const().to_i32()) == bigint::TARGET_TOO_SMALL);
	z.set_u64(0x1_0000_0000);
	assert(@catch(z.to_const().to_u32()) == bigint::TARGET_TOO_SMALL);
}

fn void negative_zero_never_escapes() @test
{
	Limb[8] a;
	Limb[8] b;
	Limb[8] q;
	Limb[8] r;
	Limb[32] scratch;
	// source-derived: Zig 0.17.0 divTrunc(-6, 3) leaves r = "-0" (r.positive = a.positive).
	BigIntConst x = parse(a[..], "-6");
	BigIntConst y = parse(b[..], "3");
	BigIntMutable qm = { .limbs = q[..], .len = 1, .positive = true };
	BigIntMutable rm = { .limbs = r[..], .len = 1, .positive = true };
	bigint::div_trunc(&qm, &rm, x, y, scratch[..]);
	assert(rm.to_const().eql_zero() && rm.positive);
	check(qm.to_const().to_i64()!!, -2);
	// divFloor(-6, -3): Zig sets r.positive = false unconditionally.
	y = parse(b[..], "-3");
	bigint::div_floor(&qm, &rm, x, y, scratch[..]);
	assert(rm.to_const().eql_zero() && rm.positive);
	check(qm.to_const().to_i64()!!, 2);
	// multi-limb * 0 with different signs
	x = parse(a[..], "-123456789abcdef0123456789abcdef");
	y = parse(b[..], "0");
	qm.mul(x, y, scratch[..]);
	assert(qm.to_const().eql_zero() && qm.positive && qm.len == 1);
	// "-" and "-0" parse to +0
	BigIntConst mz = parse(a[..], "-0_0");
	assert(mz.positive && mz.eql_zero());
}

fn void set_string_edges() @test
{
	Limb[8] buf;
	BigIntMutable m = { .limbs = buf[..], .len = 1, .positive = true };
	m.set_string(10, "18_446_744_073_709_551_616", buf[:0])!!;
	check(m.len, 2);
	assert(m.limbs[0] == 0 && m.limbs[1] == 1);
	m.set_string(16, "DeadBeef", buf[:0])!!;
	assert(m.to_const().to_u64()!! == 0xDEADBEEF);
	m.set_string(36, "zz", buf[:0])!!;
	check(m.to_const().to_i64()!!, 35 * 36 + 35);
	m.set_string(2, "", buf[:0])!!;
	assert(m.to_const().eql_zero());
	assert(@catch(m.set_string(10, "12a", buf[:0])) == bigint::INVALID_CHARACTER);
	assert(@catch(m.set_string(8, "8", buf[:0])) == bigint::INVALID_CHARACTER);
	assert(@catch(m.set_string(16, "0x10", buf[:0])) == bigint::INVALID_CHARACTER);
	assert(@catch(m.set_string(1, "0", buf[:0])) == bigint::INVALID_BASE);
	assert(@catch(m.set_string(37, "0", buf[:0])) == bigint::INVALID_BASE);
	// Sized exactly with calc_set_string_limb_count: 39 decimal digits of 10^39 - 1.
	String nines = "999999999999999999999999999999999999999";
	sz n = bigint::calc_set_string_limb_count(10, nines.len);
	Limb[16] exact;
	BigIntMutable e = { .limbs = exact[:n], .len = 1, .positive = true };
	e.set_string(10, nines, exact[:0])!!;
	char[64] out;
	sz len = e.to_const().to_string(out[..], 10, false, exact[n..]);
	assert((String)out[:len] == nines);
}

fn void octal_and_base32_regrouped_from_binary() @test
{
	// Zig 0.17.0's toString is wrong for multi-limb values in bases 8 and 32, so the
	// expected digits come from regrouping our (Zig-verified) base-2 output.
	foreach (hex : VALUES)
	{
		Limb[CAP] abuf;
		BigIntConst a = parse(abuf[..], hex);
		String bin = a.to_string_alloc(mem, 2, false);
		defer alloc::free(mem, bin.ptr);
		foreach (group : (usz[]){ 3, 5 })
		{
			char base = group == 3 ? 8 : 32;
			String got = a.to_string_alloc(mem, base, true);
			defer alloc::free(mem, got.ptr);
			// regroup |bin| from the least significant end
			bool neg = bin[0] == '-';
			String digits = neg ? bin[1..] : bin;
			char[600] want;
			sz w = 0;
			for (sz end = digits.len; end > 0; )
			{
				sz start = end >= (sz)group ? end - (sz)group : 0;
				uint d = 0;
				for (sz i = start; i < end; i++) d = d * 2 + (digits[i] - '0');
				want[w++] = d < 10 ? (char)('0' + d) : (char)('A' + d - 10);
				end = start;
			}
			while (w > 1 && want[w - 1] == '0') w--;
			if (neg) want[w++] = '-';
			for (sz i = 0; i < w / 2; i++)
			{
				char t = want[i];
				want[i] = want[w - 1 - i];
				want[w - 1 - i] = t;
			}
			if (got != (String)want[:w]) io::eprintfn("base %d of %s: got %s want %s", base, hex, got, (String)want[:w]);
			assert(got == (String)want[:w]);
			Limb[CAP] pbuf;
			assert(parse_base(pbuf[..], base, got).eql(a));
		}
	}
}

<* xorshift64 *>
fn ulong next_rand(ulong* state)
{
	ulong x = *state;
	x ^= x << 13;
	x ^= x >> 7;
	x ^= x << 17;
	*state = x;
	return x;
}

<* Random limb patterns biased toward 0, 1, all-ones and the top bit, which drive
 Knuth D's qhat corrections and add-back step. *>
fn BigIntConst random_value(Limb[] storage, sz len, ulong* state)
{
	for (sz i = 0; i < len; i++)
	{
		ulong r = next_rand(state);
		switch (r % 7)
		{
			case 0: storage[i] = 0;
			case 1: storage[i] = bigint::LIMB_MAX;
			case 2: storage[i] = 0x8000_0000_0000_0000;
			case 3: storage[i] = bigint::LIMB_MAX - 1;
			case 4: storage[i] = 1;
			default: storage[i] = next_rand(state);
		}
	}
	if (storage[len - 1] == 0) storage[len - 1] = 1;
	return { .limbs = storage[:len], .positive = (next_rand(state) & 1) == 0 };
}

fn void division_identities() @test
{
	ulong state = 0x9E37_79B9_7F4A_7C15;
	for (int iter = 0; iter < 3000; iter++)
	{
		Limb[40] abuf;
		Limb[40] bbuf;
		Limb[40] qbuf;
		Limb[40] rbuf;
		Limb[80] pbuf;
		Limb[128] scratch;
		sz alen = (sz)(next_rand(&state) % 12) + 1;
		sz blen = (sz)(next_rand(&state) % 8) + 1;
		BigIntConst a = random_value(abuf[..], alen, &state);
		BigIntConst b = random_value(bbuf[..], blen, &state);
		bool floor = (iter & 1) == 1;
		BigIntMutable q = { .limbs = qbuf[..], .len = 1, .positive = true };
		BigIntMutable r = { .limbs = rbuf[..], .len = 1, .positive = true };
		if (floor)
		{
			bigint::div_floor(&q, &r, a, b, scratch[..]);
		}
		else
		{
			bigint::div_trunc(&q, &r, a, b, scratch[..]);
		}
		assert(is_normalized(q.to_const()) && is_normalized(r.to_const()));
		// |r| < |b|
		assert(r.to_const().order_abs(b) == LT);
		// sign of r: trunc follows a, floor follows b
		if (!r.to_const().eql_zero()) assert(r.positive == (floor ? b.positive : a.positive));
		// q * b + r == a
		BigIntMutable p = { .limbs = pbuf[..], .len = 1, .positive = true };
		p.mul(q.to_const(), b, scratch[:0]);
		p.add(p.to_const(), r.to_const());
		if (!p.to_const().eql(a))
		{
			io::eprintfn("iter %d: a=%s b=%s q=%s r=%s", iter, show(a), show(b), show(q.to_const()), show(r.to_const()));
		}
		assert(p.to_const().eql(a));
	}
}

fn void bitint_65535_widths() @test
{
	// _BitInt(65535): 1024 limbs.
	const usz BITS = 65535;
	sz n = bigint::calc_twos_comp_limb_count(BITS);
	check(n, 1024);
	Limb[] a = alloc::new_array(mem, Limb, 2 * n + 8);
	defer alloc::free(mem, a.ptr);
	Limb[] b = alloc::new_array(mem, Limb, 2 * n + 8);
	defer alloc::free(mem, b.ptr);
	Limb[] p = alloc::new_array(mem, Limb, 2 * n + 8);
	defer alloc::free(mem, p.ptr);
	Limb[] scratch = alloc::new_array(mem, Limb, 4 * n + 16);
	defer alloc::free(mem, scratch.ptr);

	// u65535 max = 2^65535 - 1
	BigIntMutable max = { .limbs = a, .len = 1, .positive = true };
	max.set_twos_comp_int_limit(MAX, UNSIGNED, BITS);
	check(max.len, 1024);
	check(max.to_const().bit_count_abs(), 65535);
	assert(max.to_const().fits_in_twos_comp(UNSIGNED, BITS));
	assert(!max.to_const().fits_in_twos_comp(SIGNED, BITS));

	// max + 1 wraps to 0 with overflow; exact add gives 2^65535.
	Limb[1] one_buf;
	BigIntConst one = bigint::init_u64(one_buf[..], 1).to_const();
	BigIntMutable s = { .limbs = b, .len = 1, .positive = true };
	assert(s.add_wrap(max.to_const(), one, UNSIGNED, BITS));
	assert(s.to_const().eql_zero());
	s.add(max.to_const(), one);
	check(s.to_const().bit_count_abs(), 65536);
	BigIntMutable sh = { .limbs = p, .len = 1, .positive = true };
	sh.shift_left(one, 65535);
	assert(sh.to_const().eql(s.to_const()));
	// signed min of _BitInt(65535) is -(2^65534); shifting right converges to -1.
	BigIntMutable smin = { .limbs = p, .len = 1, .positive = true };
	smin.set_twos_comp_int_limit(MIN, SIGNED, BITS);
	check(smin.to_const().bit_count_twos_comp(), 65535);
	smin.shift_right(smin.to_const(), 65534);
	check(smin.to_const().to_i64()!!, -1);
	smin.set_twos_comp_int_limit(MIN, SIGNED, BITS);
	smin.shift_right(smin.to_const(), 70000);
	check(smin.to_const().to_i64()!!, -1);
	// truncating (2^65535 - 1) to signed 65535 bits gives -1
	BigIntMutable t = { .limbs = b, .len = 1, .positive = true };
	t.truncate(max.to_const(), SIGNED, BITS);
	check(t.to_const().to_i64()!!, -1);

	// (2^65535 - 1)^2 / (2^65535 - 1) == 2^65535 - 1, remainder 0
	BigIntMutable sq = { .limbs = p, .len = 1, .positive = true };
	sq.mul(max.to_const(), max.to_const(), scratch[:0]);
	check(sq.len, 2048);
	check(sq.to_const().bit_count_abs(), 2 * 65535);
	Limb[] qb = alloc::new_array(mem, Limb, 2 * n + 8);
	defer alloc::free(mem, qb.ptr);
	BigIntMutable q = { .limbs = qb, .len = 1, .positive = true };
	BigIntMutable r = { .limbs = b, .len = 1, .positive = true };
	bigint::div_trunc(&q, &r, sq.to_const(), max.to_const(), scratch);
	assert(q.to_const().eql(max.to_const()));
	assert(r.to_const().eql_zero());
	// mul_wrap of max * max in u65535: (2^k - 1)^2 mod 2^k == 1, overflow
	BigIntMutable w = { .limbs = b, .len = 1, .positive = true };
	assert(w.mul_wrap(max.to_const(), max.to_const(), UNSIGNED, BITS, scratch[:0]));
	check(w.to_const().to_i64()!!, 1);

	// Decimal round trip of 2^65535 - 1 (19729 digits).
	String dec = max.to_const().to_string_alloc(mem, 10, false);
	defer alloc::free(mem, dec.ptr);
	check(dec.len, 19729);
	assert(dec[0] == '1' && dec[dec.len - 1] == '7'); // 2^65535 ends in ...8, minus 1 -> ...7
	sz need = bigint::calc_set_string_limb_count(10, dec.len);
	Limb[] back = alloc::new_array(mem, Limb, need);
	defer alloc::free(mem, back.ptr);
	BigIntMutable bm = { .limbs = back, .len = 1, .positive = true };
	bm.set_string(10, dec, back[:0])!!;
	assert(bm.to_const().eql(max.to_const()));
}

fn void allocating_helpers_do_not_leak() @test
{
	TrackingAllocator ta;
	ta.init(mem);
	defer ta.free();
	for (int i = 0; i < 20; i++)
	{
		Limb[8] abuf;
		Limb[8] bbuf;
		Limb[8] rbuf;
		BigIntConst a = parse(abuf[..], "-123456789abcdef0fedcba98765432100000000000000001");
		BigIntConst b = parse(bbuf[..], "fedcba9876543210f");
		BigIntMutable r = { .limbs = rbuf[..], .len = 1, .positive = true };
		r.rem(&ta, a, b);
		assert(!r.positive);
		r.mod(&ta, a, b);
		assert(r.positive);
		String s = a.to_string_alloc(&ta, 10, false);
		assert(s[0] == '-');
		alloc::free(&ta, s.ptr);
		String z = r.to_const().to_string_alloc(&ta, 16, false);
		alloc::free(&ta, z.ptr);
	}
	check(ta.allocation_count(), 0);
}

fn void square_in_place() @test
{
	// r, a and b all share the same limbs (Zig: "rma may alias a or b; a and b may alias").
	Limb[16] buf;
	Limb[16] ref_buf;
	Limb[16] scratch;
	Limb[16] wbuf;
	BigIntConst x = parse(buf[..], "-deadbeefcafebabe0123456789abcdef");
	BigIntMutable want = { .limbs = ref_buf[..], .len = 1, .positive = true };
	want.mul(x, x, scratch[:0]);
	BigIntMutable r = x.to_mutable(buf[..]);
	r.mul(r.to_const(), r.to_const(), scratch[:bigint::calc_mul_limbs_buffer_len(2, 2, 2)]);
	assert(r.to_const().eql(want.to_const()) && r.positive);
	// in-place mul_wrap at 128 bits: exact square needs 256 bits -> overflow
	BigIntConst y = parse(wbuf[..], "-deadbeefcafebabe0123456789abcdef");
	BigIntMutable w = y.to_mutable(wbuf[..]);
	assert(w.mul_wrap(w.to_const(), w.to_const(), UNSIGNED, 128, scratch[:bigint::calc_mul_wrap_limbs_buffer_len(128, 2, 2, 2)]));
	BigIntMutable t = { .limbs = scratch[..], .len = 1, .positive = true };
	t.truncate(want.to_const(), UNSIGNED, 128);
	assert(w.to_const().eql(t.to_const()));
}

fn void calc_helpers() @test
{
	// source-derived from int.zig calc* functions
	check(bigint::calc_twos_comp_limb_count(0), 1);
	check(bigint::calc_twos_comp_limb_count(64), 1);
	check(bigint::calc_twos_comp_limb_count(65), 2);
	check(bigint::calc_twos_comp_limb_count(128), 2);
	check(bigint::calc_twos_comp_limb_count(129), 3);
	check(bigint::calc_div_limbs_buffer_len(3, 2), 9);
	check(bigint::calc_mul_limbs_buffer_len(3, 5, 2), 10);
	check(bigint::calc_mul_wrap_limbs_buffer_len(64, 3, 5, 2), 2);
	check(bigint::calc_to_string_limbs_buffer_len(3, 16), 0);
	check(bigint::calc_to_string_limbs_buffer_len(3, 10), 3 + 2 + 3 + 3 + 1 + 4);
	check(bigint::calc_set_string_limbs_buffer_len(10, 20), 2 * bigint::calc_set_string_limb_count(10, 20));
}

