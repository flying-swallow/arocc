// Tests for src/c3/float_print.c3 that need no other plan 10 stage-1 code:
// KeyFloat.compare, the Value-level isInf/isNan/isInfSign, the Zig `{d}`
// formatter for f64 (format_f64_decimal), the @round helper and the f64 / cf64
// arms of Value.print. The f16/f32/f80/f128 print arms and the Value-level
// compare need KeyFloat.cast, f64 mul/div and to_float/imag from agents 10.1 and
// 10.3; they are in float_print_manual_tests.c3 (target tagged "manual").
//
// Provenance of expected values:
// - "zig 0.17.0 run": printed by standalone programs run with
//   /home/user/tools/zig/ziglang/zig (0.17.0) on x86_64-linux, Debug mode
//   (Backend64_TablesFull). The same `{d}` program built -OReleaseSmall
//   (Backend64_TablesSmall, the tables float_print.c3 uses) printed
//   byte-identical output for all 360 vectors below.
// - "fixture <name>": value dumps / diagnostics in test/cases/<name>.c.
// - "source-derived": IEEE 754 ordering rules and std.math.compare, by hand.
module float_print_tests;
import aro::float_value, aro::value_interner, aro::value, aro::bigint, aro::type_store, aro::target, aro::lang_opts, aro::compilation;
import std::io, std::core::mem::allocators, std::core::dstring;

struct F64Vector
{
	ulong bits;
	String text;
}

const Host HOST = { X86_64, LINUX, GNU };

<* Run the body with an x86_64-linux-gnu compilation on a tracking allocator; checks nothing leaks. *>
macro @with_comp(; @body(Compilation* comp))
{
	TrackingAllocator ta;
	ta.init(mem);
	defer ta.free();
	{
		Compilation comp;
		comp.init(&ta);
		comp.target = target::parse_triple("x86_64-linux-gnu", HOST)!!;
		comp.langopts.set_target_options(&comp.target);
		type_store::init_named_types(&comp);
		@body(&comp);
		comp.free();
	}
	test::eq((long)ta.allocation_count(), 0);
}

fn String fmt_f64(ulong bits)
{
	DString w = dstring::temp();
	float_value::format_f64_decimal(bits, w);
	return w.str_view();
}

fn String fmt_float(KeyFloat f)
{
	DString w = dstring::temp();
	float_value::print_float(f, w);
	return w.str_view();
}

fn String fmt_complex(KeyComplex c)
{
	DString w = dstring::temp();
	float_value::print_complex(c, w);
	return w.str_view();
}

fn void check_text(String got, String want, ulong bits)
{
	if (got != want) io::printfn("mismatch for %016x: got \"%s\" want \"%s\"", bits, got, want);
	test::eq(got, want);
}

// -----------------------------------------------------------------------------
// format_f64_decimal
// -----------------------------------------------------------------------------

<*
 zig 0.17.0 run: `std.debug.print("{x:0>16} {d}\n", .{ b, @as(f64, @bitCast(b)) })`
 over 60 hand-picked bit patterns (zeros, specials, subnormal extremes, max,
 powers of ten, round-trip edge cases) followed by 300 patterns from
 std.Random.DefaultPrng.init(0x5eed) (every second one forced to a biased
 exponent in 0x3C0..0x43F, every seventh one with the low 32 bits cleared).
*>
