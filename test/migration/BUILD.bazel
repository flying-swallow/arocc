load("//tools:c3.bzl", "c3_binary", "c3_library", "c3_test")

# C3 port of test/runner.zig plus migration gate modes.
c3_library(
    name = "runner_lib",
    srcs = ["runner.c3"],
)

# bazel run //test/migration:runner -- [--cases FILE [--all] [--gate]] <exe> <cases-dir>
c3_binary(
    name = "runner",
    srcs = ["runner_main.c3"],
    deps = [":runner_lib"],
)

c3_test(
    name = "runner_tests",
    srcs = ["runner_tests.c3"],
    data = ["testdata/fake_aro.sh"],
    deps = [":runner_lib"],
)

# Needs --test_env=ARO_REFERENCE_EXE=/abs/path/to/arocc. Without it the test
# reports "reference executable unavailable" and fails, so it is manual.
c3_test(
    name = "reference_regression",
    srcs = ["reference_regression.c3"],
    data = [
        "baseline.json",
        "//:test_cases",
    ],
    tags = ["manual"],
    deps = [":runner_lib"],
)

# Plan 13.6: in-memory preprocessing CLI (`pp_probe -fno-color-diagnostics
# <file> -E -P [args]`) for the runner. Its second module holds the
# macro_regression test body.
c3_binary(
    name = "pp_probe",
    srcs = ["pp_probe.c3"],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Runs macro_regression_cases.txt through the runner with pp_probe in normal
# fixture mode. Manual until the plan 13 stage-1 branches (expansion, paste,
# directives, pp-expr, hideset) are merged: before that every case fails.
c3_test(
    name = "macro_regression",
    srcs = ["pp_probe.c3"],
    data = [
        "macro_regression_cases.txt",
        ":pp_probe",
        "//:test_cases",
    ],
    tags = ["manual"],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)
