load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:c3.bzl", "c3_binary", "c3_library", "c3_test")

# Standalone external-consumer workspace; it is copied to a fresh directory by
# the integration script and resolves aro only through the extracted package.
sh_test(
    name = "library_consumer",
    srcs = ["library_consumer_integration.sh"],
    args = [
        "$(location //:aro_distribution)",
        "$(location @c3c//:c3c)",
    ],
    data = [
        "//:aro_distribution",
        "@c3c//:c3c",
        "@c3c//:stdlib",
        "consumer_workspace/MODULE.bazel",
        "consumer_workspace/consumer.c3",
        "library_consumer.BUILD.bazel",
    ],
)

# C3 port of test/runner.zig plus migration gate modes.
c3_library(
    name = "runner_lib",
    srcs = ["runner.c3"],
)

# bazel run //test/migration:runner -- [--cases FILE [--all] [--gate]] <exe> <cases-dir>
c3_binary(
    name = "runner",
    srcs = ["runner_main.c3"],
    deps = [":runner_lib"],
)

# Portable process fixture used by runner_tests on each host.
c3_binary(
    name = "fake_aro",
    srcs = ["testdata/fake_aro.c3"],
)

c3_test(
    name = "runner_tests",
    srcs = ["runner_tests.c3"],
    data = [":fake_aro"],
    deps = [":runner_lib"],
)

# Exercises runfiles lookup from an unrelated working directory and a
# space-containing runtime data path.
c3_test(
    name = "runfiles_portability_integration",
    srcs = ["runfiles_portability_integration.c3"],
    data = ["runfiles fixtures/portable data.txt"],
)

# Needs --test_env=ARO_REFERENCE_EXE=/abs/path/to/arocc. Without it the test
# reports "reference executable unavailable" and fails, so it is manual.
c3_test(
    name = "reference_regression",
    srcs = ["reference_regression.c3"],
    data = [
        "baseline.json",
        "//:test_cases",
    ],
    tags = ["manual"],
    deps = [":runner_lib"],
)

# Plan 13.6: in-memory preprocessing CLI (`pp_probe -fno-color-diagnostics
# <file> -E -P [args]`) for the runner. Its second module holds the
# macro_regression test body.
c3_binary(
    name = "pp_probe",
    srcs = ["pp_probe.c3"],
    data = ["//:aro_builtin_headers"],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Syntax-only/verbose-AST adapter for parser migration fixtures. It binds the
# declaration grammar and expression hooks while preserving probe-specific CLI
# behavior.
c3_binary(
    name = "frontend_probe",
    srcs = ["frontend_probe.c3"],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Complete direct-child frontend corpus gate. Run the fixtures through the
# production aro_c3 driver; test_cases contains support files and goldens as
# runtime data while runner.c3 selects independent top-level cases.
c3_test(
    name = "frontend_regression",
    srcs = ["frontend_regression.c3"],
    data = [
        "frontend_regression_cases.txt",
        "//:aro_c3",
        "//:test_cases",
    ],
    deps = [":runner_lib", "//:aro_c3_lib"],
)

# Full record fixture runner and frozen tuple gate.
c3_library(
    name = "record_runner_lib",
    srcs = ["record_runner.c3"],
    deps = ["//:aro_c3_lib"],
)

c3_test(
    name = "record_runner_tests",
    srcs = ["record_runner_tests.c3"],
    deps = [":record_runner_lib"],
)

c3_test(
    name = "record_regression",
    srcs = ["record_regression.c3"],
    data = [
        ":record_runner_lib",
        "//:aro_c3",
        "//test:record_fixtures",
    ],
    deps = [":record_runner_lib"],
)

# Production frontend driver lifecycle and CLI behavior. The executable is a
# runfile as well, so resource-header lookup follows the same Bazel layout.
c3_test(
    name = "cli_tests",
    srcs = ["cli_tests.c3"],
    data = ["//:aro_c3"],
    deps = [":runner_lib", "//:aro_c3_lib"],
)

# Source-derived lifecycle checks for data-only backend CLI modes, subprocess
# failures, structured argv, and invocation-owned temporary-file cleanup.
c3_test(
    name = "backend_cli_regression",
    srcs = ["backend_cli_regression.c3"],
    deps = ["//:aro_c3_lib"],
)

# Native Linux x86-64 acceptance: compile supported data through aro_c3, then
# link and run a separately compiled C consumer using the declared host cc.
sh_test(
    name = "native_backend_cli_integration",
    srcs = ["native_backend_cli_integration.sh"],
    args = [
        "$(location //:aro_c3)",
        "$(location backend_data.c)",
        "$(location backend_consumer.c)",
        "$(location @native_assembler_tools//:cc)",
    ],
    data = [
        "//:aro_c3",
        "backend_data.c",
        "backend_consumer.c",
        "@native_assembler_tools//:cc",
        "@native_assembler_tools//:as",
    ],
)

# Typed-IR probe for the AST-lowering migration boundary. The probe uses direct
# Builder fixtures and hand-built AST fixtures; expected outcomes are source-derived.
c3_binary(
    name = "ir_probe",
    srcs = ["ir_probe.c3"],
    data = ["ir_regression_cases.txt"],
    deps = ["//:aro_c3_lib"],
)

# Data-only x86-64 assembly probe built from direct AST fixtures. Its output
# vectors are source-derived and do not claim executable Zig parity.
c3_binary(
    name = "assembly_probe",
    srcs = ["assembly_probe.c3"],
    deps = ["//:aro_c3_lib"],
)

filegroup(
    name = "assembly_fixture_tree",
    srcs = glob(["assembly_fixtures/**"]),
)

c3_test(
    name = "assembly_regression",
    srcs = ["assembly_regression.c3"],
    data = [
        "assembly_regression_cases.txt",
        ":assembly_fixture_tree",
        ":assembly_probe",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Native Linux x86-64 smoke test: assemble one emitted data section and inspect
# its ELF symbols and bytes. The script reports a skip on other hosts.
sh_test(
    name = "native_assembly_integration",
    srcs = ["native_assembly_integration.sh"],
    args = [
        "$(location :assembly_probe)",
        "$(location assembly_fixtures/integer_scalars.c)",
        "$(location @native_assembler_tools//:as)",
        "$(location @native_assembler_tools//:readelf)",
    ],
    data = [
        ":assembly_probe",
        "assembly_fixtures/integer_scalars.c",
        "@native_assembler_tools//:as",
        "@native_assembler_tools//:readelf",
    ],
)

filegroup(
    name = "declaration_fixture_tree",
    srcs = glob(["declaration_fixtures/**"]),
)

c3_test(
    name = "declaration_regression",
    srcs = ["declaration_regression.c3"],
    data = [
        "declaration_regression_cases.txt",
        ":declaration_fixture_tree",
        ":frontend_probe",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Keep this target manual until the remaining builtin, static-assert, and GNU
# attribute parser gaps are covered by the frontend fixture gate.
filegroup(
    name = "builtin_fixture_tree",
    srcs = glob(["builtin_fixtures/**"]),
)

c3_test(
    name = "builtin_regression",
    srcs = ["builtin_regression.c3"],
    data = [
        "builtin_regression_cases.txt",
        ":builtin_fixture_tree",
        ":frontend_probe",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
    tags = ["manual"],
)

c3_test(
    name = "initializer_regression",
    srcs = ["initializer_regression.c3"],
    data = [
        "initializer_regression_cases.txt",
        ":declaration_fixture_tree",
        ":frontend_probe",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Runs macro_regression_cases.txt through the runner with pp_probe in normal
# fixture mode. Manual until the plan 13 stage-1 branches (expansion, paste,
# directives, pp-expr, hideset) are merged; all of them are now.
c3_test(
    name = "macro_regression",
    srcs = ["pp_probe.c3"],
    data = [
        "macro_regression_cases.txt",
        ":pp_probe",
        "//:test_cases",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Preprocessing-only regression gate for include/embed directives and the
# existing macro corpus. Expected results come from the frozen fixture
# manifests; this does not claim an executable Zig reference run.
c3_test(
    name = "preprocessor_regression",
    srcs = ["preprocessor_regression.c3"],
    data = [
        "macro_regression_cases.txt",
        "predefined_macro_cases.txt",
        "include_embed_regression_cases.txt",
        ":pp_probe",
        "//:test_cases",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Stable runfile tree for focused include/embed integration. Keeping the
# binary and empty embed inputs beside the source makes filesystem behavior
# explicit and independent of the frozen Zig fixture corpus.
filegroup(
    name = "preprocessor_fixture_tree",
    srcs = glob(["preprocessor_fixtures/**"]),
)

c3_test(
    name = "preprocessor_integration",
    srcs = ["preprocessor_integration.c3"],
    data = [
        ":pp_probe",
        ":preprocessor_fixture_tree",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Predefined macros are generated from target/language state and then expanded
# through the ordinary preprocessor path. Expected vectors are source-derived
# until a compatible pinned Zig executable is available.
c3_test(
    name = "predefined_macro_regression",
    srcs = ["predefined_macro_regression.c3", "pp_probe.c3"],
    data = [
        # pp_probe.c3 also carries the macro_regression test.
        "macro_regression_cases.txt",
        "predefined_macro_cases.txt",
        "predefined_macro_vectors.txt",
        ":pp_probe",
        "//:test_cases",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)
