load("//tools:c3.bzl", "c3_binary", "c3_library", "c3_test")

# C3 port of test/runner.zig plus migration gate modes.
c3_library(
    name = "runner_lib",
    srcs = ["runner.c3"],
)

# bazel run //test/migration:runner -- [--cases FILE [--all] [--gate]] <exe> <cases-dir>
c3_binary(
    name = "runner",
    srcs = ["runner_main.c3"],
    deps = [":runner_lib"],
)

c3_test(
    name = "runner_tests",
    srcs = ["runner_tests.c3"],
    data = ["testdata/fake_aro.sh"],
    deps = [":runner_lib"],
)

# Needs --test_env=ARO_REFERENCE_EXE=/abs/path/to/arocc. Without it the test
# reports "reference executable unavailable" and fails, so it is manual.
c3_test(
    name = "reference_regression",
    srcs = ["reference_regression.c3"],
    data = [
        "baseline.json",
        "//:test_cases",
    ],
    tags = ["manual"],
    deps = [":runner_lib"],
)

# Plan 13.6: in-memory preprocessing CLI (`pp_probe -fno-color-diagnostics
# <file> -E -P [args]`) for the runner. Its second module holds the
# macro_regression test body.
c3_binary(
    name = "pp_probe",
    srcs = ["pp_probe.c3"],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Runs macro_regression_cases.txt through the runner with pp_probe in normal
# fixture mode. Manual until the plan 13 stage-1 branches (expansion, paste,
# directives, pp-expr, hideset) are merged; all of them are now.
c3_test(
    name = "macro_regression",
    srcs = ["pp_probe.c3"],
    data = [
        "macro_regression_cases.txt",
        ":pp_probe",
        "//:test_cases",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Preprocessing-only regression gate for include/embed directives and the
# existing macro corpus. Expected results come from the frozen fixture
# manifests; this does not claim an executable Zig reference run.
c3_test(
    name = "preprocessor_regression",
    srcs = ["preprocessor_regression.c3"],
    data = [
        "macro_regression_cases.txt",
        "predefined_macro_cases.txt",
        "include_embed_regression_cases.txt",
        ":pp_probe",
        "//:test_cases",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Stable runfile tree for focused include/embed integration. Keeping the
# binary and empty embed inputs beside the source makes filesystem behavior
# explicit and independent of the frozen Zig fixture corpus.
filegroup(
    name = "preprocessor_fixture_tree",
    srcs = glob(["preprocessor_fixtures/**"]),
)

c3_test(
    name = "preprocessor_integration",
    srcs = ["preprocessor_integration.c3"],
    data = [
        ":pp_probe",
        ":preprocessor_fixture_tree",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)

# Predefined macros are generated from target/language state and then expanded
# through the ordinary preprocessor path. Expected vectors are source-derived
# until a compatible pinned Zig executable is available.
c3_test(
    name = "predefined_macro_regression",
    srcs = ["predefined_macro_regression.c3", "pp_probe.c3"],
    data = [
        "predefined_macro_cases.txt",
        "predefined_macro_vectors.txt",
        ":pp_probe",
        "//:test_cases",
    ],
    deps = [
        ":runner_lib",
        "//:aro_c3_lib",
    ],
)
