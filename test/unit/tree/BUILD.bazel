load("//tools:c3.bzl", "c3_test")

# Unit tests: tree. One target per line so parallel additions merge cleanly.

c3_test(name = "tree_contract_tests", srcs = ["tree_contract_tests.c3"], deps = ["//:aro_c3_lib"])
c3_test(name = "tree_tests", srcs = ["tree_tests.c3"], deps = ["//:aro_c3_lib"])
c3_test(name = "tree_dump_tests", srcs = ["tree_dump_tests.c3"], deps = ["//:aro_c3_lib"])

# Default suite; manual tests stay addressable but out of it.
test_suite(
    name = "all",
    tests = [
        ":tree_contract_tests",
        ":tree_tests",
        ":tree_dump_tests",
    ],
    visibility = ["//test:__pkg__"],
)
