load("//tools:c3.bzl", "c3_binary")

# C3 frontend probes and harnesses.

# `lex_probe <file>...` prints tokens in `c3c --lex-only` format for diffing.
c3_binary(
    name = "lex_probe",
    srcs = ["lex_probe.c3"],
    deps = ["//:aro_c3_frontend_lib"],
)

# `parse_probe <file>...` parses files (c3c `-P`); errors on stderr.
c3_binary(
    name = "parse_probe",
    srcs = ["parse_probe.c3"],
    deps = ["//:aro_c3_frontend_lib"],
)
