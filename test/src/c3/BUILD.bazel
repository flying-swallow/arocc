load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:c3.bzl", "c3_binary")

# C3 frontend probes and harnesses.

# `lex_probe <file>...` prints tokens in `c3c --lex-only` format for diffing.
c3_binary(
    name = "lex_probe",
    srcs = ["lex_probe.c3"],
    deps = ["//:aro_c3_frontend_lib"],
)

# `parse_probe <file>...` parses files (c3c `-P`); errors on stderr.
c3_binary(
    name = "parse_probe",
    srcs = ["parse_probe.c3"],
    deps = ["//:aro_c3_frontend_lib"],
)

# `check_probe <file>...` parses and checks files (c3c `--use-stdlib=no -C
# compile`, check only); errors on stderr. Stops at the first sema stub until
# sema is ported.
c3_binary(
    name = "check_probe",
    srcs = ["check_probe.c3"],
    deps = ["//:aro_c3_frontend_lib"],
)

sh_test(
    name = "compiler_cli_test",
    srcs = ["compiler_cli_test.sh"],
    args = ["$(location //:aro_c3)"],
    data = ["//:aro_c3"],
)
