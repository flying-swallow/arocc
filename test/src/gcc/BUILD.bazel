load("//tools:c3.bzl", "c3_binary", "c3_main_test", "c3_test")

# GCC C testsuite (copied into test/gcc) as golden cases: torture compile must
# compile cleanly, torture execute/ieee must build, link and exit 0, gcc.dg must
# match dg-error/dg-warning lines, asm compiles gcc.dg cases with -S and applies
# their dg-final scan-assembler checks. Not gated: the suite targets are tagged
# manual (skipped by `bazel test //...`) and serve as a worklist for migrating
# cases into the main unit tests. summary.md/results.jsonl are in the test's
# undeclared outputs. Run explicitly, e.g.
#   bazel test //test/src/gcc:gcc_testsuite_execute
#   bazel run //test/src/gcc:gcc_testsuite_run [-- --filter 'pr1*']

c3_test(
    name = "gcc_testsuite_tests",
    srcs = ["gcc_testsuite.c3"],
    deps = ["//test/src/lib:harness_lib"],
)

_GCC_TESTSUITE_SUITES = {
    "compile": 2,
    "execute": 2,
    "ieee": 1,
    "dg": 4,
    "asm": 1,
}

[c3_main_test(
    name = "gcc_testsuite_" + suite,
    size = "large",
    srcs = ["gcc_testsuite.c3"],
    args = [
        "--aro",
        "$(rootpath //:aro_c3)",
        "--suite",
        suite,
    ],
    data = [
        "//:aro_c3",
        "//test:gcc_testsuite",
    ],
    shard_count = shards,
    tags = ["manual"],
    deps = ["//test/src/lib:harness_lib"],
) for suite, shards in _GCC_TESTSUITE_SUITES.items()]

test_suite(
    name = "gcc_testsuite",
    tags = ["manual"],
    tests = [":gcc_testsuite_" + suite for suite in _GCC_TESTSUITE_SUITES],
)

# bazel run //test/src/gcc:gcc_testsuite_run [-- extra args]
# runs every suite on <workspace>/test/gcc.
c3_binary(
    name = "gcc_testsuite_run",
    srcs = ["gcc_testsuite.c3"],
    args = [
        "--aro",
        "$(rootpath //:aro_c3)",
        "--suite",
        ",".join(_GCC_TESTSUITE_SUITES.keys()),
    ],
    data = ["//:aro_c3"],
    deps = ["//test/src/lib:harness_lib"],
)
