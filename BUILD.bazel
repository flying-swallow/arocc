# Stable public module target. This name is the supported dependency for C3
# consumers; aro_c3_lib remains available for existing in-repository users.
c3_library(
    name = "aro",
    deps = [":aro_c3_lib"],
    data = [":aro_builtin_headers"],
    visibility = ["//visibility:public"],
)

