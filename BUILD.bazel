load("//tools:builtins.bzl", "builtin_defs")
load("//tools:c3.bzl", "c3_binary", "c3_library", "c3_source_archive")
load("//tools:system_defaults.bzl", "system_defaults")

system_defaults(name = "system_defaults_module", visibility = ["//visibility:public"])

# Standalone consumer examples: core construction and optional verification.
c3_binary(
    name = "ir_example",
    srcs = ["examples/ir_increment.c3"],
    deps = ["//ir.c3l:ir"],
)

# Library sources are listed explicitly; agents append new modules here.
alias(name = "aro_cc_lib", actual = "//aro_cc:lib", visibility = ["//visibility:public"])
alias(name = "aro_c3_lib", actual = "//aro_c3c:lib", visibility = ["//visibility:public"])

# Compatibility name for the independent C3 frontend library.
alias(name = "aro_c3_frontend_lib", actual = "//aro_c3c:lib", visibility = ["//visibility:public"])

# Stable public module target. This name is the supported dependency for C3
# consumers; aro_cc_lib remains available for existing in-repository users.
c3_library(
    name = "aro",
    deps = [":aro_cc_lib"],
    data = [":aro_builtin_headers"],
    visibility = ["//visibility:public"],
)

# Generated builtin tables (plan 12): one aro::frontend::c::builtin_defs::<group> module
# per .def file, in Builtins.zig order.
builtin_defs(
    name = "builtin_defs",
    srcs = [
        "//aro_cc:src/Builtins/aarch64.def",
        "//aro_cc:src/Builtins/aarch64_neon.def",
        "//aro_cc:src/Builtins/amdgcn.def",
        "//aro_cc:src/Builtins/arm.def",
        "//aro_cc:src/Builtins/bpf.def",
        "//aro_cc:src/Builtins/common.def",
        "//aro_cc:src/Builtins/hexagon.def",
        "//aro_cc:src/Builtins/loongarch.def",
        "//aro_cc:src/Builtins/mips.def",
        "//aro_cc:src/Builtins/neon.def",
        "//aro_cc:src/Builtins/nvptx.def",
        "//aro_cc:src/Builtins/powerpc.def",
        "//aro_cc:src/Builtins/riscv.def",
        "//aro_cc:src/Builtins/s390x.def",
        "//aro_cc:src/Builtins/ve.def",
        "//aro_cc:src/Builtins/wasm.def",
        "//aro_cc:src/Builtins/x86_64.def",
        "//aro_cc:src/Builtins/x86.def",
        "//aro_cc:src/Builtins/xcore.def",
    ],
    visibility = ["//visibility:public"],
)



# Runtime resource headers for the installed compiler layout. The toolchain
# finds these relative to the executable (or accepts an explicit resource dir).
filegroup(
    name = "aro_builtin_headers",
    srcs = glob(["include/*.h"]),
    visibility = ["//visibility:public"],
)

# Source package with its own Bazel module/build files. Generated C3 modules
# arrive through the C3Info closure and are normalized to their source package
# paths by c3_source_archive.
c3_source_archive(
    name = "aro_distribution",
    deps = [":aro"],
    srcs = [
        "VERSION",
        "LICENSE",
        "LICENSE-UNICODE",
        "docs/c3-api.md",
        "docs/ir-library.md",
        "docs/compiler-layout.md",
        "examples/ir_increment.c3",
        "examples/parse_buffer.c3",
        "distfiles/package.BUILD.bazel",
        "distfiles/package.MODULE.bazel",
        "distfiles/tools.BUILD.bazel",
        "//tools:c3.bzl",
        "//tools:c3_test_launcher.sh.tpl",
        "//tools:c3c_repo.bzl",
    ],
    src_path_prefixes = {
        "distfiles/package.BUILD.bazel": "BUILD.bazel",
        "distfiles/package.MODULE.bazel": "MODULE.bazel",
        "distfiles/tools.BUILD.bazel": "tools/BUILD.bazel",
    },
    visibility = ["//visibility:public"],
)

c3_binary(
    name = "aro_cc",
    srcs = ["//aro_cc:main.c3"],
    deps = [":aro_cc_lib"],
    data = [":aro_builtin_headers"],
    visibility = ["//visibility:public"],
)

alias(name = "aro_c3c", actual = "//aro_c3c:aro_c3c", visibility = ["//visibility:public"])

alias(name = "aro_c3", actual = ":aro_c3c", visibility = ["//visibility:public"])

# Complete record-layout fixture corpus and any future sibling runtime files.
filegroup(
    name = "record_fixtures_tree",
    srcs = ["//aro_cc/test:record_fixtures"],
    visibility = ["//aro_cc/test/src/records:__pkg__"],
)

# The 19 builtin .def inputs as runtime data (plan 12.1 //aro_cc/test/builtins:def_parse_tests).
alias(name = "builtin_def_files", actual = "//aro_cc:builtin_def_files", visibility = ["//visibility:public"])

# C3 frontend sources, checked by //aro_cc/test/unit/c3:isolation_test (no C frontend imports).
filegroup(
    name = "c3_frontend_srcs",
    srcs = ["//aro_c3c:sources"],
    visibility = ["//aro_cc/test/unit/c3:__pkg__"],
)
