        "src/c3/aro.c3",
        "src/c3/bigint.c3",
        "src/c3/builtin_properties.c3",
        "src/c3/builtin_type_description.c3",
        "src/c3/builtins.c3",
        ":builtin_defs",
        "src/c3/char_info.c3",
        "src/c3/compilation.c3",
        "src/c3/diagnostics.c3",
        "src/c3/float_print.c3",
        "src/c3/float_soft_narrow.c3",
        "src/c3/float_soft_wide.c3",
        "src/c3/float_value.c3",
        "src/c3/identifier_tables.c3",
        "src/c3/lang_opts.c3",
        "src/c3/source.c3",
        "src/c3/string_interner.c3",
        "src/c3/target.c3",
        "src/c3/target_cpu.c3",
        "src/c3/target_data.c3",
        "src/c3/tokenizer.c3",
        "src/c3/toolchain/discovery.c3",
        "src/c3/toolchain/distro.c3",
        "src/c3/toolchain/gcc_detector.c3",
        "src/c3/toolchain/gcc_version.c3",
        "src/c3/toolchain/multilib.c3",
        "src/c3/type_print.c3",
        "src/c3/type_store.c3",
        "src/c3/type_store_layout.c3",
        "src/c3/type_store_named.c3",
        "src/c3/type_store_relations.c3",
        "src/c3/value.c3",
        "src/c3/value_interner.c3",
    ],
    visibility = ["//visibility:public"],
)

# Generated builtin tables (plan 12): one aro::builtin_defs::<group> module
# per .def file, in Builtins.zig order.
builtin_defs(
    name = "builtin_defs",
    srcs = [
        "src/aro/Builtins/aarch64.def",
        "src/aro/Builtins/aarch64_neon.def",
        "src/aro/Builtins/amdgcn.def",
        "src/aro/Builtins/arm.def",
        "src/aro/Builtins/bpf.def",
        "src/aro/Builtins/common.def",
        "src/aro/Builtins/hexagon.def",
        "src/aro/Builtins/loongarch.def",
        "src/aro/Builtins/mips.def",
        "src/aro/Builtins/neon.def",
        "src/aro/Builtins/nvptx.def",
        "src/aro/Builtins/powerpc.def",
        "src/aro/Builtins/riscv.def",
        "src/aro/Builtins/s390x.def",
        "src/aro/Builtins/ve.def",
        "src/aro/Builtins/wasm.def",
        "src/aro/Builtins/x86_64.def",
        "src/aro/Builtins/x86.def",
        "src/aro/Builtins/xcore.def",
    ],
    # //test/c3:builtin_defs_regen_tests diffs these outputs against an in-process emit.
    visibility = ["//test/c3:__pkg__"],
)

exports_files(["src/c3/builtin_properties.c3"])

c3_binary(
    name = "aro_c3",
    srcs = ["app/aro_c3/main.c3"],
    deps = [":aro_c3_lib"],
)

# Integration fixture corpus (cases, includes, ast/ and expanded/ goldens)
# as runtime data for //test/migration:* runner targets.
filegroup(
    name = "test_cases",
    srcs = glob(["test/cases/**"]),
    visibility = ["//test/migration:__pkg__"],
)

# The 19 builtin .def inputs as runtime data (plan 12.1 //test/c3:def_parse_tests).
filegroup(
    name = "builtin_def_files",
    srcs = glob(["src/aro/Builtins/*.def"]),
    visibility = ["//visibility:public"],
)
