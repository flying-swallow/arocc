# Stable public module target. This name is the supported dependency for C3
# consumers; aro_c3_lib remains available for existing in-repository users.
c3_library(
    name = "aro",
    deps = [":aro_c3_lib"],
    data = [":aro_builtin_headers"],
    visibility = ["//visibility:public"],
)

# Generated builtin tables (plan 12): one aro::frontend::c::builtin_defs::<group> module
# per .def file, in Builtins.zig order.
builtin_defs(
    name = "builtin_defs",
    srcs = [
        "src/aro/Builtins/aarch64.def",
        "src/aro/Builtins/aarch64_neon.def",
        "src/aro/Builtins/amdgcn.def",
        "src/aro/Builtins/arm.def",
        "src/aro/Builtins/bpf.def",
        "src/aro/Builtins/common.def",
        "src/aro/Builtins/hexagon.def",
        "src/aro/Builtins/loongarch.def",
        "src/aro/Builtins/mips.def",
        "src/aro/Builtins/neon.def",
        "src/aro/Builtins/nvptx.def",
        "src/aro/Builtins/powerpc.def",
        "src/aro/Builtins/riscv.def",
        "src/aro/Builtins/s390x.def",
        "src/aro/Builtins/ve.def",
        "src/aro/Builtins/wasm.def",
        "src/aro/Builtins/x86_64.def",
        "src/aro/Builtins/x86.def",
        "src/aro/Builtins/xcore.def",
    ],
    # //test/unit/builtins:builtin_defs_regen_tests diffs these outputs against an in-process emit.
    visibility = ["//test/unit/builtins:__pkg__"],
)

exports_files(["src/frontend/c/builtin_properties.c3"])

# Runtime resource headers for the installed compiler layout. The toolchain
# finds these relative to the executable (or accepts an explicit resource dir).
filegroup(
    name = "aro_builtin_headers",
    srcs = glob(["include/*.h"]),
    visibility = ["//visibility:public"],
)

# Source package with its own Bazel module/build files. Generated C3 modules
# arrive through the C3Info closure and are normalized to their source package
# paths by c3_source_archive.
c3_source_archive(
    name = "aro_distribution",
    deps = [":aro"],
    srcs = [
        "VERSION",
        "LICENSE",
        "LICENSE-UNICODE",
        "docs/c3-api.md",
        "examples/parse_buffer.c3",
        "distfiles/package.BUILD.bazel",
        "distfiles/package.MODULE.bazel",
        "distfiles/tools.BUILD.bazel",
        "//tools:c3.bzl",
        "//tools:c3_test_launcher.sh.tpl",
        "//tools:c3c_repo.bzl",
    ],
    src_path_prefixes = {
        "distfiles/package.BUILD.bazel": "BUILD.bazel",
        "distfiles/package.MODULE.bazel": "MODULE.bazel",
        "distfiles/tools.BUILD.bazel": "tools/BUILD.bazel",
    },
    visibility = ["//visibility:public"],
)

c3_binary(
    name = "aro_c3",
    srcs = ["app/aro_c3/main.c3"],
    deps = [":aro_c3_lib"],
    data = [":aro_builtin_headers"],
    visibility = ["//visibility:public"],
)

# Complete record-layout fixture corpus and any future sibling runtime files.
filegroup(
    name = "record_fixtures_tree",
    srcs = ["//test:record_fixtures"],
    visibility = ["//test/src/records:__pkg__"],
)

# The 19 builtin .def inputs as runtime data (plan 12.1 //test/unit/builtins:def_parse_tests).
filegroup(
    name = "builtin_def_files",
    srcs = glob(["src/aro/Builtins/*.def"]),
    visibility = ["//visibility:public"],
)
