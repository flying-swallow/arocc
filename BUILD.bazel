# Runtime resource headers for the installed compiler layout. The toolchain
# finds these relative to the executable (or accepts an explicit resource dir).
filegroup(
    name = "aro_builtin_headers",
    srcs = glob(["include/*.h"]),
    visibility = ["//visibility:public"],
)

# Source package with its own Bazel module/build files. Generated C3 modules
# arrive through the C3Info closure and are normalized to their source package
# paths by c3_source_archive.
c3_source_archive(
    name = "aro_distribution",
    deps = [":aro"],
    srcs = [
        "VERSION",
        "LICENSE",
        "LICENSE-UNICODE",
        "docs/c3-api.md",
        "docs/ir-library.md",
        "examples/ir_increment.c3",
        "examples/parse_buffer.c3",
        "distfiles/package.BUILD.bazel",
        "distfiles/package.MODULE.bazel",
        "distfiles/tools.BUILD.bazel",
        "//tools:c3.bzl",
        "//tools:c3_test_launcher.sh.tpl",
        "//tools:c3c_repo.bzl",
    ],
    src_path_prefixes = {
        "distfiles/package.BUILD.bazel": "BUILD.bazel",
        "distfiles/package.MODULE.bazel": "MODULE.bazel",
        "distfiles/tools.BUILD.bazel": "tools/BUILD.bazel",
    },
    visibility = ["//visibility:public"],
)

c3_binary(
    name = "aro_c3",
    srcs = ["aro/app/aro_c3/main.c3"],
    deps = [":aro_c3_lib"],
    data = [":aro_builtin_headers"],
    visibility = ["//visibility:public"],
)

# Complete record-layout fixture corpus and any future sibling runtime files.
filegroup(
    name = "record_fixtures_tree",
    srcs = ["//test:record_fixtures"],
    visibility = ["//test/src/records:__pkg__"],
)

# The 19 builtin .def inputs as runtime data (plan 12.1 //test/unit/builtins:def_parse_tests).
filegroup(
    name = "builtin_def_files",
    srcs = glob(["aro/src/aro/Builtins/*.def"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# C3 frontend sources, checked by //test/unit/c3:isolation_test (no C frontend imports).
filegroup(
    name = "c3_frontend_srcs",
    srcs = glob(["aro/src/frontend/c3/**/*.c3"], allow_empty = True),
    visibility = ["//test/unit/c3:__pkg__"],
)
