load("//tools:c3.bzl", "c3_binary", "c3_library")

# Library sources are listed explicitly; agents append new modules here.
c3_library(
    name = "aro_c3_lib",
    srcs = [
        "src/c3/aro.c3",
        "src/c3/compilation.c3",
        "src/c3/source.c3",
        "src/c3/string_interner.c3",
    ],
    visibility = ["//visibility:public"],
)

c3_binary(
    name = "aro_c3",
    srcs = ["app/aro_c3/main.c3"],
    deps = [":aro_c3_lib"],
)
