	attribute_list[AttributeType.NOSTACKPROTECTOR.ordinal] = kw_def("@nostackprotector", type);
	attribute_list[AttributeType.CNAME.ordinal] = kw_def("@cname", type);
	attribute_list[AttributeType.COMPACT.ordinal] = kw_def("@compact", type);
	attribute_list[AttributeType.CONST.ordinal] = kw_def("@const", type);
	attribute_list[AttributeType.CONSTINIT.ordinal] = kw_def("@constinit", type);
	attribute_list[AttributeType.DEPRECATED.ordinal] = kw_def("@deprecated", type);
	attribute_list[AttributeType.DYNAMIC.ordinal] = kw_def("@dynamic", type);
	attribute_list[AttributeType.EXPORT.ordinal] = kw_def("@export", type);
	attribute_list[AttributeType.FEAT.ordinal] = kw_def("@feat", type);
	attribute_list[AttributeType.FINALIZER.ordinal] = kw_def("@finalizer", type);
	attribute_list[AttributeType.FORMAT.ordinal] = kw_def("@format", type);
	attribute_list[AttributeType.IF.ordinal] = kw_def("@if", type);
	attribute_list[AttributeType.INIT.ordinal] = kw_def("@init", type);
	attribute_list[AttributeType.INLINE.ordinal] = kw_def("@inline", type);
	attribute_list[AttributeType.JUMP.ordinal] = kw_at_jump;
	attribute_list[AttributeType.LINK.ordinal] = kw_def("@link", type);
	attribute_list[AttributeType.LITTLEENDIAN.ordinal] = kw_def("@littleendian", type);
	attribute_list[AttributeType.LOCAL.ordinal] = kw_def("@local", type);
	attribute_list[AttributeType.MAYDISCARD.ordinal] = kw_def("@maydiscard", type);
	attribute_list[AttributeType.MUSTINIT.ordinal] = kw_def("@mustinit", type);
	attribute_list[AttributeType.NAKED.ordinal] = kw_def("@naked", type);
	attribute_list[AttributeType.NOALIAS.ordinal] = kw_def("@noalias", type);
	attribute_list[AttributeType.NODISCARD.ordinal] = kw_def("@nodiscard", type);
	attribute_list[AttributeType.NOINIT.ordinal] = kw_def("@noinit", type);
	attribute_list[AttributeType.NOINLINE.ordinal] = kw_def("@noinline", type);
	attribute_list[AttributeType.NOPADDING.ordinal] = kw_def("@nopadding", type);
	attribute_list[AttributeType.NORECURSE.ordinal] = kw_def("@norecurse", type);
	attribute_list[AttributeType.NORETURN.ordinal] = kw_def("@noreturn", type);
	attribute_list[AttributeType.NOREDZONE.ordinal] = kw_def("@noredzone", type);
	attribute_list[AttributeType.NOSANITIZE.ordinal] = kw_def("@nosanitize", type);
	attribute_list[AttributeType.NOSTRIP.ordinal] = kw_def("@nostrip", type);
	attribute_list[AttributeType.OBFUSCATE.ordinal] = kw_def("@obfuscate", type);
	attribute_list[AttributeType.OPERATOR.ordinal] = kw_def("@operator", type);
	attribute_list[AttributeType.OPERATOR_R.ordinal] = kw_def("@operator_r", type);
	attribute_list[AttributeType.OPERATOR_S.ordinal] = kw_def("@operator_s", type);
	attribute_list[AttributeType.OPTIONAL.ordinal] = kw_def("@optional", type);
	attribute_list[AttributeType.OVERLAP.ordinal] = kw_def("@overlap", type);
	attribute_list[AttributeType.PACKED.ordinal] = kw_def("@packed", type);
	attribute_list[AttributeType.PRIVATE.ordinal] = kw_def("@private", type);
	attribute_list[AttributeType.PURE.ordinal] = kw_at_pure;
	attribute_list[AttributeType.PUBLIC.ordinal] = kw_def("@public", type);
	attribute_list[AttributeType.REFLECT.ordinal] = kw_def("@reflect", type);
	attribute_list[AttributeType.SAFEINFER.ordinal] = kw_def("@safeinfer", type);
	attribute_list[AttributeType.SAFEMACRO.ordinal] = kw_def("@safemacro", type);
	attribute_list[AttributeType.SECTION.ordinal] = kw_def("@section", type);
	attribute_list[AttributeType.SIMD.ordinal] = kw_at_simd;
	attribute_list[AttributeType.TEST.ordinal] = kw_def("@test", type);
	attribute_list[AttributeType.TAG.ordinal] = kw_def("@tag", type);
	attribute_list[AttributeType.UNUSED.ordinal] = kw_def("@unused", type);
	attribute_list[AttributeType.USED.ordinal] = kw_def("@used", type);
	attribute_list[AttributeType.WASM.ordinal] = kw_def("@wasm", type);
	attribute_list[AttributeType.WEAK.ordinal] = kw_def("@weak", type);
	attribute_list[AttributeType.WEAKLINK.ordinal] = kw_def("@weaklink", type);
	attribute_list[AttributeType.WINMAIN.ordinal] = kw_def("@winmain", type);

	foreach (i, b : builtin_list) assert(b.ptr != null, "Missing builtin %d", i);
	foreach (i, p : type_property_list) assert(p.ptr != null, "Missing type property %d", i);
	foreach (i, d : builtin_defines) assert(d.ptr != null, "Missing builtin define %d", i);
	foreach (i, a : attribute_list) assert(a.ptr != null, "Missing attributes %d", i);
}

<* Clear every table filled by `symtab_init` (the strings belong to `global_symtab`). *>
fn void symtab_globals_reset()
{
	attribute_list = {};
	builtin_list = {};
	builtin_defines = {};
	type_property_list = {};
	kw_at_align = {};
	kw_at_deprecated = {};
	kw_at_ensure = {};
	kw_at_enum_lookup = {};
	kw_at_jump = {};
	kw_at_param = {};
	kw_at_pure = {};
	kw_at_require = {};
	kw_at_return = {};
	kw_at_simd = {};
	kw_alignment = {};
	kw_bitoffset = {};
	kw_bitsize = {};
	kw_cname = {};
	kw_description = {};
	kw_drop = {};
	kw_excuse = {};
	kw_generic_args = {};
	kw_generic_qname = {};
	kw_get = {};
	kw_get_tag = {};
	kw_has_tag = {};
	kw_in = {};
	kw_init = {};
	kw_inout = {};
	kw_is_anonymous = {};
	kw_is_const = {};
	kw_is_nested = {};
	kw_is_ordered = {};
	kw_has_equals = {};
	kw_kind = {};
	kw_len = {};
	kw_libc = {};
	kw_main = {};
	kw_members = {};
	kw_memcmp = {};
	kw_mainstub = {};
	kw_name = {};
	kw_qname = {};
	kw_offset = {};
	kw_ordinal = {};
	kw_default_value = {};
	kw_out = {};
	kw_own = {};
	kw_param_struct = {};
	kw_ptr = {};
	kw_return = {};
	kw_self = {};
	kw_set = {};
	kw_size = {};
	kw_std = {};
	kw_compiler_rt = {};
	kw_std__core = {};
	kw_std__core__types = {};
	kw_std__core__runtime = {};
	kw_std__io = {};
	kw_tags = {};
	kw_type = {};
	kw_typekind = {};
	kw_winmain = {};
	kw_wmain = {};
	kw_FILE_NOT_FOUND = {};
	kw_IoError = {};
}
