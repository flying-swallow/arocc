// Port of the identifier half of c3c src/compiler/symtab.c: `symtab_init`
// (keyword interning plus the `kw_*`, `attribute_list`, `builtin_list`,
// `builtin_defines` and `type_property_list` tables) and the symtab_* entry
// points, on the global `global_symtab` (compiler.c3).
//
// Mechanically converted from c3c symtab.c; keep the order of `symtab_init`
// so the two can be diffed.
//
// Deviations from c3c:
// - `symtab_add(data, len, fnv1hash, type)` is `symtab_add(String, TokenType*)`
//   (symtab::Symtab hashes internally); same for `symtab_find`.
// - The `kw_return` capture from the keyword loop is done after the loop.
// - Chained assignments (`a = b = KW_DEF(..)`) are split.
module aro::frontend::c3::compiler;
import aro::frontend::c3::tokens, aro::frontend::c3::symtab;

String[NUMBER_OF_ATTRIBUTES.ordinal] attribute_list;
String[NUMBER_OF_BUILTINS.ordinal] builtin_list;
String[NUMBER_OF_BUILTIN_DEFINES.ordinal] builtin_defines;
String[NUMBER_OF_TYPE_PROPERTIES.ordinal] type_property_list;

