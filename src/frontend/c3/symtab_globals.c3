String kw_std__core__runtime;
String kw_std__io;
String kw_tags;
String kw_type;
String kw_typekind;
String kw_winmain;
String kw_wmain;
String kw_FILE_NOT_FOUND;
String kw_IoError;

<* c3c `symtab_add`: intern `symbol`; `*type` is replaced by the stored type when it is already known. *>
fn String symtab_add(String symbol, TokenType* type) => global_symtab.add(symbol, type);

<* c3c `symtab_find`: the interned spelling, or a null String when `symbol` was never interned. *>
fn String symtab_find(String symbol, TokenType* type) => global_symtab.find(symbol, type);

<* c3c `symtab_preset`. *>
fn String symtab_preset(String data, TokenType type)
{
	TokenType result = type;
	String res = symtab_add(data, &result);
	assert(result == type);
	return res;
}

<* c3c `KW_DEF`. *>
fn String kw_def(String name, TokenType type)
{
	TokenType t = type;
	return symtab_add(name, &t);
}

<* c3c `symtab_init` (the capacity is advisory: the table grows). *>
fn void symtab_init(uint capacity)
{
	global_symtab.init(mem);
	// Keywords are added by Symtab.init.
	kw_return = symtab_preset(TokenType.RETURN.text, TokenType.RETURN);

	// Init some constant idents
	TokenType type = TokenType.CONST_IDENT;
	builtin_defines[BuiltinDefine.DEF_DATE.ordinal] = kw_def("DATE", type);
	builtin_defines[BuiltinDefine.DEF_FILE.ordinal] = kw_def("FILE", type);
	builtin_defines[BuiltinDefine.DEF_FILEPATH.ordinal] = kw_def("FILEPATH", type);
	builtin_defines[BuiltinDefine.DEF_FUNCTION.ordinal] = kw_def("FUNCTION", type);
	builtin_defines[BuiltinDefine.DEF_FUNC.ordinal] = kw_def("FUNC", type);
	builtin_defines[BuiltinDefine.DEF_LINE.ordinal] = kw_def("LINE", type);
	builtin_defines[BuiltinDefine.DEF_LINE_RAW.ordinal] = kw_def("LINE_RAW", type);
	builtin_defines[BuiltinDefine.DEF_MODULE.ordinal] = kw_def("MODULE", type);
	builtin_defines[BuiltinDefine.DEF_PANIC_FN.ordinal] = kw_def("PANIC_FN", type);
	builtin_defines[BuiltinDefine.DEF_TIME.ordinal] = kw_def("TIME", type);
	builtin_defines[BuiltinDefine.DEF_BENCHMARK_NAMES.ordinal] = kw_def("BENCHMARK_NAMES", type);
	builtin_defines[BuiltinDefine.DEF_BENCHMARK_FNS.ordinal] = kw_def("BENCHMARK_FNS", type);
	builtin_defines[BuiltinDefine.DEF_TEST_NAMES.ordinal] = kw_def("TEST_NAMES", type);
	builtin_defines[BuiltinDefine.DEF_TEST_FNS.ordinal] = kw_def("TEST_FNS", type);
	kw_FILE_NOT_FOUND = kw_def("FILE_NOT_FOUND", type);
	type = TokenType.TYPE_IDENT;
	kw_typekind = kw_def("TypeKind", type);
	type = TokenType.IDENT;
	kw_alignment = kw_def("alignment", type);
	kw_bitoffset = kw_def("bitoffset", type);
	kw_bitsize = kw_def("bitsize", type);
	kw_cname = kw_def("cname", type);
	kw_default_value = kw_def("default_value", type);
	kw_description = kw_def("description", type);
	kw_drop = kw_def("drop", type);
	kw_excuse = kw_def("excuse", type);
	kw_generic_args = kw_def("generic_args", type);
	kw_generic_qname = kw_def("generic_qname", type);
