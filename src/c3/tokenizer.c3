// Port of src/aro/Tokenizer.zig: Token, Token.Id, keyword lookup (getTokenId),
// UCNKind.classify and the Tokenizer state machine (next, nextNoWS,
// nextNoWSComments). Literal decoding (number_literal / text_literal) is a
// separate step and not part of this module.
//
// Deviations from Zig:
// - Zig's labeled `switch` with `continue :loop` maps to C3's labeled
//   `switch LOOP:` with `nextcase LOOP:`.
// - `Token.Id.lexeme` returns `NO_LEXEME~` where Zig returns null.
// - `all_kws` (a StaticStringMap) is a byte-sorted table searched by binary
//   search; `keyword_table_is_sorted` in the tests checks the order.
// - `validPreprocessorExprStart` drops Zig's `.one` / `.zero`, which are not
//   members of Token.Id (Zig never analyzed that function body).
module aro::tokenizer;
import aro::source, aro::lang_opts;

faultdef NO_LEXEME;

<* Value for valid escapes is how many characters to consume, not counting the leading backslash. *>
enum UCNKind : char (uint consumed)
{
	NONE { 0 },       // Just `\`
	INCOMPLETE { 0 }, // \u or \U followed by an insufficient number of hex digits
	HEX4 { 5 },       // `\uxxxx`
	HEX8 { 9 },       // `\Uxxxxxxxx`
}

fn bool is_hex(char c) @private
{
	switch (c)
	{
		case '0'..'9':
		case 'a'..'f':
		case 'A'..'F':
			return true;
		default:
			return false;
	}
}

<*
 In the classification phase we do not care if the escape represents a valid
 universal character name, e.g. \UFFFFFFFF is acceptable.
 @require buf.len > 0 && buf[0] == '\\'
*>
fn UCNKind ucn_classify(String buf)
{
	if (buf.len == 1) return NONE;
	switch (buf[1])
	{
		case 'u':
			if (buf.len < 6) return INCOMPLETE;
			foreach (c : buf[2..5]) if (!is_hex(c)) return INCOMPLETE;
			return HEX4;
		case 'U':
			if (buf.len < 10) return INCOMPLETE;
			foreach (c : buf[2..9]) if (!is_hex(c)) return INCOMPLETE;
			return HEX8;
		default:
			return NONE;
	}
}

struct Token
{
	TokenId id;
	SourceId source;
	uint start;
	uint end;
	uint line;
}

enum TokenId : char
{
	INVALID,
	NL,
	WHITESPACE,
	EOF,
	// identifier containing solely basic character set characters
	IDENTIFIER,
	// identifier with at least one extended character or UCN escape sequence
	EXTENDED_IDENTIFIER,

	// string literals with prefixes
	STRING_LITERAL,
	STRING_LITERAL_UTF_16,
	STRING_LITERAL_UTF_8,
	STRING_LITERAL_UTF_32,
	STRING_LITERAL_WIDE,

	// Any string literal with an embedded newline or EOF
	// Always a parser error; by default just a warning from preprocessor
	UNTERMINATED_STRING_LITERAL,

	// <foobar> only generated by preprocessor
	MACRO_STRING,

	// char literals with prefixes
	CHAR_LITERAL,
	CHAR_LITERAL_UTF_8,
	CHAR_LITERAL_UTF_16,
	CHAR_LITERAL_UTF_32,
	CHAR_LITERAL_WIDE,

	// Any character literal with nothing inside the quotes
	// Always a parser error; by default just a warning from preprocessor
	EMPTY_CHAR_LITERAL,

	// Any character literal with an embedded newline or EOF
	// Always a parser error; by default just a warning from preprocessor
	UNTERMINATED_CHAR_LITERAL,

	// `/* */` style comment without a closing `*/` before EOF
	UNTERMINATED_COMMENT,

	BANG,
	BANG_EQUAL,
	PIPE,
	PIPE_PIPE,
	PIPE_EQUAL,
	EQUAL,
	EQUAL_EQUAL,
	L_PAREN,
	R_PAREN,
	L_BRACE,
	R_BRACE,
	L_BRACKET,
	R_BRACKET,
	PERIOD,
	ELLIPSIS,
	CARET,
	CARET_EQUAL,
	PLUS,
	PLUS_PLUS,
	PLUS_EQUAL,
	MINUS,
	MINUS_MINUS,
	MINUS_EQUAL,
	ASTERISK,
	ASTERISK_EQUAL,
	PERCENT,
	PERCENT_EQUAL,
	ARROW,
	COLON,
	COLON_COLON,
	SEMICOLON,
	SLASH,
	SLASH_EQUAL,
	COMMA,
	AMPERSAND,
	AMPERSAND_AMPERSAND,
	AMPERSAND_EQUAL,
	QUESTION_MARK,
	ANGLE_BRACKET_LEFT,
	ANGLE_BRACKET_LEFT_EQUAL,
	ANGLE_BRACKET_ANGLE_BRACKET_LEFT,
	ANGLE_BRACKET_ANGLE_BRACKET_LEFT_EQUAL,
	ANGLE_BRACKET_RIGHT,
	ANGLE_BRACKET_RIGHT_EQUAL,
	ANGLE_BRACKET_ANGLE_BRACKET_RIGHT,
	ANGLE_BRACKET_ANGLE_BRACKET_RIGHT_EQUAL,
	TILDE,
	HASH,
	HASH_HASH,

	// Special token for handling expansion of parameters to builtin preprocessor functions
	MACRO_PARAM_BUILTIN_FUNC,
	// Special token for implementing builtin object macros
	MACRO_BUILTIN_OBJ,

	// Special token to speed up preprocessing, `loc.end` will be an index to the param list.
	MACRO_PARAM,
	// Special token to signal that the argument must be replaced without expansion (e.g. in concatenation)
	MACRO_PARAM_NO_EXPAND,
	// Special token to speed up preprocessing, `loc.end` will be an index to the param list.
	STRINGIFY_PARAM,
	// Same as stringify_param, but for var args
	STRINGIFY_VA_ARGS,
	// Special macro whitespace, always equal to a single space
	MACRO_WS,

	// Special identifier for implementing __func__
	MACRO_FUNC,
	// Special identifier for implementing __FUNCTION__
	MACRO_FUNCTION,
	// Special identifier for implementing __PRETTY_FUNCTION__
	MACRO_PRETTY_FUNC,

	KEYWORD_AUTO,
	KEYWORD_AUTO_TYPE,
	KEYWORD_BREAK,
	KEYWORD_CASE,
	KEYWORD_CHAR,
	KEYWORD_CONST,
	KEYWORD_CONTINUE,
	KEYWORD_DEFAULT,
	KEYWORD_DO,
	KEYWORD_DOUBLE,
	KEYWORD_ELSE,
	KEYWORD_ENUM,
	KEYWORD_EXTERN,
	KEYWORD_FLOAT,
	KEYWORD_FOR,
	KEYWORD_GOTO,
	KEYWORD_IF,
	KEYWORD_INT,
	KEYWORD_LONG,
	KEYWORD_REGISTER,
	KEYWORD_RETURN,
	KEYWORD_SHORT,
	KEYWORD_SIGNED,
	KEYWORD_SIGNED1,
	KEYWORD_SIGNED2,
	KEYWORD_SIZEOF,
	KEYWORD_STATIC,
	KEYWORD_STRUCT,
	KEYWORD_SWITCH,
	KEYWORD_TYPEDEF,
	KEYWORD_TYPEOF1,
	KEYWORD_TYPEOF2,
	KEYWORD_UNION,
	KEYWORD_UNSIGNED,
	KEYWORD_VOID,
	KEYWORD_VOLATILE,
	KEYWORD_WHILE,

	// ISO C99
	KEYWORD_BOOL,
	KEYWORD_COMPLEX,
	KEYWORD_IMAGINARY,
	KEYWORD_INLINE,
	KEYWORD_RESTRICT,

	// ISO C11
	KEYWORD_ALIGNAS,
	KEYWORD_ALIGNOF,
	KEYWORD_ATOMIC,
	KEYWORD_GENERIC,
	KEYWORD_NORETURN,
	KEYWORD_STATIC_ASSERT,
	KEYWORD_THREAD_LOCAL,

	// ISO C23
	KEYWORD_BIT_INT,
	KEYWORD_C23_ALIGNAS,
	KEYWORD_C23_ALIGNOF,
	KEYWORD_C23_BOOL,
	KEYWORD_C23_STATIC_ASSERT,
	KEYWORD_C23_THREAD_LOCAL,
	KEYWORD_CONSTEXPR,
	KEYWORD_TRUE,
	KEYWORD_FALSE,
	KEYWORD_NULLPTR,
	KEYWORD_TYPEOF_UNQUAL,
	KEYWORD_FLOAT16,
	KEYWORD_FLOAT32,
	KEYWORD_FLOAT64,
	KEYWORD_FLOAT128,
	KEYWORD_FLOAT32X,
	KEYWORD_FLOAT64X,
	KEYWORD_FLOAT128X,
	KEYWORD_DFLOAT32,
	KEYWORD_DFLOAT64,
	KEYWORD_DFLOAT128,
	KEYWORD_DFLOAT64X,

	// ISO C2y
	KEYWORD_COUNTOF,

	// Preprocessor directives
	KEYWORD_INCLUDE,
	KEYWORD_INCLUDE_NEXT,
	KEYWORD_EMBED,
	KEYWORD_DEFINE,
	KEYWORD_DEFINED,
	KEYWORD_UNDEF,
	KEYWORD_IFDEF,
	KEYWORD_IFNDEF,
	KEYWORD_ELIF,
	KEYWORD_ELIFDEF,
	KEYWORD_ELIFNDEF,
	KEYWORD_ENDIF,
	KEYWORD_ERROR,
	KEYWORD_WARNING,
	KEYWORD_PRAGMA,
	KEYWORD_LINE,
	KEYWORD_VA_ARGS,
	KEYWORD_VA_OPT,

	// gcc keywords
	KEYWORD_CONST1,
	KEYWORD_CONST2,
	KEYWORD_INLINE1,
	KEYWORD_INLINE2,
	KEYWORD_VOLATILE1,
	KEYWORD_VOLATILE2,
	KEYWORD_RESTRICT1,
	KEYWORD_RESTRICT2,
	KEYWORD_ALIGNOF1,
	KEYWORD_ALIGNOF2,
	KEYWORD_TYPEOF,
	KEYWORD_ATTRIBUTE1,
	KEYWORD_ATTRIBUTE2,
	KEYWORD_EXTENSION,
	KEYWORD_ASM,
	KEYWORD_ASM1,
	KEYWORD_ASM2,
	KEYWORD_THREAD,
	// __float128
	KEYWORD_FLOAT128_1,
	KEYWORD_INT24,
	KEYWORD_INT128,
	KEYWORD_IMAG1,
	KEYWORD_IMAG2,
	KEYWORD_REAL1,
	KEYWORD_REAL2,

	// clang keywords
	KEYWORD_FP16,
	KEYWORD_BF16,

	// ms keywords
	KEYWORD_DECLSPEC,
	KEYWORD_INT64,
	KEYWORD_INT64_2,
	KEYWORD_INT32,
	KEYWORD_INT32_2,
	KEYWORD_INT16,
	KEYWORD_INT16_2,
	KEYWORD_INT8,
	KEYWORD_INT8_2,
	KEYWORD_STDCALL,
	KEYWORD_STDCALL2,
	KEYWORD_THISCALL,
	KEYWORD_THISCALL2,
	KEYWORD_VECTORCALL,
	KEYWORD_VECTORCALL2,
	KEYWORD_FASTCALL,
	KEYWORD_FASTCALL2,
	KEYWORD_REGCALL,
	KEYWORD_CDECL,
	KEYWORD_CDECL2,
	KEYWORD_FORCEINLINE,
	KEYWORD_FORCEINLINE2,
	KEYWORD_UNALIGNED,
	KEYWORD_UNALIGNED2,
	KEYWORD_PTR64,
	KEYWORD_PTR32,
	KEYWORD_SPTR,
	KEYWORD_UPTR,

	// Type nullability
	KEYWORD_NONNULL,
	KEYWORD_NULLABLE,
	KEYWORD_NULLABLE_RESULT,
	KEYWORD_NULL_UNSPECIFIED,

	// Generated by #embed directive
	// Decimal value with no prefix or suffix
	EMBED_BYTE,

	// preprocessor number
	// An optional period, followed by a digit 0-9, followed by any number of letters
	// digits, underscores, periods, and exponents (e+, e-, E+, E-, p+, p-, P+, P-)
	PP_NUM,

	// preprocessor placemarker token
	// generated if `##` is used with a zero-token argument
	// removed after substitution, so the parser should never see this
	// See C99 6.10.3.3.2
	PLACEMARKER,

	// Virtual linemarker token output from preprocessor to indicate start of a new include
	INCLUDE_START,

	// Virtual linemarker token output from preprocessor to indicate resuming a file after
	// completion of the preceding #include
	INCLUDE_RESUME,

	// Virtual linemarker token output from preprocessor to represent actual linemarker in the source file
	LINEMARKER,

	// A comment token if asked to preserve comments.
	COMMENT,

	// Incomplete universal character name
	// This happens if the source text contains `\u` or `\U` followed by an insufficient number of hex
	// digits. This token id represents just the backslash; the subsequent `u` or `U` will be treated as the
	// leading character of the following identifier token.
	INCOMPLETE_UCN,
}

<* Return true if token is identifier or keyword. *>
fn bool TokenId.is_macro_identifier(self)
{
	switch (self)
	{
		case KEYWORD_INCLUDE:
		case KEYWORD_INCLUDE_NEXT:
		case KEYWORD_EMBED:
		case KEYWORD_DEFINE:
		case KEYWORD_DEFINED:
		case KEYWORD_UNDEF:
		case KEYWORD_IFDEF:
		case KEYWORD_IFNDEF:
		case KEYWORD_ELIF:
		case KEYWORD_ELIFDEF:
		case KEYWORD_ELIFNDEF:
		case KEYWORD_ENDIF:
		case KEYWORD_ERROR:
		case KEYWORD_WARNING:
		case KEYWORD_PRAGMA:
		case KEYWORD_LINE:
		case KEYWORD_VA_ARGS:
		case KEYWORD_VA_OPT:
		case MACRO_FUNC:
		case MACRO_FUNCTION:
		case MACRO_PRETTY_FUNC:
		case KEYWORD_AUTO:
		case KEYWORD_AUTO_TYPE:
		case KEYWORD_BREAK:
		case KEYWORD_CASE:
		case KEYWORD_CHAR:
		case KEYWORD_CONST:
		case KEYWORD_CONTINUE:
		case KEYWORD_DEFAULT:
		case KEYWORD_DO:
		case KEYWORD_DOUBLE:
		case KEYWORD_ELSE:
		case KEYWORD_ENUM:
		case KEYWORD_EXTERN:
		case KEYWORD_FLOAT:
		case KEYWORD_FOR:
		case KEYWORD_GOTO:
		case KEYWORD_IF:
		case KEYWORD_INT:
		case KEYWORD_LONG:
		case KEYWORD_REGISTER:
		case KEYWORD_RETURN:
		case KEYWORD_SHORT:
		case KEYWORD_SIGNED:
		case KEYWORD_SIGNED1:
		case KEYWORD_SIGNED2:
		case KEYWORD_SIZEOF:
		case KEYWORD_STATIC:
		case KEYWORD_STRUCT:
		case KEYWORD_SWITCH:
		case KEYWORD_TYPEDEF:
		case KEYWORD_UNION:
		case KEYWORD_UNSIGNED:
		case KEYWORD_VOID:
		case KEYWORD_VOLATILE:
		case KEYWORD_WHILE:
		case KEYWORD_BOOL:
		case KEYWORD_COMPLEX:
		case KEYWORD_IMAGINARY:
		case KEYWORD_INLINE:
		case KEYWORD_RESTRICT:
		case KEYWORD_ALIGNAS:
		case KEYWORD_ALIGNOF:
		case KEYWORD_ATOMIC:
		case KEYWORD_GENERIC:
		case KEYWORD_NORETURN:
		case KEYWORD_STATIC_ASSERT:
		case KEYWORD_THREAD_LOCAL:
		case KEYWORD_THREAD:
		case IDENTIFIER:
		case EXTENDED_IDENTIFIER:
		case KEYWORD_TYPEOF:
		case KEYWORD_TYPEOF1:
		case KEYWORD_TYPEOF2:
		case KEYWORD_CONST1:
		case KEYWORD_CONST2:
		case KEYWORD_INLINE1:
		case KEYWORD_INLINE2:
		case KEYWORD_VOLATILE1:
		case KEYWORD_VOLATILE2:
		case KEYWORD_RESTRICT1:
		case KEYWORD_RESTRICT2:
		case KEYWORD_ALIGNOF1:
		case KEYWORD_ALIGNOF2:
		case KEYWORD_ATTRIBUTE1:
		case KEYWORD_ATTRIBUTE2:
		case KEYWORD_EXTENSION:
		case KEYWORD_ASM:
		case KEYWORD_ASM1:
		case KEYWORD_ASM2:
		case KEYWORD_FLOAT128_1:
		case KEYWORD_INT24:
		case KEYWORD_INT128:
		case KEYWORD_IMAG1:
		case KEYWORD_IMAG2:
		case KEYWORD_REAL1:
		case KEYWORD_REAL2:
		case KEYWORD_FLOAT16:
		case KEYWORD_FP16:
		case KEYWORD_BF16:
		case KEYWORD_DECLSPEC:
		case KEYWORD_INT64:
		case KEYWORD_INT64_2:
		case KEYWORD_INT32:
		case KEYWORD_INT32_2:
		case KEYWORD_INT16:
		case KEYWORD_INT16_2:
		case KEYWORD_INT8:
		case KEYWORD_INT8_2:
		case KEYWORD_STDCALL:
		case KEYWORD_STDCALL2:
		case KEYWORD_THISCALL:
		case KEYWORD_THISCALL2:
		case KEYWORD_VECTORCALL:
		case KEYWORD_VECTORCALL2:
		case KEYWORD_FASTCALL:
		case KEYWORD_FASTCALL2:
		case KEYWORD_REGCALL:
		case KEYWORD_CDECL:
		case KEYWORD_CDECL2:
		case KEYWORD_FORCEINLINE:
		case KEYWORD_FORCEINLINE2:
		case KEYWORD_UNALIGNED:
		case KEYWORD_UNALIGNED2:
		case KEYWORD_PTR64:
		case KEYWORD_PTR32:
		case KEYWORD_SPTR:
		case KEYWORD_UPTR:
		case KEYWORD_NONNULL:
		case KEYWORD_NULLABLE:
		case KEYWORD_NULLABLE_RESULT:
		case KEYWORD_NULL_UNSPECIFIED:
		case KEYWORD_BIT_INT:
		case KEYWORD_C23_ALIGNAS:
		case KEYWORD_C23_ALIGNOF:
		case KEYWORD_C23_BOOL:
		case KEYWORD_C23_STATIC_ASSERT:
		case KEYWORD_C23_THREAD_LOCAL:
		case KEYWORD_CONSTEXPR:
		case KEYWORD_TRUE:
		case KEYWORD_FALSE:
		case KEYWORD_NULLPTR:
		case KEYWORD_TYPEOF_UNQUAL:
		case KEYWORD_FLOAT32:
		case KEYWORD_FLOAT64:
		case KEYWORD_FLOAT128:
		case KEYWORD_FLOAT32X:
		case KEYWORD_FLOAT64X:
		case KEYWORD_FLOAT128X:
		case KEYWORD_DFLOAT32:
		case KEYWORD_DFLOAT64:
		case KEYWORD_DFLOAT128:
		case KEYWORD_DFLOAT64X:
		case KEYWORD_COUNTOF:
			return true;
		default:
			return false;
	}
}

<*
 Turn macro keywords into identifiers.
 `KEYWORD_DEFINED` is special since it should only turn into an identifier if
 we are *not* in an #if or #elif expression.
*>
fn void TokenId.simplify_macro_keyword_extra(&self, bool defined_to_identifier)
{
	switch (*self)
	{
		case KEYWORD_INCLUDE:
		case KEYWORD_INCLUDE_NEXT:
		case KEYWORD_EMBED:
		case KEYWORD_DEFINE:
		case KEYWORD_UNDEF:
		case KEYWORD_IFDEF:
		case KEYWORD_IFNDEF:
		case KEYWORD_ELIF:
		case KEYWORD_ELIFDEF:
		case KEYWORD_ELIFNDEF:
		case KEYWORD_ENDIF:
		case KEYWORD_ERROR:
		case KEYWORD_WARNING:
		case KEYWORD_PRAGMA:
		case KEYWORD_LINE:
		case KEYWORD_VA_ARGS:
		case KEYWORD_VA_OPT:
			*self = IDENTIFIER;
		case KEYWORD_DEFINED:
			if (defined_to_identifier) *self = IDENTIFIER;
		default:
			break;
	}
}

fn void TokenId.simplify_macro_keyword(&self) => self.simplify_macro_keyword_extra(false);

<*
 The fixed spelling of a token, or NO_LEXEME~ for tokens whose text varies.
 @require self != INCLUDE_START && self != INCLUDE_RESUME && self != LINEMARKER
*>
fn String? TokenId.lexeme(self)
{
	switch (self)
	{
		case INCLUDE_START:
		case INCLUDE_RESUME:
		case LINEMARKER:
			unreachable("lexeme of a virtual linemarker token");
		case UNTERMINATED_COMMENT:
		case INVALID:
		case IDENTIFIER:
		case EXTENDED_IDENTIFIER:
		case STRING_LITERAL:
		case STRING_LITERAL_UTF_16:
		case STRING_LITERAL_UTF_8:
		case STRING_LITERAL_UTF_32:
		case STRING_LITERAL_WIDE:
		case UNTERMINATED_STRING_LITERAL:
		case UNTERMINATED_CHAR_LITERAL:
		case EMPTY_CHAR_LITERAL:
		case CHAR_LITERAL:
		case CHAR_LITERAL_UTF_8:
		case CHAR_LITERAL_UTF_16:
		case CHAR_LITERAL_UTF_32:
		case CHAR_LITERAL_WIDE:
		case MACRO_STRING:
		case WHITESPACE:
		case PP_NUM:
		case EMBED_BYTE:
		case COMMENT:
			return NO_LEXEME~;
		case NL:
		case EOF:
		case MACRO_PARAM:
		case MACRO_PARAM_NO_EXPAND:
		case STRINGIFY_PARAM:
		case STRINGIFY_VA_ARGS:
		case PLACEMARKER:
		case MACRO_PARAM_BUILTIN_FUNC:
		case MACRO_BUILTIN_OBJ:
			return "";
		case MACRO_WS: return " ";
		case INCOMPLETE_UCN: return "\\";
		case MACRO_FUNC: return "__func__";
		case MACRO_FUNCTION: return "__FUNCTION__";
		case MACRO_PRETTY_FUNC: return "__PRETTY_FUNCTION__";
		case BANG: return "!";
		case BANG_EQUAL: return "!=";
		case PIPE: return "|";
		case PIPE_PIPE: return "||";
		case PIPE_EQUAL: return "|=";
		case EQUAL: return "=";
		case EQUAL_EQUAL: return "==";
		case L_PAREN: return "(";
		case R_PAREN: return ")";
		case L_BRACE: return "{";
		case R_BRACE: return "}";
		case L_BRACKET: return "[";
		case R_BRACKET: return "]";
		case PERIOD: return ".";
		case ELLIPSIS: return "...";
		case CARET: return "^";
		case CARET_EQUAL: return "^=";
		case PLUS: return "+";
		case PLUS_PLUS: return "++";
		case PLUS_EQUAL: return "+=";
		case MINUS: return "-";
		case MINUS_MINUS: return "--";
		case MINUS_EQUAL: return "-=";
		case ASTERISK: return "*";
		case ASTERISK_EQUAL: return "*=";
		case PERCENT: return "%";
		case PERCENT_EQUAL: return "%=";
		case ARROW: return "->";
		case COLON: return ":";
		case COLON_COLON: return "::";
		case SEMICOLON: return ";";
		case SLASH: return "/";
		case SLASH_EQUAL: return "/=";
		case COMMA: return ",";
		case AMPERSAND: return "&";
		case AMPERSAND_AMPERSAND: return "&&";
		case AMPERSAND_EQUAL: return "&=";
		case QUESTION_MARK: return "?";
		case ANGLE_BRACKET_LEFT: return "<";
		case ANGLE_BRACKET_LEFT_EQUAL: return "<=";
		case ANGLE_BRACKET_ANGLE_BRACKET_LEFT: return "<<";
		case ANGLE_BRACKET_ANGLE_BRACKET_LEFT_EQUAL: return "<<=";
		case ANGLE_BRACKET_RIGHT: return ">";
		case ANGLE_BRACKET_RIGHT_EQUAL: return ">=";
		case ANGLE_BRACKET_ANGLE_BRACKET_RIGHT: return ">>";
		case ANGLE_BRACKET_ANGLE_BRACKET_RIGHT_EQUAL: return ">>=";
		case TILDE: return "~";
		case HASH: return "#";
		case HASH_HASH: return "##";
		case KEYWORD_AUTO: return "auto";
		case KEYWORD_AUTO_TYPE: return "__auto_type";
		case KEYWORD_BREAK: return "break";
		case KEYWORD_CASE: return "case";
		case KEYWORD_CHAR: return "char";
		case KEYWORD_CONST: return "const";
		case KEYWORD_CONTINUE: return "continue";
		case KEYWORD_DEFAULT: return "default";
		case KEYWORD_DO: return "do";
		case KEYWORD_DOUBLE: return "double";
		case KEYWORD_ELSE: return "else";
		case KEYWORD_ENUM: return "enum";
		case KEYWORD_EXTERN: return "extern";
		case KEYWORD_FLOAT: return "float";
		case KEYWORD_FOR: return "for";
		case KEYWORD_GOTO: return "goto";
		case KEYWORD_IF: return "if";
		case KEYWORD_INT: return "int";
		case KEYWORD_LONG: return "long";
		case KEYWORD_REGISTER: return "register";
		case KEYWORD_RETURN: return "return";
		case KEYWORD_SHORT: return "short";
		case KEYWORD_SIGNED: return "signed";
		case KEYWORD_SIGNED1: return "__signed";
		case KEYWORD_SIGNED2: return "__signed__";
		case KEYWORD_SIZEOF: return "sizeof";
		case KEYWORD_STATIC: return "static";
		case KEYWORD_STRUCT: return "struct";
		case KEYWORD_SWITCH: return "switch";
		case KEYWORD_TYPEDEF: return "typedef";
		case KEYWORD_TYPEOF: return "typeof";
		case KEYWORD_UNION: return "union";
		case KEYWORD_UNSIGNED: return "unsigned";
		case KEYWORD_VOID: return "void";
		case KEYWORD_VOLATILE: return "volatile";
		case KEYWORD_WHILE: return "while";
		case KEYWORD_BOOL: return "_Bool";
		case KEYWORD_COMPLEX: return "_Complex";
		case KEYWORD_IMAGINARY: return "_Imaginary";
		case KEYWORD_INLINE: return "inline";
		case KEYWORD_RESTRICT: return "restrict";
		case KEYWORD_ALIGNAS: return "_Alignas";
		case KEYWORD_ALIGNOF: return "_Alignof";
		case KEYWORD_ATOMIC: return "_Atomic";
		case KEYWORD_GENERIC: return "_Generic";
		case KEYWORD_NORETURN: return "_Noreturn";
		case KEYWORD_STATIC_ASSERT: return "_Static_assert";
		case KEYWORD_THREAD_LOCAL: return "_Thread_local";
		case KEYWORD_THREAD: return "__thread";
		case KEYWORD_BIT_INT: return "_BitInt";
		case KEYWORD_C23_ALIGNAS: return "alignas";
		case KEYWORD_C23_ALIGNOF: return "alignof";
