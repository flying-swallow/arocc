fn String TokenId.symbol(self)
{
	switch (self)
	{
		case MACRO_STRING:
			unreachable("symbol of a macro string");
		case INVALID:
			return "invalid bytes";
		case IDENTIFIER:
		case EXTENDED_IDENTIFIER:
		case MACRO_FUNC:
		case MACRO_FUNCTION:
		case MACRO_PRETTY_FUNC:
			return "an identifier";
		case STRING_LITERAL:
		case STRING_LITERAL_UTF_16:
		case STRING_LITERAL_UTF_8:
		case STRING_LITERAL_UTF_32:
		case STRING_LITERAL_WIDE:
		case UNTERMINATED_STRING_LITERAL:
			return "a string literal";
		case CHAR_LITERAL:
		case CHAR_LITERAL_UTF_8:
		case CHAR_LITERAL_UTF_16:
		case CHAR_LITERAL_UTF_32:
		case CHAR_LITERAL_WIDE:
		case UNTERMINATED_CHAR_LITERAL:
		case EMPTY_CHAR_LITERAL:
			return "a character literal";
		case PP_NUM:
		case EMBED_BYTE:
			return "a number";
		default:
			return self.lexeme()!!;
	}
}

<*
 Tokens that can start an expression parsed by Preprocessor.expr.
 eof, r_paren and string literals cannot actually start a preprocessor
 expression, but they are included so the parser can give a nicer error.
*>
fn bool TokenId.valid_preprocessor_expr_start(self)
{
	switch (self)
	{
		case EOF:
		case R_PAREN:
		case STRING_LITERAL:
		case STRING_LITERAL_UTF_16:
		case STRING_LITERAL_UTF_8:
		case STRING_LITERAL_UTF_32:
		case STRING_LITERAL_WIDE:
		case CHAR_LITERAL:
		case CHAR_LITERAL_UTF_8:
		case CHAR_LITERAL_UTF_16:
		case CHAR_LITERAL_UTF_32:
		case CHAR_LITERAL_WIDE:
		case L_PAREN:
		case PLUS:
		case MINUS:
		case TILDE:
		case BANG:
		case IDENTIFIER:
		case EXTENDED_IDENTIFIER:
		case KEYWORD_DEFINED:
		case PP_NUM:
		case KEYWORD_TRUE:
		case KEYWORD_FALSE:
			return true;
		default:
			return false;
	}
}

fn bool TokenId.allows_digraphs(self, LangOpts langopts)
{
	switch (self)
	{
		case L_BRACKET:
		case R_BRACKET:
		case L_BRACE:
		case R_BRACE:
		case HASH:
		case HASH_HASH:
			return langopts.has_digraphs();
		default:
			return false;
	}
}

fn bool TokenId.can_open_gcc_asm_stmt(self)
{
	switch (self)
	{
		case KEYWORD_VOLATILE:
		case KEYWORD_VOLATILE1:
		case KEYWORD_VOLATILE2:
		case KEYWORD_INLINE:
		case KEYWORD_INLINE1:
		case KEYWORD_INLINE2:
		case KEYWORD_GOTO:
		case L_PAREN:
			return true;
		default:
			return false;
	}
}

fn bool TokenId.is_string_literal(self)
{
	switch (self)
	{
		case STRING_LITERAL:
		case STRING_LITERAL_UTF_16:
		case STRING_LITERAL_UTF_8:
		case STRING_LITERAL_UTF_32:
		case STRING_LITERAL_WIDE:
			return true;
		default:
			return false;
	}
}

enum HidesetContext : char
{
	FUNC,
	OBJ,
}

fn bool TokenId.should_track_hideset(self, HidesetContext context)
{
	if (self.is_macro_identifier()) return true;
	return self == R_PAREN && context == FUNC;
}

struct Keyword
{
	String name;
	TokenId id;
}

