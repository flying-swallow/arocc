		case 0x09DF..0x09E3:
		case 0x09F0..0x09F1:
		case 0x0A02: // Gurmukhi
		case 0x0A05..0x0A0A:
		case 0x0A0F..0x0A10:
		case 0x0A13..0x0A28:
		case 0x0A2A..0x0A30:
		case 0x0A32..0x0A33:
		case 0x0A35..0x0A36:
		case 0x0A38..0x0A39:
		case 0x0A3E..0x0A42:
		case 0x0A47..0x0A48:
		case 0x0A4B..0x0A4D:
