// Port of src/aro/char_info.zig.
// Classifies characters according to various C standards. No routine here
// considers characters from the basic character set; callers check those
// separately (every function requires codepoint > 0x7F where Zig asserts it).
// is_xid_start / is_xid_continue are adapted from https://github.com/dtolnay/unicode-ident
// and read the generated Unicode tables in identifier_tables.c3 (LICENSE-UNICODE).
module aro::char_info;
import aro::identifier_tables;

<*
 C11 Standard Annex D
 @require codepoint > 0x7F
*>
fn bool is_c11_id_char(uint codepoint)
{
	switch (codepoint)
	{
		case 0x00A8: // 1
		case 0x00AA:
		case 0x00AD:
		case 0x00AF:
		case 0x00B2..0x00B5:
		case 0x00B7..0x00BA:
		case 0x00BC..0x00BE:
		case 0x00C0..0x00D6:
		case 0x00D8..0x00F6:
		case 0x00F8..0x00FF:
		case 0x0100..0x167F: // 2
		case 0x1681..0x180D:
		case 0x180F..0x1FFF:
		case 0x200B..0x200D: // 3
		case 0x202A..0x202E:
		case 0x203F..0x2040:
		case 0x2054:
		case 0x2060..0x206F:
		case 0x2070..0x218F: // 4
		case 0x2460..0x24FF:
		case 0x2776..0x2793:
		case 0x2C00..0x2DFF:
		case 0x2E80..0x2FFF:
		case 0x3004..0x3007: // 5
		case 0x3021..0x302F:
		case 0x3031..0x303F:
		case 0x3040..0xD7FF: // 6
		case 0xF900..0xFD3D: // 7
		case 0xFD40..0xFDCF:
		case 0xFDF0..0xFE44:
		case 0xFE47..0xFFFD:
		case 0x10000..0x1FFFD: // 8
		case 0x20000..0x2FFFD:
		case 0x30000..0x3FFFD:
		case 0x40000..0x4FFFD:
		case 0x50000..0x5FFFD:
		case 0x60000..0x6FFFD:
		case 0x70000..0x7FFFD:
		case 0x80000..0x8FFFD:
		case 0x90000..0x9FFFD:
		case 0xA0000..0xAFFFD:
		case 0xB0000..0xBFFFD:
		case 0xC0000..0xCFFFD:
		case 0xD0000..0xDFFFD:
		case 0xE0000..0xEFFFD:
			return true;
		default:
			return false;
	}
}

<*
 C99 Standard Annex D
 @require codepoint > 0x7F
*>
fn bool is_c99_id_char(uint codepoint)
{
	switch (codepoint)
	{
		case 0x00AA: // Latin
		case 0x00BA:
		case 0x00C0..0x00D6:
		case 0x00D8..0x00F6:
		case 0x00F8..0x01F5:
		case 0x01FA..0x0217:
		case 0x0250..0x02A8:
		case 0x1E00..0x1E9B:
		case 0x1EA0..0x1EF9:
		case 0x207F:
		case 0x0386: // Greek
		case 0x0388..0x038A:
		case 0x038C:
		case 0x038E..0x03A1:
		case 0x03A3..0x03CE:
		case 0x03D0..0x03D6:
		case 0x03DA:
		case 0x03DC:
		case 0x03DE:
		case 0x03E0:
		case 0x03E2..0x03F3:
		case 0x1F00..0x1F15:
		case 0x1F18..0x1F1D:
		case 0x1F20..0x1F45:
		case 0x1F48..0x1F4D:
		case 0x1F50..0x1F57:
		case 0x1F59:
		case 0x1F5B:
		case 0x1F5D:
		case 0x1F5F..0x1F7D:
		case 0x1F80..0x1FB4:
		case 0x1FB6..0x1FBC:
		case 0x1FC2..0x1FC4:
		case 0x1FC6..0x1FCC:
		case 0x1FD0..0x1FD3:
		case 0x1FD6..0x1FDB:
		case 0x1FE0..0x1FEC:
		case 0x1FF2..0x1FF4:
		case 0x1FF6..0x1FFC:
		case 0x0401..0x040C: // Cyrillic
		case 0x040E..0x044F:
		case 0x0451..0x045C:
		case 0x045E..0x0481:
		case 0x0490..0x04C4:
		case 0x04C7..0x04C8:
		case 0x04CB..0x04CC:
		case 0x04D0..0x04EB:
		case 0x04EE..0x04F5:
		case 0x04F8..0x04F9:
		case 0x0531..0x0556: // Armenian
		case 0x0561..0x0587:
