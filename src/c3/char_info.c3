		case 0x0F99..0x0FAD:
		case 0x0FB1..0x0FB7:
		case 0x0FB9:
		case 0x10A0..0x10C5: // Georgian
		case 0x10D0..0x10F6:
		case 0x3041..0x3093: // Hiragana
		case 0x309B..0x309C:
		case 0x30A1..0x30F6: // Katakana
		case 0x30FB..0x30FC:
		case 0x3105..0x312C: // Bopomofo
		case 0x4E00..0x9FA5: // CJK Unified Ideographs
		case 0xAC00..0xD7A3: // Hangul
		case 0x0660..0x0669: // Digits
		case 0x06F0..0x06F9:
		case 0x0966..0x096F:
		case 0x09E6..0x09EF:
		case 0x0A66..0x0A6F:
		case 0x0AE6..0x0AEF:
		case 0x0B66..0x0B6F:
		case 0x0BE7..0x0BEF:
		case 0x0C66..0x0C6F:
		case 0x0CE6..0x0CEF:
		case 0x0D66..0x0D6F:
		case 0x0E50..0x0E59:
		case 0x0ED0..0x0ED9:
		case 0x0F20..0x0F33:
		case 0x00B5: // Special characters
		case 0x00B7:
		case 0x02B0..0x02B8:
		case 0x02BB:
		case 0x02BD..0x02C1:
		case 0x02D0..0x02D1:
		case 0x02E0..0x02E4:
		case 0x037A:
		case 0x0559:
		case 0x093D:
		case 0x0B3D:
		case 0x1FBE:
