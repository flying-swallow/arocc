		case 0x06E5..0x06E8:
		case 0x06EA..0x06ED:
		case 0x0901..0x0903: // Devanagari
		case 0x0905..0x0939:
		case 0x093E..0x094D:
		case 0x0950..0x0952:
		case 0x0958..0x0963:
