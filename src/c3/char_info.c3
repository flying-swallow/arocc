		case 0x2133..0x2138:
		case 0x2160..0x2182:
		case 0x3005..0x3007:
		case 0x3021..0x3029:
			return true;
		default:
			return false;
	}
}

<*
 C11 standard Annex D
 @require codepoint > 0x7F
*>
fn bool is_c11_disallowed_initial_id_char(uint codepoint)
{
	switch (codepoint)
	{
		case 0x0300..0x036F:
		case 0x1DC0..0x1DFF:
		case 0x20D0..0x20FF:
		case 0xFE20..0xFE2F:
			return true;
		default:
			return false;
	}
}

<*
 These are "digit" characters; C99 disallows them as the first character of an identifier
 @require codepoint > 0x7F
*>
fn bool is_c99_disallowed_initial_id_char(uint codepoint)
{
	switch (codepoint)
	{
		case 0x0660..0x0669:
		case 0x06F0..0x06F9:
		case 0x0966..0x096F:
		case 0x09E6..0x09EF:
		case 0x0A66..0x0A6F:
		case 0x0AE6..0x0AEF:
		case 0x0B66..0x0B6F:
		case 0x0BE7..0x0BEF:
		case 0x0C66..0x0C6F:
		case 0x0CE6..0x0CEF:
		case 0x0D66..0x0D6F:
		case 0x0E50..0x0E59:
		case 0x0ED0..0x0ED9:
		case 0x0F20..0x0F33:
			return true;
		default:
			return false;
	}
}

<*
 @require codepoint > 0x7F
*>
fn bool is_invisible(uint codepoint)
{
	switch (codepoint)
	{
		case 0x00ad: // SOFT HYPHEN
		case 0x200b: // ZERO WIDTH SPACE
		case 0x200c: // ZERO WIDTH NON-JOINER
		case 0x200d: // ZERO WIDTH JOINER
		case 0x2060: // WORD JOINER
		case 0x2061: // FUNCTION APPLICATION
		case 0x2062: // INVISIBLE TIMES
		case 0x2063: // INVISIBLE SEPARATOR
		case 0x2064: // INVISIBLE PLUS
		case 0xfeff: // ZERO WIDTH NO-BREAK SPACE
			return true;
		default:
			return false;
	}
}

<*
 Checks for identifier characters which resemble non-identifier characters.
 Returns "" when the codepoint is not a homoglyph (Zig returns null).
 @require codepoint > 0x7F
*>
fn String homoglyph(uint codepoint)
{
	switch (codepoint)
	{
		case 0x01c3:
			return "!"; // LATIN LETTER RETROFLEX CLICK
		case 0x037e:
			return ";"; // GREEK QUESTION MARK
		case 0x2212:
			return "-"; // MINUS SIGN
		case 0x2215:
			return "/"; // DIVISION SLASH
		case 0x2216:
			return "\\"; // SET MINUS
		case 0x2217:
			return "*"; // ASTERISK OPERATOR
		case 0x2223:
			return "|"; // DIVIDES
		case 0x2227:
			return "^"; // LOGICAL AND
		case 0x2236:
			return ":"; // RATIO
		case 0x223c:
			return "~"; // TILDE OPERATOR
		case 0xa789:
			return ":"; // MODIFIER LETTER COLON
		case 0xff01:
			return "!"; // FULLWIDTH EXCLAMATION MARK
		case 0xff03:
			return "#"; // FULLWIDTH NUMBER SIGN
		case 0xff04:
			return "$"; // FULLWIDTH DOLLAR SIGN
		case 0xff05:
			return "%"; // FULLWIDTH PERCENT SIGN
		case 0xff06:
			return "&"; // FULLWIDTH AMPERSAND
		case 0xff08:
			return "("; // FULLWIDTH LEFT PARENTHESIS
		case 0xff09:
			return ")"; // FULLWIDTH RIGHT PARENTHESIS
		case 0xff0a:
			return "*"; // FULLWIDTH ASTERISK
		case 0xff0b:
			return "+"; // FULLWIDTH ASTERISK
		case 0xff0c:
			return ","; // FULLWIDTH COMMA
		case 0xff0d:
			return "-"; // FULLWIDTH HYPHEN-MINUS
		case 0xff0e:
			return "."; // FULLWIDTH FULL STOP
		case 0xff0f:
			return "/"; // FULLWIDTH SOLIDUS
		case 0xff1a:
			return ":"; // FULLWIDTH COLON
		case 0xff1b:
			return ";"; // FULLWIDTH SEMICOLON
		case 0xff1c:
			return "<"; // FULLWIDTH LESS-THAN SIGN
		case 0xff1d:
			return "="; // FULLWIDTH EQUALS SIGN
		case 0xff1e:
			return ">"; // FULLWIDTH GREATER-THAN SIGN
		case 0xff1f:
			return "?"; // FULLWIDTH QUESTION MARK
		case 0xff20:
			return "@"; // FULLWIDTH COMMERCIAL AT
		case 0xff3b:
			return "["; // FULLWIDTH LEFT SQUARE BRACKET
		case 0xff3c:
			return "\\"; // FULLWIDTH REVERSE SOLIDUS
		case 0xff3d:
			return "]"; // FULLWIDTH RIGHT SQUARE BRACKET
		case 0xff3e:
			return "^"; // FULLWIDTH CIRCUMFLEX ACCENT
		case 0xff5b:
			return "{"; // FULLWIDTH LEFT CURLY BRACKET
		case 0xff5c:
			return "|"; // FULLWIDTH VERTICAL LINE
		case 0xff5d:
			return "}"; // FULLWIDTH RIGHT CURLY BRACKET
		case 0xff5e:
			return "~"; // FULLWIDTH TILDE
		default:
			return "";
	}
}

<*
 @require c > 0x7F && c < 0x110000
*>
fn bool is_xid_start(uint c)
{
	uint idx = c / 8 / identifier_tables::CHUNK;
	uint chunk = idx < identifier_tables::TRIE_START.len ? identifier_tables::TRIE_START[idx] : 0;
	uint offset = chunk * identifier_tables::CHUNK / 2 + (c / 8) % identifier_tables::CHUNK;
	return (identifier_tables::LEAF[offset] >> (c % 8)) & 1 != 0;
}

<*
 @require c > 0x7F && c < 0x110000
*>
fn bool is_xid_continue(uint c)
{
	uint idx = c / 8 / identifier_tables::CHUNK;
	uint chunk = idx < identifier_tables::TRIE_CONTINUE.len ? identifier_tables::TRIE_CONTINUE[idx] : 0;
	uint offset = chunk * identifier_tables::CHUNK / 2 + (c / 8) % identifier_tables::CHUNK;
	return (identifier_tables::LEAF[offset] >> (c % 8)) & 1 != 0;
}

enum NfcQuickCheck : char
{
	NO,
	MAYBE,
	YES,
}

fn NfcQuickCheck is_normalized(uint codepoint)
{
	switch (codepoint)
	{
		case 0x0340..0x0341:
		case 0x0343..0x0344:
		case 0x0374:
		case 0x037E:
		case 0x0387:
		case 0x0958..0x095F:
		case 0x09DC..0x09DD:
		case 0x09DF:
		case 0x0A33:
		case 0x0A36:
		case 0x0A59..0x0A5B:
		case 0x0A5E:
		case 0x0B5C..0x0B5D:
		case 0x0F43:
		case 0x0F4D:
		case 0x0F52:
		case 0x0F57:
		case 0x0F5C:
		case 0x0F69:
		case 0x0F73:
		case 0x0F75..0x0F76:
		case 0x0F78:
		case 0x0F81:
		case 0x0F93:
		case 0x0F9D:
		case 0x0FA2:
		case 0x0FA7:
		case 0x0FAC:
		case 0x0FB9:
		case 0x1F71:
		case 0x1F73:
		case 0x1F75:
		case 0x1F77:
		case 0x1F79:
		case 0x1F7B:
		case 0x1F7D:
		case 0x1FBB:
		case 0x1FBE:
		case 0x1FC9:
		case 0x1FCB:
		case 0x1FD3:
		case 0x1FDB:
		case 0x1FE3:
		case 0x1FEB:
		case 0x1FEE..0x1FEF:
		case 0x1FF9:
		case 0x1FFB:
		case 0x1FFD:
		case 0x2000..0x2001:
		case 0x2126:
		case 0x212A..0x212B:
		case 0x2329:
		case 0x232A:
		case 0x2ADC:
		case 0xF900..0xFA0D:
		case 0xFA10:
		case 0xFA12:
		case 0xFA15..0xFA1E:
		case 0xFA20:
		case 0xFA22:
		case 0xFA25..0xFA26:
		case 0xFA2A..0xFA6D:
		case 0xFA70..0xFAD9:
		case 0xFB1D:
		case 0xFB1F:
		case 0xFB2A..0xFB36:
		case 0xFB38..0xFB3C:
		case 0xFB3E:
		case 0xFB40..0xFB41:
		case 0xFB43..0xFB44:
		case 0xFB46..0xFB4E:
		case 0x1D15E..0x1D164:
		case 0x1D1BB..0x1D1C0:
		case 0x2F800..0x2FA1D:
			return NO;
