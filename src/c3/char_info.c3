		case 0x0A5E:
		case 0x0A74:
		case 0x0A81..0x0A83: // Gujarati
		case 0x0A85..0x0A8B:
		case 0x0A8D:
		case 0x0A8F..0x0A91:
		case 0x0A93..0x0AA8:
		case 0x0AAA..0x0AB0:
		case 0x0AB2..0x0AB3:
		case 0x0AB5..0x0AB9:
		case 0x0ABD..0x0AC5:
		case 0x0AC7..0x0AC9:
		case 0x0ACB..0x0ACD:
		case 0x0AD0:
		case 0x0AE0:
		case 0x0B01..0x0B03: // Oriya
		case 0x0B05..0x0B0C:
		case 0x0B0F..0x0B10:
		case 0x0B13..0x0B28:
		case 0x0B2A..0x0B30:
		case 0x0B32..0x0B33:
		case 0x0B36..0x0B39:
		case 0x0B3E..0x0B43:
		case 0x0B47..0x0B48:
		case 0x0B4B..0x0B4D:
		case 0x0B5C..0x0B5D:
		case 0x0B5F..0x0B61:
		case 0x0B82..0x0B83: // Tamil
		case 0x0B85..0x0B8A:
		case 0x0B8E..0x0B90:
		case 0x0B92..0x0B95:
		case 0x0B99..0x0B9A:
		case 0x0B9C:
		case 0x0B9E..0x0B9F:
		case 0x0BA3..0x0BA4:
		case 0x0BA8..0x0BAA:
		case 0x0BAE..0x0BB5:
		case 0x0BB7..0x0BB9:
		case 0x0BBE..0x0BC2:
		case 0x0BC6..0x0BC8:
		case 0x0BCA..0x0BCD:
		case 0x0C01..0x0C03: // Telugu
		case 0x0C05..0x0C0C:
		case 0x0C0E..0x0C10:
		case 0x0C12..0x0C28:
		case 0x0C2A..0x0C33:
		case 0x0C35..0x0C39:
		case 0x0C3E..0x0C44:
		case 0x0C46..0x0C48:
		case 0x0C4A..0x0C4D:
		case 0x0C60..0x0C61:
		case 0x0C82..0x0C83: // Kannada
		case 0x0C85..0x0C8C:
		case 0x0C8E..0x0C90:
		case 0x0C92..0x0CA8:
		case 0x0CAA..0x0CB3:
		case 0x0CB5..0x0CB9:
		case 0x0CBE..0x0CC4:
		case 0x0CC6..0x0CC8:
		case 0x0CCA..0x0CCD:
		case 0x0CDE:
		case 0x0CE0..0x0CE1:
		case 0x0D02..0x0D03: // Malayalam
		case 0x0D05..0x0D0C:
		case 0x0D0E..0x0D10:
		case 0x0D12..0x0D28:
		case 0x0D2A..0x0D39:
		case 0x0D3E..0x0D43:
		case 0x0D46..0x0D48:
		case 0x0D4A..0x0D4D:
		case 0x0D60..0x0D61:
		case 0x0E01..0x0E3A: // Thai (excluding digits 0x0E50...0x0E59; originally 0x0E01...0x0E3A and 0x0E40...0x0E5B
		case 0x0E40..0x0E4F:
		case 0x0E5A..0x0E5B:
		case 0x0E81..0x0E82: // Lao
		case 0x0E84:
		case 0x0E87..0x0E88:
		case 0x0E8A:
		case 0x0E8D:
		case 0x0E94..0x0E97:
		case 0x0E99..0x0E9F:
		case 0x0EA1..0x0EA3:
		case 0x0EA5:
		case 0x0EA7:
		case 0x0EAA..0x0EAB:
		case 0x0EAD..0x0EAE:
		case 0x0EB0..0x0EB9:
		case 0x0EBB..0x0EBD:
		case 0x0EC0..0x0EC4:
		case 0x0EC6:
		case 0x0EC8..0x0ECD:
		case 0x0EDC..0x0EDD:
		case 0x0F00: // Tibetan
		case 0x0F18..0x0F19:
		case 0x0F35:
		case 0x0F37:
		case 0x0F39:
		case 0x0F3E..0x0F47:
		case 0x0F49..0x0F69:
