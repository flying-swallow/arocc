// Invocation-owned output names and temporary files for the command-line driver.
// Random names are cleanup-owned; -S/-c default output names are only retained
// so their returned strings remain valid for the lifetime of the invocation.
module aro::driver_tempfiles;
import aro::driver_options;
import aro::source;
import aro::target;
import std::collections::list;
import std::crypto::entropy;
import std::encoding::base64;
import std::io::file, std::io::path;

struct DriverTempFile
{
	String path;
	bool remove_on_cleanup;
}

<*
 Owns every generated filename returned by this manager. Only names produced
 by get_random_filename are removed by cleanup; explicit output names are
 borrowed from DriverOptions, and user object inputs are never registered.
 Do not copy an initialized manager; call free exactly once when its invocation
 ends.
*>
struct DriverTempFiles
{
	Allocator allocator;
	List{DriverTempFile} files;
}

<* Initialize invocation-local temporary-file and generated-name ownership. *>
fn void DriverTempFiles.init(&self, Allocator allocator)
{
	*self = { .allocator = allocator };
	self.files.init(allocator);
}

<*
 Remove cleanup-owned files on a best-effort basis, then release all generated
 filename storage. Borrowed -o names are never freed.
*>
fn void DriverTempFiles.free(&self)
{
	self.cleanup();
	foreach (entry : self.files) alloc::free(self.allocator, entry.path.ptr);
	self.files.free();
	*self = {};
}

<*
 Delete only random temporary paths generated by this invocation. Delete
 failures are ignored, matching Driver.exitWithCleanup's best-effort behavior.
 This does not remove retained -S/-c outputs or user-supplied object inputs.
*>
fn void DriverTempFiles.cleanup(&self)
{
	foreach (entry : self.files)
	{
		if (entry.remove_on_cleanup)
		{
			fault ignored = @catch(file::delete(entry.path));
		}
	}
}

<*
 Create and retain a random temporary path under /tmp with the given extension.
 The basename is the URL-safe base64 encoding of 12 cryptographically random
 bytes. Entropy faults propagate; allocation failure follows stdlib behavior
 and panics. The returned string is owned by this manager and is removed by
 cleanup/free.
 @return? entropy::SECURE_RANDOM_UNAVAILABLE, TIMEOUT
*>
fn String? DriverTempFiles.get_random_filename(&self, String extension)
{
	char[12] random_bytes;
	entropy::fill(random_bytes[..])!;
	char[16] encoded_bytes;
	String encoded = base64::encode_into(encoded_bytes[..], random_bytes[..], base64::NO_PAD, &base64::URL);
	return self.remember_filename("/tmp/", encoded, extension, true);
}

<*
 Return the per-source output name used by Driver.getOutFileName. In -S mode
 the default suffix is .s; in -c mode it is the target object-format suffix.
 A supplied -o name is returned borrowed. Default -S/-c names are manager-owned
 but retained as user outputs. Link-mode names are random temporary object
 paths and are removed by cleanup/free.
 @return? entropy::SECURE_RANDOM_UNAVAILABLE, TIMEOUT
*>
fn String? DriverTempFiles.get_out_file_name(&self, driver_options::DriverOptions* opts, source::Source src, target::Target target)
{
	if (opts.only_compile || opts.only_preprocess_and_compile)
	{
		if (opts.has_output_name) return opts.output_name;
		String extension = opts.only_preprocess_and_compile ? ".s" : target.ofmt.file_ext(target.cpu.arch);
		return self.remember_filename(file_stem(src.path), "", extension, false);
	}
	return self.get_random_filename(target.ofmt.file_ext(target.cpu.arch));
}

<* Store a joined filename in manager-owned storage. *>
fn String DriverTempFiles.remember_filename(&self, String prefix, String name, String extension, bool remove_on_cleanup)
{
	sz length = prefix.len + name.len + extension.len;
	char* bytes = alloc::malloc(self.allocator, length + 1);
	sz offset = 0;
	foreach (c : prefix) bytes[offset++] = c;
	foreach (c : name) bytes[offset++] = c;
	foreach (c : extension) bytes[offset++] = c;
	bytes[length] = 0;
	String path = (String)bytes[:length];
	self.files.push({ .path = path, .remove_on_cleanup = remove_on_cleanup });
	return path;
}

<* std.fs.path.stem equivalent used by Driver.getOutFileName. *>
fn String file_stem(String filename)
{
	path::Path parsed = path::tnew(filename)!!;
	String basename = parsed.basename();
	String? extension = parsed.extension();
	if (catch extension) return basename;
	if (extension.len == 0) return basename;
	return basename[:basename.len - extension.len - 1];
}
