	SINGLE_REQUIRES_ZERO_INDEX { "array subscript on single pointer must use a constant index of 0 to be in bounds", ERROR, {} },
	POINTER_ARITH_SINGLE { "pointer arithmetic on single pointer is out of bounds; consider adding '__counted_by'", ERROR, {} },
	BLOCKS_NOT_ENABLED { "blocks are not enabled", ERROR, {} },
	BLOCKS_ARE_CLANG_EXTENSION { "blocks are a Clang extension", OFF, { .has_opt = true, .opt = Option.BLOCKS_EXTENSION, .extension = true } },
	BLOCK_TO_NON_FUNCTION { "block pointer to non-function type is invalid", ERROR, {} },
	C23_ATTRIBUTE { "[[]] attributes are a C23 extension", OFF, { .has_opt = true, .opt = Option.C23_EXTENSIONS, .extension = true, .has_suppress_version = true, .suppress_version = C23 } },
	BUILTIN_ARM_LDREX_STREX_INVALID_PTR_TYPE { "address argument to %s must be a pointer to integer, floating-point, or pointer (%s invalid)", ERROR, {} },
	BUILTIN_ARM_LDREX_STREX_UNSUPPORTED { "%s is not supported on this architecture", ERROR, {} },
	BUILTIN_ARM_LDREX_STREX_UNSUPPORTED_SIZE { "address argument to %s must be a pointer to %s byte type (%s invalid)", ERROR, {} },
	TYPENAME_INVALID_SPECIFIER { "type name does not allow %s specifier to be specified", ERROR, {} },
	C99_EXTENSION { "'%s' is a C99 extension", OFF, { .has_opt = true, .opt = Option.C99_EXTENSIONS, .extension = true } },
	PRE_C11_COMPAT { "'%s' is incompatible with C standards before C11", OFF, { .has_opt = true, .opt = Option.PRE_C11_COMPAT } },
	C11_EXTENSION { "'%s' is a C11 extension", OFF, { .has_opt = true, .opt = Option.C11_EXTENSIONS, .extension = true } },
	C2Y_COUNTOF { "'_Countof' is a C2y extension", OFF, { .has_opt = true, .opt = Option.C2Y_EXTENSIONS, .extension = true } },
	PRE_C2Y_COUNTOF { "'_Countof' is incompatible with C standards before C2y", OFF, { .has_opt = true, .opt = Option.PRE_C2Y_COMPAT } },
	INVALID_COUNTOF { "'_Countof' requires an argument of array type; %s is invalid", ERROR, {} },
	PRE_C2Y_NAMED_BREAK { "named '%s' is incompatible with C standards before C2y", ERROR, { .has_opt = true, .opt = Option.PRE_C2Y_COMPAT } },
	C2Y_NAMED_BREAK { "named '%s' is a C2y extension", OFF, { .has_opt = true, .opt = Option.C2Y_EXTENSIONS, .extension = true } },
	NAMED_BREAK_NOT_ENCLOSING { "'%s' label does not name an enclosing loop or switch", ERROR, {} },
	NAMED_CONTINUE_SWITCH { "'continue' label refers to a switch statement", ERROR, {} },
	// Zig Preprocessor.Diagnostic.float_literal_in_expr; number_value reports it for any float literal.
	FLOAT_LITERAL_IN_EXPR { "floating point literal in preprocessor expression", ERROR, {} },
	// C3-only: number_value rejects a hex float without significand digits (`0x.p1`). Same text as clang.
	HEX_FLOAT_NO_SIGNIFICAND { "hexadecimal floating constant requires a significand", ERROR, {} },
	// C3-only: a primary-expression production the port has not implemented.
	PRIMARY_UNAVAILABLE { "%s", ERROR, {} },
	// C3-only: Parser.parse_translation_unit without a grammar handler.
	GRAMMAR_UNAVAILABLE { "parser grammar callback is unavailable", ERROR, {} },
	// C3-only: promoted anonymous-record member name found in more than one anonymous member at the same level.
	AMBIGUOUS_MEMBER { "member '%s' is ambiguous; found in multiple anonymous struct or union members", ERROR, {} },
}
