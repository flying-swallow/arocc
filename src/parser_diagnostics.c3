// Parser diagnostic records and shared emission helpers, ported from
// src/aro/Parser/Diagnostic.zig and Parser.zig.
module aro::parser_diagnostics;
import aro::diagnostics, aro::compilation, aro::lang_opts, aro::source;

<* Match Parser.err's extension and language-version suppression before formatting. *>
fn bool ParserDiag.should_emit(self, lang_opts::LangOpts* opts, bool extension_suppressed)
{
	ParserDiagMeta m = self.meta;
	if (extension_suppressed && m.extension && self.kind == OFF) return false;
	if (m.has_suppress_version && opts.standard.at_least(m.suppress_version)) return false;
	if (m.has_suppress_unless_version && !opts.standard.at_least(m.suppress_unless_version)) return false;
	return true;
}

<* Build and send a parser diagnostic with its expanded token location and macro notes. *>
fn void? ParserDiag.emit(self, Compilation* comp, lang_opts::LangOpts* opts, bool extension_suppressed, String text, ExpandedLocation loc, Location[] expansion_locs, bool note_msg_loc = true)
{
	if (!self.should_emit(opts, extension_suppressed)) return;
	if (!comp.diagnostics.@enabled(self)) return;
	return comp.diagnostics.add_with_location(comp, diagnostics::@message_at(self, text, loc), expansion_locs, note_msg_loc);
}

<*
 diagnostics::DiagMeta plus Zig Parser.Diagnostic's language-version
 suppression. Zero means: no -W option, not an extension, no suppression.
*>
struct ParserDiagMeta
{
	bool has_opt;
	Option opt;
	bool extension;
	bool show_in_system_headers;
	bool has_suppress_version;
	lang_opts::Standard suppress_version;
	bool has_suppress_unless_version;
	lang_opts::Standard suppress_unless_version;
}

<*
 Parser diagnostics (declaration order follows Zig Parser/Diagnostic.zig).
 `fmt` uses C3 printf syntax; `Parser.err` forwards it to an `@format`
 function so c3c checks each call site's arguments at compile time.
 Zig `{qt}`, `{tok_id}`, `{value}`, `{at}`, `{codepoint}` and `{normalized}`
 placeholders are all `%s`; pass `Parser.qt`/`Parser.value` wrappers for them.
*>
enum ParserDiag : ushort (String fmt, MessageKind kind, ParserDiagMeta meta)
{
	TODO { "TODO: %s", ERROR, {} },
	CLOSING_PAREN { "expected closing ')'", ERROR, {} },
	TO_MATCH_PAREN { "to match this '('", NOTE, {} },
	TO_MATCH_BRACE { "to match this '{'", NOTE, {} },
	TO_MATCH_BRACKET { "to match this '['", NOTE, {} },
	EXPECTED_INVALID { "expected '%s', found invalid bytes", ERROR, {} },
	EXPECTED_EOF { "expected '%s' before end of file", ERROR, {} },
	EXPECTED_TOKEN { "expected '%s', found '%s'", ERROR, {} },
	EXPECTED_EXPR { "expected expression", ERROR, {} },
	UNEXPECTED_TYPE_NAME { "unexpected type name '%s': expected expression", ERROR, {} },
	EXPECTED_INTEGER_CONSTANT_EXPR { "expression is not an integer constant expression", ERROR, {} },
	MISSING_TYPE_SPECIFIER { "type specifier missing, defaults to 'int'; ISO C99 and later do not support implicit int", ERROR, { .has_opt = true, .opt = Option.IMPLICIT_INT, .has_suppress_unless_version = true, .suppress_unless_version = C99 } },
	MISSING_TYPE_SPECIFIER_C23 { "a type specifier is required for all declarations", ERROR, {} },
	PARAM_NOT_DECLARED { "parameter '%s' was not declared, defaults to 'int'; ISO C99 and later do not support implicit int", ERROR, { .has_opt = true, .opt = Option.IMPLICIT_INT, .extension = true, .has_suppress_unless_version = true, .suppress_unless_version = C99 } },
	MULTIPLE_STORAGE_CLASS { "cannot combine with previous '%s' declaration specifier", ERROR, {} },
	STATIC_ASSERT_FAILURE_MESSAGE { "static assertion failed%s", ERROR, {} },
	STATIC_ASSERT_EXPRESSION_EVALUATES_TO { "expression evaluates to '%s'", NOTE, {} },
	EXPECTED_TYPE { "expected a type", ERROR, {} },
	CANNOT_COMBINE_SPEC { "cannot combine with previous '%s' specifier", ERROR, {} },
	CANNOT_COMBINE_SPEC_QT { "cannot combine with previous %s specifier", ERROR, {} },
	CANNOT_COMBINE_WITH_TYPEOF { "'%s typeof' is invalid", ERROR, {} },
	DUPLICATE_DECL_SPEC { "duplicate '%s' declaration specifier", WARNING, { .has_opt = true, .opt = Option.DUPLICATE_DECL_SPECIFIER } },
	RESTRICT_NON_POINTER { "restrict requires a pointer or reference (%s is invalid)", ERROR, {} },
	EXPECTED_EXTERNAL_DECL { "expected external declaration", ERROR, {} },
	EXPECTED_RECORD_DECL { "expected record declaration", ERROR, {} },
	EXPECTED_IDENT_OR_L_PAREN { "expected identifier or '('", ERROR, {} },
