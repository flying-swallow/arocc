#!/usr/bin/env bash
# Generated by the c3_test rule (aro_cc/tools/c3.bzl). Runs the C3 test runner built
# by `c3c compile-test` and maps Bazel's test settings onto its flags:
#   bazel test --test_filter=<substr>  ->  --test-filter <substr>
#   bazel test --test_arg=<flag>       ->  passed through (e.g. --test-show-output,
#                                          --test-noleak, --test-log-level debug)
# ANSI colors are disabled so test.log stays readable.
set -euo pipefail

runner_args=(--noansi)
if [[ -n "${TESTBRIDGE_TEST_ONLY:-}" ]]; then
  runner_args+=(--test-filter "${TESTBRIDGE_TEST_ONLY}")
fi

exec "${0%/*}/%RUNNER%" "${runner_args[@]}" "$@"
