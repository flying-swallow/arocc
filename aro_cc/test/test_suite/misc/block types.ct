void my_func_accepting_block(double (*afunc)(int), double (^ablock)(int)) { // #note@69: passing argument to parameter here
  afunc(1);
  ablock(1);
  ablock((struct { int foo; }){0}); // #error@10: passing 'struct (anonymous struct at block types.c:21:11)' to parameter of incompatible type 'int'
  struct { int foo; int bar; } result = ablock(); // #error@48: expected 1 argument(s) got 0

  bar a;
  int b = a; // #error@11: initializing 'int' from incompatible type 'bar' (aka 'int (^)(int)')
  int ^c = a; // #error@10: block pointer to non-function type is invalid

  MyInt d = 3;
  MyInt (^e)(MyInt) = d; // #error@23: initializing 'MyInt (^)(MyInt)' from incompatible type 'MyInt' (aka 'int')
  e = func_accepting_MyInt_returning_MyInt; // #error@5: assignment to 'MyInt (^)(MyInt)' from incompatible type 'MyInt (*)(MyInt)' (aka 'int (*)(int)')
  e = &func_accepting_MyInt_returning_MyInt; // #error@5: assignment to 'MyInt (^)(MyInt)' from incompatible type 'MyInt (*)(MyInt)' (aka 'int (*)(int)')
  e = (MyInt (^)(MyInt))func_accepting_MyInt_returning_MyInt;
  e = (MyInt (^)(MyInt))&func_accepting_MyInt_returning_MyInt;
  e = 0;
  d = e; // #error@5: assignment to 'MyInt' (aka 'int') from incompatible type 'MyInt (^)(MyInt)'

  afunc = ablock; // #error@9: assignment to 'double (*)(int)' from incompatible type 'double (^)(int)'
  ablock = afunc; // #error@10: assignment to 'double (^)(int)' from incompatible type 'double (*)(int)'

  void *anyptr;

  int (^f)(int) = a;
  a = f;
  f = anyptr;
  anyptr = f;
  f = 0xdeadbeef; // #error@5: assignment to 'int (^)(int)' from incompatible type 'unsigned int'
  f = (aFunc ^)ablock;
  f = (aFunc ^)0xdeadbeef;
  f = (bar)ablock;
  f = (bar)0xdeadbeef;
  f = (bar)(unsigned long)ablock;
  f = (bar)(unsigned long)0xdeadbeef;
  f = (bar)(unsigned long)f;

  __auto_type ^a; // #error@3: '__auto_type' not allowed in block return type
}

