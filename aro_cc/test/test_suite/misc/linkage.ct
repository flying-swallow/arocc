extern int foo1 __attribute__((weak, selectany));
extern int foo2 __attribute__((selectany, weak));

extern int foo3 __attribute__((selectany, selectany, weak, weak, internal_linkage)); // #error@32: 'selectany' can only be applied to data items with external linkage // #error@54: 'weak' cannot be applied to declarations with internal linkage
extern int foo4 __attribute__((internal_linkage, weak)); // #error@50: 'weak' cannot be applied to declarations with internal linkage
extern int foo5 __attribute__((internal_linkage, selectany)); // #error@50: 'selectany' can only be applied to data items with external linkage
extern int foo6 __attribute__((selectany, internal_linkage)); // #error@32: 'selectany' can only be applied to data items with external linkage

extern int foo7 __attribute__((internal_linkage));

typedef int A __attribute__((internal_linkage)); // #warning@30: 'internal_linkage' attribute only applies to functions and variables [-Wignored-attributes]
typedef int B __attribute__((weak)); // #warning@30: 'weak' attribute only applies to functions and variables [-Wignored-attributes]
typedef int C __attribute__((selectany)); // no warnign matches clang

