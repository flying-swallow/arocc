// #kind: expand
// #pragma push_macro / pop_macro save and restore a macro definition, including
// "not defined", per name (c-testsuite 00206). The operand is not expanded.
#define X 1
X
#pragma push_macro("X")
#undef X
#define X 2
X
#pragma push_macro("X")
#undef X
#define X 3
X
#pragma pop_macro("X")
X
#pragma pop_macro("X")
X
#pragma push_macro("U")
#define U defined
U
#pragma pop_macro("U")
U
#pragma pop_macro("never_pushed")

// #expect: stdout
1
#pragma push_macro ( "X" )
2
#pragma push_macro ( "X" )
3
#pragma pop_macro ( "X" )
2
#pragma pop_macro ( "X" )
1
#pragma push_macro ( "U" )

defined
#pragma pop_macro ( "U" )
U
#pragma pop_macro ( "never_pushed" )
