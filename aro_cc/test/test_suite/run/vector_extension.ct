// #kind: run
// #exit: 0
// GNU vector extension: element-wise arithmetic/comparison, splats, subscripts,
// __builtin_shufflevector, and vectors passed/returned in XMM registers.
#include <stdio.h>
typedef int v4si __attribute__((vector_size(16)));
typedef float v4sf __attribute__((vector_size(16)));
typedef float v2sf __attribute__((vector_size(8)));
typedef double v2df __attribute__((vector_size(16)));
typedef unsigned char v16qu __attribute__((vector_size(16)));
struct W { v4si v; };
__attribute__((noinline)) v4si addv(v4si a, v4si b, int k) { return a + b * k; }
__attribute__((noinline)) v2sf scalef(v2sf a, float s) { return a * s; }
__attribute__((noinline)) v2df sumd(v2df a, v2df b, v2df c, v2df d, v2df e, v2df f, v2df g, v2df h, v2df i)
{
	return a + b + c + d + e + f + g + h + i;
}
__attribute__((noinline)) struct W wrap(struct W w) { w.v = w.v * 3; return w; }
int main(void)
{
	v4si a = {1, 2, 3, 4}, b = {10, 20, 30, 40};
	v4si c = a + b * 2;
	v4si m = a > (v4si){2, 2, 2, 2};
	v4sf f = {1.5f, 2.5f, 3.5f, 4.5f};
	f = f * 2;
	c[1] = 99;
	v4si s = __builtin_shufflevector(a, b, 0, 4, 1, 5);
	v4sf cf = __builtin_convertvector(a, v4sf);
	v16qu bytes = (v16qu)a;
	a += 1;
	a <<= 2;
	v4si r = addv((v4si){1, 2, 3, 4}, (v4si){10, 20, 30, 40}, 2);
	v2sf h = scalef((v2sf){1.5f, 2.5f}, 2.0f);
	v2df o = {1, 2};
	v2df d = sumd(o, o, o, o, o, o, o, o, o);
	struct W w = wrap((struct W){{1, 2, 3, 4}});
	printf("%d %d %d %d | %d %d %d %d | %g %g | %d %d %d %d | %g %d %d\n", c[0], c[1], c[2], c[3], m[0], m[1], m[2], m[3],
		f[0], f[3], s[0], s[1], s[2], s[3], cf[3], bytes[4], a[3]);
	printf("%d %d %d %d | %g %g | %g %g | %d %d\n", r[0], r[1], r[2], r[3], h[0], h[1], d[0], d[1], w.v[0], w.v[3]);
	return 0;
}

// #expect: stdout
21 99 63 84 | 0 0 -1 -1 | 3 9 | 1 10 2 20 | 4 2 20
21 42 63 84 | 3 5 | 9 18 | 3 12
