// #opt: -target x86_64-linux
typedef struct BackingStruct { int x; } BackingStruct;
enum Bad1: BackingStruct { B1 }; // #error@12: non-integral type 'BackingStruct' (aka 'struct BackingStruct') is an invalid underlying type

// #expect: stdout
implicit typedef: '__int128'
 name: __int128_t

implicit typedef: 'unsigned __int128'
 name: __uint128_t

implicit typedef: '*char'
 name: __builtin_ms_va_list

implicit typedef: '[1]struct __va_list_tag'
 name: __builtin_va_list

implicit typedef: 'struct __NSConstantString_tag'
 name: __NSConstantString

implicit typedef: 'long double'
 name: __float80

struct_decl: 'struct BackingStruct'
  record_field: 'int'
   name: x

typedef: 'BackingStruct: struct BackingStruct'
 name: BackingStruct

enum_decl: 'enum Bad1: int'
  enum_field: 'int' (value: 0)
   name: B1

