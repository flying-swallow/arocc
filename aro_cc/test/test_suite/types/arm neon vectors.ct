// #skip: diagnostics differ (aro_c3 gap)
// #opt: -target aarch64-linux
__attribute__((neon_vector_type(2))) unsigned long a;
__attribute__((neon_vector_type(2))) double b;
int *__attribute__((neon_vector_type(2))) c; // #error@21: invalid vector element type 'int *'
__attribute__((neon_vector_type(128))) unsigned long d; // #error@16: Neon vector size must be 64 or 128 bits
__attribute__((neon_vector_type(2))) short e; // #error@16: Neon vector size must be 64 or 128 bits

__attribute__((neon_polyvector_type(2))) long f; // #error@16: invalid vector element type 'long'
__attribute__((neon_polyvector_type(2))) unsigned long g;
__attribute__((neon_polyvector_type(4))) unsigned long h; // #error@16: Neon vector size must be 64 or 128 bits
__attribute__((neon_polyvector_type(2))) unsigned short i; // #error@16: Neon vector size must be 64 or 128 bits

void foo(void) {
    __attribute__((neon_vector_type(4))) int a;
    __attribute__((neon_vector_type(4))) float b;
    a = b;
    b = a;
    (void)(b == a);
}

