load("//aro_cc/tools:c3.bzl", "c3_test")

# Unit tests: lexer. One target per line so parallel additions merge cleanly.

filegroup(
    name = "literals",
    srcs = glob(["data/literals/*.txt"]),
)

c3_test(name = "source_tests", srcs = ["source_tests.c3"], deps = ["//:aro_cc_lib"])
c3_test(name = "tokenizer_tests", srcs = ["tokenizer_tests.c3"], deps = ["//:aro_cc_lib"])
c3_test(name = "literal_contract_tests", srcs = ["literal_contract_tests.c3"], deps = ["//:aro_cc_lib"])
c3_test(name = "number_literal_tests", srcs = ["number_literal_tests.c3"], deps = ["//:aro_cc_lib"])
c3_test(name = "text_literal_semantics_tests", srcs = ["text_literal_semantics_tests.c3"], deps = ["//:aro_cc_lib"])
c3_test(name = "text_literal_semantics_manual_tests", srcs = ["text_literal_semantics_manual_tests.c3"], deps = ["//:aro_cc_lib"], tags = ["manual"])
c3_test(name = "text_literal_tests", srcs = ["text_literal_tests.c3"], deps = ["//:aro_cc_lib"])
c3_test(name = "literal_tests", srcs = ["literal_tests.c3"], data = [":literals"], deps = ["//:aro_cc_lib"])

# Default suite; manual tests stay addressable but out of it.
test_suite(
    name = "all",
    tests = [
        ":source_tests",
        ":tokenizer_tests",
        ":literal_contract_tests",
        ":number_literal_tests",
        ":text_literal_semantics_tests",
        ":text_literal_tests",
        ":literal_tests",
    ],
    visibility = ["//aro_cc/test:__pkg__"],
)
