load("//aro_cc/tools:c3.bzl", "c3_binary", "c3_main_test", "c3_test")

# GCC C testsuite (copied into aro_cc/test/gcc) as golden cases: torture compile must
# compile cleanly, torture execute/ieee must build, link and exit 0, gcc.dg must
# match dg-error/dg-warning lines, asm compiles gcc.dg cases with -S and applies
# their dg-final scan-assembler checks, abi runs gcc.target/x86_64/abi (SysV ABI
# conformance: test_*.c linked with asm-support.S, assembled by the host cc). A suite fails when any case is FAIL,
# CRASH or TIMEOUT. The targets are tagged manual (skipped by `bazel test //...`)
# and serve as a worklist for migrating cases into the main unit tests. summary.md/results.jsonl are in the test's
# undeclared outputs. Run explicitly, e.g.
#   bazel test //aro_cc/test/src/gcc:gcc_testsuite_execute
#   bazel run //aro_cc/test/src/gcc:gcc_testsuite_run [-- --filter 'pr1*']

c3_test(
    name = "gcc_testsuite_tests",
    srcs = ["gcc_testsuite.c3"],
    deps = ["//aro_cc/test/src/lib:harness_lib"],
)

_GCC_TESTSUITE_SUITES = {
    "compile": 2,
    "execute": 2,
    "ieee": 1,
    "dg": 4,
    "asm": 1,
    "abi": 1,
}

[c3_main_test(
    name = "gcc_testsuite_" + suite,
    size = "large",
    srcs = ["gcc_testsuite.c3"],
    args = [
        "--aro",
        "$(rootpath //:aro_cc)",
        "--abi-include",
        "aro_cc/test/src/gcc/abi_include",
        "--suite",
        suite,
    ],
    data = [
        "abi_include/xmmintrin.h",
        "//:aro_cc",
        "//aro_cc/test:gcc_testsuite",
    ],
    shard_count = shards,
    tags = ["manual"],
    deps = ["//aro_cc/test/src/lib:harness_lib"],
) for suite, shards in _GCC_TESTSUITE_SUITES.items()]

test_suite(
    name = "gcc_testsuite",
    tags = ["manual"],
    tests = [":gcc_testsuite_" + suite for suite in _GCC_TESTSUITE_SUITES],
)

# bazel run //aro_cc/test/src/gcc:gcc_testsuite_run [-- extra args]
# runs every suite on <workspace>/aro_cc/test/gcc.
c3_binary(
    name = "gcc_testsuite_run",
    srcs = ["gcc_testsuite.c3"],
    args = [
        "--aro",
        "$(rootpath //:aro_cc)",
        "--suite",
        ",".join(_GCC_TESTSUITE_SUITES.keys()),
    ],
    data = ["//:aro_cc"],
    deps = ["//aro_cc/test/src/lib:harness_lib"],
)
exports_files(["gcc_testsuite.c3"], visibility = ["//aro_cc/test/src/clang:__pkg__"])
