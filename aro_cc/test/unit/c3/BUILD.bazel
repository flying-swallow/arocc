load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Unit tests: C3 frontend (src/frontend/c3). Per-area suites live in subpackages.

sh_test(
    name = "isolation_test",
    srcs = ["isolation_test.sh"],
    args = ["$(locations //:c3_frontend_srcs)"],
    data = ["//:c3_frontend_srcs"],
)

sh_test(
    name = "shared_isolation_test",
    srcs = ["isolation_test.sh"],
    args = ["--shared", "$(locations //aro/compiler:sources)"],
    data = ["//aro/compiler:sources"],
)

sh_test(
    name = "c_isolation_test",
    srcs = ["isolation_test.sh"],
    args = ["--c", "$(locations //aro_cc:sources)"],
    data = ["//aro_cc:sources"],
)

test_suite(
    name = "all",
    tests = [
        ":isolation_test",
        ":shared_isolation_test",
        ":c_isolation_test",
        "//aro_cc/test/unit/c3/ast:all",
        "//aro_cc/test/unit/c3/lexer:all",
        "//aro_cc/test/unit/c3/parser:all",
        "//aro_cc/test/unit/c3/sema:all",
        "//aro_cc/test/unit/c3/target:all",
    ],
)
