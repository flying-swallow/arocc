load("//tools:c3.bzl", "c3_library")

# This standalone package includes the generated builtin and system-default
# modules under src, so the source glob is its complete compiler input set.
c3_library(
    name = "aro",
    srcs = glob(["aro/src/**/*.c3", "aro/compiler/**/*.c3", "aro_cc/src/**/*.c3", "aro_c3c/src/**/*.c3", "ir.c3l/**/*.c3"]),
    data = glob(["include/*.h", "ir.c3l/manifest.json"]),
    visibility = ["//visibility:public"],
)

alias(
    name = "aro_distribution",
    actual = ":aro",
    visibility = ["//visibility:public"],
)
