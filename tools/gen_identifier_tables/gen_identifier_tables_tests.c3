module gen_identifier_tables_tests;
import std, gen_identifier_tables;

fn void arrays_follow_python_regex() @test
{
	String text = "//! Header one  \n//!two\npub const chunk = 0064;\n"
		"pub const trie_start: [2]u8 align(8) = .{\n    0x01,\n 0x02 };\n"
		"pub const bad: [1]u16 = .{ 0x00 };\n"
		"pub const trie_continue: [1]u8 = .{0xAb,};\n"
		"pub const leaf: [17]u8 align(64) = .{ 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10 };\n";
	String got = gen_identifier_tables::generate(tmem, text)!!;
	test::eq(got, "// GENERATED by //tools/gen_identifier_tables from\n"
		"// src/aro/char_info/identifier_tables.zig. Do not edit by hand.\n"
		"//\n"
		"// Header one\n"
		"// two\n"
		"// The table data is Unicode data; see LICENSE-UNICODE at the repository root.\n"
		"module aro::frontend::c::identifier_tables;\n"
		"\n"
		"const uint CHUNK = 0064;\n"
		"\n"
		"const char[2] TRIE_START = {\n\t0x01, 0x02,\n};\n"
		"\n"
		"const char[1] TRIE_CONTINUE = {\n\t0xAb,\n};\n"
		"\n"
		"const char[17] LEAF = {\n\t0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n\t0x10,\n};\n");
}

fn void lazy_body_spans_to_first_close() @test
{
	// `.*?` with re.S: the body of `a` swallows `pub const b...` up to the first `};`.
	ZigArray[] arrs = gen_identifier_tables::find_arrays(tmem, "pub const a: [1]u8 = .{ 0x00, pub const b: [1]u8 = .{ 0x01 };");
	test::eq(arrs.len, 1);
	test::eq(arrs[0].name, "a");
	test::eq(arrs[0].body, " 0x00, pub const b: [1]u8 = .{ 0x01 ");
}

fn void rejects_wrong_counts() @test
{
	String text = "pub const chunk = 1;\npub const trie_start: [2]u8 = .{ 0x01 };\npub const trie_continue: [1]u8 = .{0x00};\npub const leaf: [1]u8 = .{ 0x00 };\n";
	assert(@catch(gen_identifier_tables::generate(tmem, text)));
}
