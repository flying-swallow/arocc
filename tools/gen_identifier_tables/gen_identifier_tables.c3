// Generate aro_cc/src/identifier_tables.c3 from aro/src/aro/char_info/identifier_tables.zig.
//
// The Zig file is the reference copy of the unicode-ident XID_Start/XID_Continue
// trie (Unicode data, see LICENSE-UNICODE). This tool copies its data verbatim
// so the C3 port uses exactly the same Unicode version, never the host's.
//
//   bazel run //tools/gen_identifier_tables            # rewrite the C3 file
//   bazel run //tools/gen_identifier_tables -- --check # exit 1 if it is stale
module gen_identifier_tables;
import std::io, std::collections::list, aro_harness;

const String SRC_REL = "aro/src/aro/char_info/identifier_tables.zig";
const String DST_REL = "aro_cc/src/identifier_tables.c3";

faultdef BAD_INPUT;

<* One `pub const NAME: [LEN]u8 [align(N)] = .{ BODY };` array of the Zig source. *>
struct ZigArray
{
	String name;
	String length;
	String body;
}

fn bool is_digit(char c) @local => c >= '0' && c <= '9';
fn bool is_hex(char c) @local => is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');

<* Python str.isspace for ASCII. *>
fn bool py_space(char c) => c == ' ' || (c >= '\t' && c <= '\r') || (c >= 0x1c && c <= 0x1f);

<* Python str.strip() for ASCII text. *>
fn String py_strip(String s)
{
	sz b = 0;
	sz e = s.len;
	while (b < e && py_space(s[b])) b++;
	while (e > b && py_space(s[e - 1])) e--;
	return s[b:e - b];
}

<* Python str.splitlines() for ASCII text. *>
fn String[] py_splitlines(Allocator a, String text)
{
	List{String} out;
	out.init(a);
	sz start = 0;
	sz i = 0;
	while (i < text.len)
	{
		char c = text[i];
		if (c == '\n' || c == '\r' || c == '\v' || c == '\f' || (c >= 0x1c && c <= 0x1e))
		{
			out.push(text[start:i - start]);
			if (c == '\r' && i + 1 < text.len && text[i + 1] == '\n') i++;
			start = ++i;
			continue;
		}
		i++;
	}
	if (start < text.len) out.push(text[start..]);
	return out.array_view();
}

<* Match a literal at `pos`; advances `pos` on success. *>
fn bool lit(String s, sz* pos, String l) @local
{
	if (!s[*pos..].starts_with(l)) return false;
	*pos += l.len;
	return true;
}

alias CharPred = fn bool(char);

<* Greedy run of chars satisfying `pred` at `pos` (at least `min`). *>
fn bool run(String s, sz* pos, CharPred pred, sz min = 1) @local
{
	sz start = *pos;
	while (*pos < s.len && pred(s[*pos])) (*pos)++;
	if (*pos - start < min)
	{
		*pos = start;
		return false;
	}
	return true;
}

<* `pub const chunk = (\d+);` — re.search, first match. *>
fn String? find_chunk(String text)
{
	for (sz i = 0; i < text.len; i++)
	{
		sz p = i;
		if (!lit(text, &p, "pub const chunk = ")) continue;
		sz d = p;
		if (!run(text, &p, &is_digit)) continue;
		String digits = text[d:p - d];
		if (!lit(text, &p, ";")) continue;
		return digits;
	}
	return BAD_INPUT~;
}

fn bool is_ident_char(char c) @local => c.is_alnum() || c == '_';

<* Try `pub const (\w+): \[(\d+)\]u8(?: align\(\d+\))? = \.\{(.*?)\};` (re.S) at `i`; returns the end. *>
fn sz? match_array(String text, sz i, ZigArray* out)
{
	sz p = i;
	if (!lit(text, &p, "pub const ")) return BAD_INPUT~;
	sz n = p;
	if (!run(text, &p, &is_ident_char)) return BAD_INPUT~;
	out.name = text[n:p - n];
	if (!lit(text, &p, ": [")) return BAD_INPUT~;
	sz l = p;
	if (!run(text, &p, &is_digit)) return BAD_INPUT~;
	out.length = text[l:p - l];
	if (!lit(text, &p, "]u8")) return BAD_INPUT~;
	// Optional ` align(\d+)`; the following ` = .{` cannot start with it.
	sz q = p;
	if (lit(text, &q, " align(") && run(text, &q, &is_digit) && lit(text, &q, ")")) p = q;
	if (!lit(text, &p, " = .{")) return BAD_INPUT~;
	// Lazy body: the first `};` after the opening brace.
	sz? close = text[p..].index_of("};");
	if (catch close) return BAD_INPUT~;
	out.body = text[p:close];
	return p + close + 2;
}

<* ARRAY_RE.findall: non-overlapping matches scanning left to right. *>
fn ZigArray[] find_arrays(Allocator a, String text)
{
	List{ZigArray} out;
	out.init(a);
	sz i = 0;
	while (i < text.len)
	{
		ZigArray arr;
		sz? end = match_array(text, i, &arr);
		if (try end)
		{
			out.push(arr);
			i = end;
			continue;
		}
		i++;
	}
	return out.array_view();
}

fn bool is_ascii(String s)
{
	foreach (c : s) if (c >= 0x80) return false;
	return true;
}

<* The generated C3 source for the Zig `text`; prints the reason and fails on unexpected input. *>
fn String? generate(Allocator a, String text)
{
	if (!is_ascii(text))
	{
		io::eprintn("identifier_tables.zig: non-ASCII input is not supported");
		return BAD_INPUT~;
	}
	String? chunk = find_chunk(text);
	if (catch chunk)
	{
		io::eprintn("chunk constant not found");
		return BAD_INPUT~;
	}
	DString out;
	out.init(a);
	out.append("// GENERATED by //tools/gen_identifier_tables from\n");
	out.append("// aro/src/aro/char_info/identifier_tables.zig. Do not edit by hand.\n");
	out.append("//\n");
	@pool()
	{
		foreach (line : py_splitlines(tmem, text))
		{
			if (line.starts_with("//!")) out.appendf("// %s\n", py_strip(line[3..]));
		}
		out.append("// The table data is Unicode data; see LICENSE-UNICODE at the repository root.\n");
		out.append("module aro::frontend::c::identifier_tables;\n");
		out.append("\n");
		out.appendf("const uint CHUNK = %s;\n", chunk);
		ZigArray[] arrays = find_arrays(tmem, text);
		if (arrays.len != 3 || arrays[0].name != "trie_start" || arrays[1].name != "trie_continue" || arrays[2].name != "leaf")
		{
			DString names;
			names.init(tmem);
			foreach (i, arr : arrays) names.appendf("%s'%s'", i ? ", " : "", arr.name);
			io::eprintfn("unexpected arrays: [%s]", names.str_view());
			return BAD_INPUT~;
		}
		foreach (arr : arrays)
		{
			String body = arr.body.treplace("\n", " ");
			List{String} values;
			values.init(tmem);
			foreach (v : body.tsplit(","))
			{
				String s = py_strip(v);
				if (s.len) values.push(s);
			}
			// int(length): the digits may carry leading zeros.
			long? want = arr.length.to_long();
			if (catch want) return BAD_INPUT~;
			if (values.len() != want)
			{
				io::eprintfn("%s: expected %d values, found %d", arr.name, want, values.len());
				return BAD_INPUT~;
			}
			foreach (v : values)
			{
				if (v.len != 4 || v[0] != '0' || v[1] != 'x' || !is_hex(v[2]) || !is_hex(v[3]))
				{
					io::eprintfn("%s: bad value '%s'", arr.name, v);
					return BAD_INPUT~;
				}
			}
			out.append("\n");
			out.appendf("const char[%s] %s = {\n", arr.length, arr.name.to_upper_tcopy());
			for (sz i = 0; i < values.len(); i += 16)
			{
				out.append("\t");
				sz end = i + 16 < values.len() ? i + 16 : values.len();
				for (sz j = i; j < end; j++)
				{
					if (j > i) out.append(", ");
					out.append(values[j]);
				}
				out.append(",\n");
			}
			out.append("};\n");
		}
	};
	return out.str_view();
}

fn int main(String[] args)
{
	bool check = false;
	foreach (arg : args[1..])
	{
		if (arg == "--check") check = true;
	}
	String root = aro_harness::repo_root(mem);
	String src = string::format(mem, "%s/%s", root, SRC_REL);
	String dst = string::format(mem, "%s/%s", root, DST_REL);
	char[]? text = file::load(mem, src);
	if (catch err = text)
	{
		io::eprintfn("unable to read %s: %s", src, err);
		return 1;
	}
	String? content = generate(mem, (String)text);
	if (catch content) return 1;
	if (check)
	{
		char[]? have = file::load(mem, dst);
		if (catch have)
		{
			io::printfn("%s is stale; rerun bazel run //tools/gen_identifier_tables", DST_REL);
			return 1;
		}
		if ((String)have != content)
		{
			io::printfn("%s is stale; rerun bazel run //tools/gen_identifier_tables", DST_REL);
			return 1;
		}
		return 0;
	}
	if (catch err = file::save(dst, content))
	{
		io::eprintfn("unable to write %s: %s", dst, err);
		return 1;
	}
	return 0;
}
