"""Generate the C3 equivalent of build.zig's system_defaults module."""

def _c3_string(value):
    return "\"%s\"" % value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")

def _system_defaults_impl(ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".c3")
    content = """// Generated by //tools:system_defaults from the build defaults in build.zig.
module aro::system_defaults;
const bool ENABLE_LINKER_BUILD_ID = %s;
const String LINKER = %s;
const String SYSROOT = %s;
const String GCC_INSTALL_PREFIX = %s;
const String RTLIB = %s;
const String UNWINDLIB = %s;
""" % (
        "true" if ctx.attr.enable_linker_build_id else "false",
        _c3_string(ctx.attr.linker),
        _c3_string(ctx.attr.sysroot),
        _c3_string(ctx.attr.gcc_install_prefix),
        _c3_string(ctx.attr.rtlib),
        _c3_string(ctx.attr.unwindlib if ctx.attr.unwindlib != "" else ("libgcc" if ctx.attr.rtlib == "libgcc" else "")),
    )
    ctx.actions.write(out, content)
    return [DefaultInfo(files = depset([out]))]

system_defaults = rule(
    implementation = _system_defaults_impl,
    attrs = {
        "enable_linker_build_id": attr.bool(default = False),
        "linker": attr.string(default = "ld"),
        "sysroot": attr.string(default = ""),
        "gcc_install_prefix": attr.string(default = ""),
        "rtlib": attr.string(default = ""),
        "unwindlib": attr.string(default = ""),
    },
)
