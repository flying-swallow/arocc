// Owner: 12.2 table-gen.
// Emits the generated C3 table module for one parsed .def file. Port of the
// output half of build/generate_def.zig: sorting, tag numbering and the name
// table, with a sorted array + binary search instead of the DAFSA.
// Exact output layout: tools/builtins_schema.md, "Generated table layout".
//
// Invariants:
// - Output is a pure function of (entries, group, source_name): no paths,
//   timestamps, hash-map iteration order or locale. Running twice yields
//   identical bytes.
// - Entries are sorted bytewise ascending by name; the position in that order
//   is the tag index (== Zig DAFSA unique index - 1).
// - Every string is emitted verbatim between double quotes; the parser
//   guarantees it contains no '"', '\\' or control characters.
module generate_def;
import std::collections::list, std::core::dstring, aro::builtin_properties;

<*
 Renders the generated C3 module for `file`. source_name is the .def
 basename shown in the header comment (never a full path). The result is
 one allocation from `a`; release it with `alloc::free(a, result.ptr)`.
 Stage-0 placeholder: emits the module skeleton with empty tables.
*>
fn String emit_table(Allocator a, DefFile* file, String source_name)
{
	DString out;
	out.init(a);
	defer out.free();
	String group = file.group.def_name;
	out.appendf("// Autogenerated by tools/generate_def.c3 from %s, do not edit.\n", source_name);
	out.appendf("module aro::builtin_defs::%s;\n", group);
	out.append_string("import aro::builtin_properties;\n\n");
	out.appendf("const BuiltinGroup GROUP = %s;\n", file.group);
	out.append_string("const ushort COUNT = 0;\n");
	out.append_string("const usz SHORTEST_NAME = 0;\n");
	out.append_string("const usz LONGEST_NAME = 0;\n\n");
	out.append_string("const String[] NAMES = {\n};\n\n");
	out.append_string("const BuiltinRecord[] RECORDS = {\n};\n");
	return out.copy_str(a);
}
