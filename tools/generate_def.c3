// Owner: 12.2 table-gen.
// Emits the generated C3 table module for one parsed .def file. Port of the
// output half of build/generate_def.zig: sorting, tag numbering and the name
// table, with a sorted array + binary search instead of the DAFSA.
// Exact output layout: tools/builtins_schema.md, "Generated table layout".
//
// Invariants:
// - Output is a pure function of (entries, group, source_name): no paths,
//   timestamps, hash-map iteration order or locale. Running twice yields
//   identical bytes.
// - Entries are sorted bytewise ascending by name; the position in that order
//   is the tag index (== Zig DAFSA unique index - 1).
// - Every string is emitted verbatim between double quotes; the parser
//   guarantees it contains no '"', '\\' or control characters.
// - A name whose ASCII-uppercased form equals another name's in the same file
//   gets no TAG_ constant (both names of the pair are skipped).
// - The blank line before the TAG_ block is emitted only when at least one
//   TAG_ constant follows, so an empty table ends with "RECORDS = {\n};\n".
module generate_def;
import std::collections::list, std::core::dstring, std::sort, aro::builtin_properties;

<* Bytewise comparison (Zig std.mem.order(u8)): shorter prefix sorts first. *>
fn int compare_bytes(String a, String b)
{
	sz n = a.len < b.len ? a.len : b.len;
	for (sz i = 0; i < n; i++)
	{
		if (a[i] != b[i]) return a[i] < b[i] ? -1 : 1;
	}
	if (a.len == b.len) return 0;
	return a.len < b.len ? -1 : 1;
}

fn char ascii_upper(char c) => c >= 'a' && c <= 'z' ? c - 32 : c;

<* Bytewise comparison of the ASCII-uppercased forms. *>
fn int compare_upper(String a, String b)
{
	sz n = a.len < b.len ? a.len : b.len;
	for (sz i = 0; i < n; i++)
	{
		char x = ascii_upper(a[i]);
		char y = ascii_upper(b[i]);
		if (x != y) return x < y ? -1 : 1;
	}
	if (a.len == b.len) return 0;
	return a.len < b.len ? -1 : 1;
}

fn int cmp_entry_name(DefEntry* a, DefEntry* b) => compare_bytes(a.name, b.name);

<* Index into the name-sorted entries, ordered by uppercased name for collision detection. *>
struct UpperKey
{
	String name;
	sz index;
}

fn int cmp_upper_key(UpperKey* a, UpperKey* b)
{
	int c = compare_upper(a.name, b.name);
	if (c != 0) return c;
	return a.index < b.index ? -1 : (a.index > b.index ? 1 : 0);
}

<*
 Marks every entry of `sorted` whose uppercased name equals another entry's.
 Returns an array of sorted.len flags allocated from `a`
 (free with alloc::free(a, result.ptr)); empty when sorted is empty.
*>
fn bool[] tag_collisions(Allocator a, DefEntry[] sorted)
{
	if (sorted.len == 0) return {};
	bool[] collides = alloc::new_array(a, bool, sorted.len);
	UpperKey[] keys = alloc::alloc_array(a, UpperKey, sorted.len);
	defer alloc::free(a, keys.ptr);
	foreach (i, &e : sorted) keys[i] = { .name = e.name, .index = i };
	sort::quicksort(keys, &cmp_upper_key);
	for (sz i = 1; i < keys.len; i++)
	{
		if (compare_upper(keys[i - 1].name, keys[i].name) == 0)
		{
			collides[keys[i - 1].index] = true;
			collides[keys[i].index] = true;
		}
	}
	return collides;
}

<*
 Renders the generated C3 module for `file`. source_name is the .def
 basename shown in the header comment (never a full path). The result is
 one allocation from `a`; release it with `alloc::free(a, result.ptr)`.
 Layout: tools/builtins_schema.md, "Generated table layout".
 @require file.entries.len() <= 0xFFFF : "the parser rejects more than 65535 builtins"
*>
fn String emit_table(Allocator a, DefFile* file, String source_name)
{
	sz n = file.entries.len();
	DefEntry[] sorted;
	if (n > 0)
	{
		sorted = alloc::alloc_array(a, DefEntry, n);
		foreach (i, e : file.entries) sorted[i] = e;
		sort::quicksort(sorted, &cmp_entry_name);
	}
	defer if (n > 0) alloc::free(a, sorted.ptr);
	bool[] collides = tag_collisions(a, sorted);
	defer if (n > 0) alloc::free(a, collides.ptr);

	sz shortest = 0;
	sz longest = 0;
	foreach (i, &e : sorted)
	{
		if (i == 0 || e.name.len < shortest) shortest = e.name.len;
		if (e.name.len > longest) longest = e.name.len;
	}

	DString out;
	out.init(a);
	defer out.free();
	BuiltinGroup group = file.group;
	out.appendf("// Autogenerated by tools/generate_def.c3 from %s, do not edit.\n", source_name);
	out.appendf("module aro::builtin_defs::%s;\n", group.def_name);
	out.append_string("import aro::builtin_properties;\n\n");
	out.appendf("const BuiltinGroup GROUP = %s;\n", group);
	out.appendf("const ushort COUNT = %d;\n", n);
	out.appendf("const usz SHORTEST_NAME = %d;\n", shortest);
	out.appendf("const usz LONGEST_NAME = %d;\n\n", longest);

	out.append_string("const String[] NAMES = {\n");
	foreach (&e : sorted) out.appendf("\t\"%s\",\n", e.name);
	out.append_string("};\n\n");

	out.append_string("const BuiltinRecord[] RECORDS = {\n");
	foreach (&e : sorted)
	{
		BuiltinRecord r = e.record;
		out.appendf("\t{ \"%s\", %s, %s, (Attributes)0x%05x, \"%s\" },\n",
			r.param_str, r.language, r.header, (uint)r.attributes, r.features);
	}
	out.append_string("};\n");

	bool first_tag = true;
	foreach (i, &e : sorted)
	{
		if (collides[i]) continue;
		if (first_tag) out.append_char('\n');
		first_tag = false;
		out.append_string("const BuiltinTag TAG_");
		foreach (c : e.name) out.append_char(ascii_upper(c));
		out.appendf(" = { .group = %s, .index = %d };\n", group, i);
	}
	return out.copy_str(a);
}
