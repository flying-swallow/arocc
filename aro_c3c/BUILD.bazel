        "src/vmem.c3",
    ],
    deps = ["//aro/compiler:common", "//ir.c3l:ir"],
    visibility = ["//visibility:public"],
)

filegroup(name = "sources", srcs = glob(["src/**/*.c3"]), visibility = ["//visibility:public"])

c3_binary(
    name = "aro_c3c",
    srcs = ["main.c3"],
    deps = [":lib", "//aro/compiler:tooling"],
    visibility = ["//visibility:public"],
)

exports_files(["main.c3"])

# One Bazel test per upstream area keeps failures attributable and allows
# Bazel to schedule the 1,788 imported cases across workers.
AREAS = [
    "abi",
    "analysis",
    "any",
    "arrays",
    "asm",
    "assert",
    "assignment",
    "attributes",
    "bitstruct",
    "builtins",
    "cast",
    "clang",
    "comments",
    "compile_time",
    "compile_time_introspection",
    "compiler_rt",
    "concurrency",
    "constants",
    "contracts",
    "debug_symbols",
    "defer",
    "define",
    "distinct",
    "dynamic",
    "embed",
    "enumerations",
    "errors",
    "examples",
    "expressions",
    "floats",
    "from_docs",
    "functions",
    "generic",
    "globals",
    "import",
    "initialize",
    "initializer_lists",
    "interfaces",
    "lambda",
    "lexing",
    "literals",
    "macro_methods",
    "macros",
    "methods",
    "module",
    "overloading",
    "pointers",
    "precedence",
    "regression",
    "safe",
    "slices",
    "statements",
    "stdlib",
    "strings",
    "struct",
    "switch",
    "symbols",
    "types",
    "unicode",
    "union",
    "variables",
    "vector",
    "visibility",
    "weak",
]

[
    sh_test(
        name = "area_" + area,
        srcs = ["run_area.sh"],
        args = ["$(location :aro_c3c)", "$(location @c3c//:c3c)", area],
        data = [
            "runner.py",
            ":aro_c3c",
            "@c3c//:c3c",
            "@c3c//:stdlib",
        ] + glob(["test_suite/%s/**/*.c3" % area, "test_suite/%s/**/*.c3t" % area], allow_empty = True),
        size = "large",
        timeout = "long",
    )
    for area in AREAS
]

test_suite(name = "all", tests = [":runner_tests"] + [":area_" + area for area in AREAS])

sh_test(
    name = "runner_tests",
    srcs = ["run_runner_tests.sh"],
    data = ["runner.py", "runner_test.py"],
)
