load("//aro_cc/tools:c3.bzl", "c3_binary", "c3_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

c3_library(
    name = "lib",
    srcs = [
        "src/asm_target.c3",
        "src/ast.c3",
        "src/ast_enums.c3",
        "src/ast_helpers.c3",
        "src/bigint.c3",
        "src/build_enums.c3",
        "src/c3.c3",
        "src/c_abi.c3",
        "src/c_abi_aarch64.c3",
        "src/c_abi_riscv.c3",
        "src/c_abi_wasm.c3",
        "src/c_abi_win64.c3",
        "src/c_abi_x64.c3",
        "src/c_abi_x86.c3",
        "src/codegen_internal.c3",
        "src/compiler.c3",
        "src/compiler_inline.c3",
        "src/compiler_rest.c3",
        "src/context.c3",
        "src/copying.c3",
        "src/diagnostics.c3",
        "src/diagnostics_inline.c3",
        "src/expr.c3",
        "src/float.c3",
        "src/lexer.c3",
        "src/methodtable.c3",
        "src/number.c3",
        "src/parse_expr.c3",
        "src/parse_expr_support.c3",
        "src/parse_global.c3",
        "src/parse_stmt.c3",
        "src/parser.c3",
        "src/sema_asm.c3",
        "src/sema_builtins.c3",
        "src/sema_casts.c3",
        "src/sema_const.c3",
        "src/sema_decls.c3",
        "src/sema_errors.c3",
        "src/sema_expr.c3",
        "src/sema_expr2.c3",
        "src/sema_generics.c3",
        "src/sema_initializers.c3",
        "src/sema_internal.c3",
        "src/sema_liveness.c3",
        "src/sema_name_resolution.c3",
        "src/sema_passes.c3",
        "src/sema_static_analysis.c3",
        "src/sema_stmts.c3",
        "src/sema_structs.c3",
        "src/sema_types.c3",
        "src/semantic_analyser.c3",
        "src/stringutils.c3",
        "src/symtab.c3",
