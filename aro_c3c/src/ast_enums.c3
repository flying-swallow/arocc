	OR,
	ELSE,
	CT_AND,
	CT_OR,
	CT_CONCAT,
	CT_CONCAT_ASSIGN,
	// Don't change the ordering for GT to EQ or things will break
	GT,
	GE,
	LT,
	LE,
	NE,
	EQ,
	// Vec comparisons
	VEC_GT,
	VEC_GE,
	VEC_LT,
	VEC_LE,
	VEC_NE,
	VEC_EQ,
	// Only "assign" BINOPS after this point
	ASSIGN,
