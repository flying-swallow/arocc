	VUNPCKLPS { "vunpcklps" },
	VXORPD { "vxorpd" },
	VXORPS { "vxorps" },
}

<* Operand sites in operand order: R = ModRM.reg, V = EVEX.vvvv, M = ModRM.rm, I = imm8. *>
enum EvexOpEn : char
{
	MR, MRI, MVR, RM, RMI, RVM, RVMI, VMI,
}

<* EVEX operand classes. `x_mN`: register or N-bit memory; `mNbcst`: broadcast-only memory;
   `vsib_x`: VSIB memory indexed by that vector register class. *>
enum EvexOp : char
{
	NONE, IMM8, K, M128, M256, M32, M512, M64, R32, R32_M16, R32_M8, R64, RM32, RM64, VSIB_XMM, VSIB_YMM, VSIB_ZMM, XMM, XMM_M128, XMM_M16, XMM_M32, XMM_M64, XMM_M8, YMM, YMM_M256, ZMM, ZMM_M512,
}

